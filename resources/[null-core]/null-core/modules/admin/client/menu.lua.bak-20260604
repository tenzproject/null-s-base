                            ExecuteCommand(("addPoints %s %s"):format(id, nbrCoins))
                        end
                    end
                })
            
                RageUI.Button("Give Coins Id Boutique", "Vous permet de give des coins avec l'Id Boutique", {RightBadge = RageUI.BadgeStyle.Star}, true, {
                    onSelected = function()
                        local id = null.fct.input("ID Boutique")
                        local nbrCoins = null.fct.input("Nombre de coins")
            
                        if id ~= nil and id ~= "" and nbrCoins ~= nil and nbrCoins ~= "" then
                            ExecuteCommand(("addPointsIdBoutique %s %s"):format(id, nbrCoins))
                        end
                    end
                })
            
                RageUI.Button("Give Coins Id Unique", "Vous permet de give des coins avec l'ID Unique du joueur", {RightBadge = RageUI.BadgeStyle.Star}, true, {
                    onSelected = function()
                        local idUnique = null.fct.input("ID Unique")
                        local nbrCoins = null.fct.input("Nombre de coins")
            
                        if idUnique ~= nil and idUnique ~= "" and nbrCoins ~= nil and nbrCoins ~= "" then
                            ExecuteCommand(("addPointsIdUnique %s %s"):format(idUnique, nbrCoins))
                        end
