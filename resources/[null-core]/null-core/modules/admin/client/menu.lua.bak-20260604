                }, sub_Server_Companies_Selected_Restaurant_OrderPoints)
                RageUI.Button("Refresh le point de Stockage", "Si il est déjà initialisé ça ne changera rien.", {}, true, {
                    onSelected = function()
                        TriggerServerEvent("null:addRestaurantFarm", nTable.SelectedEntreprise.name)
                    end
                })
            elseif nTable.SelectedEntreprise.type == "Ambulance" then
                local listeee = {"au coffre","au vestiaire"}
                for i=1, #listeee, 1 do
                    RageUI.Button('Se téléporter '..listeee[i], nil, {}, true, {
