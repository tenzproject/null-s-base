        RageUI.IsVisible(sub_DevTools_JsonConfigs_Config_View, function()
            while Selected == nil do
                Wait(1)
            end
            RageUI.Button("Selected: Config."..Selected, nil, {}, true, {})
            if type(Config[Selected]) == "table" then
                RageUI.Button("Rechercher", nil, {}, true, {
                    onSelected = function()
                        local input = null.fct.input("Que voulez faire rechercher ?")
                        if not input then return end
                        TempSearchConfigSubMenu = string.lower(input)
                    end
                })
                RageUI.Button("Arreter la Rechercher", nil, {}, true, {
                    onSelected = function()
                        TempSearchConfigSubMenu = nil
                    end
                })
                RageUI.Line()
                for k,v in pairs(Config[Selected]) do
                    local rightlabelllll = tostring(v)
                    local description = tostring(v)
                    if TempSearchConfigSubMenu ~= nil then
                        if string.find(string.lower(tostring(k)), TempSearchConfigSubMenu) or string.find(string.lower(tostring(v)), TempSearchConfigSubMenu) then
                            if type(v) == "table" then
                                rightlabelllll = tostring(json.encode(v))
                                description = tostring(json.encode(v))
                                if #rightlabelllll > 40 then
                                    rightlabelllll = "Regarder la description"
                                end
                            end
                            RageUI.Button(tostring(k), description, {RightLabel = rightlabelllll}, true , {})
                        end
                    else
                        if type(v) == "table" then
                            rightlabelllll = tostring(json.encode(v))
                            description = tostring(json.encode(v))
                            if #rightlabelllll > 40 then
                                rightlabelllll = "Regarder la description"
                            end
                        end
                        RageUI.Button(tostring(k), description, {RightLabel = rightlabelllll}, true , {})
                    end
                end
            else
                RageUI.Button(tostring(Config[Selected]), false , {RightLabel = nil}, true , {})
            end
        end)
        RageUI.IsVisible(sub_DevTools_Coords, function()
            if GetOffSetType == nil then GetOffSetType = "GetOffsetFromCoordAndHeadingInWorldCoords" end
            if GetOffSetTypeIndex == nil then GetOffSetTypeIndex = 1 end
            RageUI.List("Coordonnées", Config.CoordsList, Config.CoordsList.Index , nil, {}, true, {
                onListChange = function(Index)
                    Config.CoordsList.Index = Index
                end,
                onSelected = function(Index)
                    if Index == 1 then
                        null.fct.copy(""..GetEntityCoords(PlayerPedId()))
                    elseif Index == 2 then
                        local coords = GetEntityCoords(PlayerPedId())
                        local heading = GetEntityHeading(PlayerPedId())
                        null.fct.copy("vector4("..coords.x..", "..coords.y..", "..coords.z..", "..heading..")")
                    elseif Index == 3 then 
                        null.fct.copy(GetEntityCoords(PlayerPedId()).x..", "..GetEntityCoords(PlayerPedId()).y..", "..GetEntityCoords(PlayerPedId()).z)
                    elseif Index == 4 then
                        null.fct.copy("{x = "..GetEntityCoords(PlayerPedId()).x..", y = "..GetEntityCoords(PlayerPedId()).y..", z = "..GetEntityCoords(PlayerPedId()).z.."}")
                    elseif Index == 5 then
                        lib.showTextUI(
                            '[E]     - Selectionner le point de départ  \n' ..
                            '[Y]     - Rapprocher le point de vous  \n' ..
                            '[U]     - Eloigner le point de vous  \n'
                        )
                        null.DisplayHud(false)
                        local dist = 5.0
                        while true do
                            DisableControlAction(0, 38, true)
                            local start,fin = null.fct.game.GetCoordsInFrontOfCam(dist, 5000)
                            if IsControlPressed(0, 246) then
                                dist -= 0.05
                            end
                            if IsControlPressed(0, 303) then
                                dist += 0.05
                            end
                            DrawSphere(start, 0.06, 0, 255, 0, 0.5)
                            if IsDisabledControlJustReleased(0, 38) then
                                lib.hideTextUI()
                                null.fct.copy(""..start)
                                break
                            end
                            Wait(0)
                        end
                    end
                end
            })
            RageUI.Button("Heading", nil, {}, true, {
                onSelected = function()
                    null.fct.copy(GetEntityHeading(PlayerPedId()))
                end
            })
            RageUI.Line()   
            local offsetype = {"GetOffsetFromCoordAndHeadingInWorldCoords"}
            RageUI.List("", {"GetOffsetFromCoordAndHeadingInWorldCoords"}, GetOffSetTypeIndex , nil, {}, true, {
                onListChange = function(Index)
                    GetOffSetTypeIndex = Index
                    GetOffSetType = offsetype[index]
                end
            })
            if GetOffSetType == "GetOffsetFromCoordAndHeadingInWorldCoords" then
                if TestFromCoords == nil then TestFromCoords = {} end 
                if TestFromCoords.offset == nil then TestFromCoords.offset = {x = 0.0, y = 0.0, z = 0.0} end 
                RageUI.Button("OffSet X", "- = Gauche\n+ = Droite", {}, true, {
                    onSelected = function()
                        TestFromCoords.offset.x = null.fct.input("OffSet X : (exemple: 1.0)")
                    end
                })
                RageUI.Button("OffSet Y", "- = Arriere\n+ = Avant", {}, true, {
                    onSelected = function()
                        TestFromCoords.offset.y = null.fct.input("OffSet Y : (exemple: 1.0)")
                    end
                })
                RageUI.Button("OffSet Z", "- = Bas\n+ = Haut", {}, true, {
                    onSelected = function()
                        TestFromCoords.offset.z = null.fct.input("OffSet Z : (exemple: 1.0)")
                    end
                })
                RageUI.Button("Coords", "nil = vos coords", {}, true, {
                    onSelected = function()
                        TestFromCoords.coords = {}
                        TestFromCoords.coords.x = null.fct.input("X")
                        TestFromCoords.coords.y = null.fct.input("X")
                        TestFromCoords.coords.z = null.fct.input("X")
                        if TestFromCoords.coords.x == nil or TestFromCoords.coords.y == nil or TestFromCoords.coords.z == nil then
                            TestFromCoords.coords = nil
                        end
                    end
                })
                RageUI.Button("Heading", "nil = votre heading", {}, true, {
                    onSelected = function()
                        TestFromCoords.heading = null.fct.input("Votre Heading : ")
                    end
                })
                RageUI.Button("~g~Tester", nil, {}, true, {
                    onSelected = function()
                        local plyCoords = GetEntityCoords(PlayerPedId()) 
                        local coords = TestFromCoords.coords
                        local heading = TestFromCoords.heading
                        if TestFromCoords.coords == nil then
                            coords = {x = plyCoords.x, y = plyCoords.y, z = plyCoords.z-0.98}
                        end
                        if TestFromCoords.heading == nil then
                            heading = GetEntityHeading(PlayerPedId())
                        end
                        if heading then
                            SetEntityHeading(PlayerPedId(), heading)
                        end
                        local newcoords = GetOffsetFromCoordAndHeadingInWorldCoords(coords.x, coords.y, coords.z, heading, TestFromCoords.offset.x, TestFromCoords.offset.y, TestFromCoords.offset.z) 
                        SetEntityCoords(PlayerPedId(), newcoords)
                    end
                })
                RageUI.Button("Copier Function", nil, {}, true, {
                    onSelected = function()
                        local plyCoords = GetEntityCoords(PlayerPedId()) 
                        local coords = TestFromCoords.coords
                        local heading = TestFromCoords.heading
                        if TestFromCoords.coords == nil then
                            coords = {x = plyCoords.x, y = plyCoords.y, z = plyCoords.z-0.98}
                        end
                        if TestFromCoords.heading == nil then
                            heading = GetEntityHeading(PlayerPedId())
                        end
                        if heading then
                            SetEntityHeading(PlayerPedId(), heading)
                        end
                        null.fct.copy("GetOffsetFromCoordAndHeadingInWorldCoords("..coords.x..", "..coords.y..", "..coords.z..", "..heading..", "..TestFromCoords.offset.x..", "..TestFromCoords.offset.y..", "..TestFromCoords.offset.z..")")
                    end
                })
                RageUI.Button("Copier Result", nil, {}, true, {
                    onSelected = function()
                        local plyCoords = GetEntityCoords(PlayerPedId()) 
                        local coords = TestFromCoords.coords
                        local heading = TestFromCoords.heading
                        if TestFromCoords.coords == nil then
                            coords = {x = plyCoords.x, y = plyCoords.y, z = plyCoords.z-0.98}
                        end
                        if TestFromCoords.heading == nil then
                            heading = GetEntityHeading(PlayerPedId())
                        end
                        if heading then
                            SetEntityHeading(PlayerPedId(), heading)
                        end
                        local news = GetOffsetFromCoordAndHeadingInWorldCoords(coords.x, coords.y, coords.z, heading, TestFromCoords.offset.x, TestFromCoords.offset.y, TestFromCoords.offset.z)
                        null.fct.copy("vector3("..news.x..", "..news.y..", "..news.z..")")
                    end
                })
            end
            RageUI.Line()
        end)
