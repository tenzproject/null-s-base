local joueurenvie = ""
RegisterNetEvent("AdminMenu:playerAsBeenSearchIdUnique")
AddEventHandler("AdminMenu:playerAsBeenSearchIdUnique", function(identifier, job, job2, group, isdead, loadout, account_info, accounts, v0ltre)
    if identifier ~= nil then
        
        nTable.selectIdUnique = v0ltre.idunique

        nTable.playerAsBeenSearchIdUnique = identifier
        nTable.searchiduGroup = group
        if nTable.searchiduGroup == "fondateur" then
            nTable.fonda = true
        else
            nTable.fonda = false
        end
        nTable.name = account_info.name or 'Inconnu'
        nTable.searchiduJob = job or "Unemployed"
        nTable.searchidujob2 = job2 or "Unemployed"
        nTable.estmort = isdead
        nTable.loadoutIDU = loadout
        nTable.hasFoundPlayerByUID = true
        local foundcash = false
        local foundbank = false
        local foundblack = false
        for k,v in pairs(accounts) do
            if v.name == "cash" then
                nTable.cash = v.money
            elseif v.name == "dirtycash" then
                nTable.black = v.money
            elseif v.name == "bank" then
                nTable.bank = v.money
            end 
        end
        if not foundblack then
            nTable.dirtycash = "Inconnu"
        end
        if not foundcash then
            nTable.cash = "Inconnu"
        end
        if not foundbank then
            nTable.bank = "Inconnu"
        end
        if isdead then
            joueurenvie = ESX.Config("serverColor").."Oui"
        else
            joueurenvie = ESX.Config("serverColor").."Non"
        end
    else
        ESX.ShowNotification("Cette ID Unique n'existe pas")
    end
end)

RegisterNetEvent("null:staff:recevieSearchIdUniqueInfo")
AddEventHandler("null:staff:recevieSearchIdUniqueInfo", function(idunique, uiddata)
    if idunique and uiddata and nTable.selectIdUnique == idunique then
        nTable.selectIdUnique = uiddata.idunique
        nTable.playerAsBeenSearchIdUnique = uiddata.identifier
        if uiddata.group == "fondateur" then
            uiddata.fonda = true
        else
            uiddata.fonda = false
        end
        if uiddata.isdead then
            uiddata.joueurEnVie = "Non"
        else
            uiddata.joueurEnVie = "Oui"
        end
        null.DebugPrint("foundPlayerByUID", uiddata)
        if uiddata.job == nil then uiddata.job = "unemployed" end
        if uiddata.job == nil then uiddata.job2 = "unemployed2" end
        if type(uiddata.job) == "table" then
            uiddata.job = uiddata.job.name
        end
        if type(uiddata.job2) == "table" then
            uiddata.job2 = uiddata.job2.name
        end
        nTable.playerByIdU = uiddata
        nTable.hasFoundPlayerByUID = true
    else
        ESX.ShowNotification("Cette ID Unique n'existe pas")
    end
end)

