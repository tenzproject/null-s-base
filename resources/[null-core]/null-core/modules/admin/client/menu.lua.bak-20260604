                })
            
                RageUI.Button("Remove Coins", "Vous permet d'enlever des coins", {}, true, {
                    onSelected = function()
                        local id = null.fct.input("ID")
                        local nbrCoins = null.fct.input("Nombre de coins")
            
                        if id ~= nil and id ~= "" and nbrCoins ~= nil and nbrCoins ~= "" then
                            ExecuteCommand(("addPoints %s -%s"):format(id, nbrCoins))
                        end
                    end
                })                  
        
                RageUI.Button("Give Véhicule", "Vous permet de give un véhicule boutique", {}, true, {
                    onSelected = function()
                        local id = null.fct.input("ID")
                        local vehicle = null.fct.input("Nom du véhicule")
                        local type = null.fct.input("Type du véhicule (car, aircraft, boat)")
             
                        if id ~= nil and id ~= "" and vehicle ~= nil and vehicle ~= "" and type ~= nil and type ~= "" then
                            ExecuteCommand(("givevehicule %s %s %s"):format(id, vehicle, type))
                        end
                    end
                })     
                RageUI.Button("Giveaway Points", "Donner des coins à toutes les personnes connectées", {}, true, {
                    onSelected = function()
                        local points = null.fct.input("Nombre de coins")
                        if points ~= nil and tonumber(points) and tonumber(points) > 0 then
                            local confirm = null.fct.confirm("Êtes-vous sûr de vouloir donner " .. points .. " coins à tout le monde ?")
                            if confirm then
                                ExecuteCommand(("addPointsAll %s"):format(points))
                            end
                        end
                    end
                })
                
                RageUI.Button("Giveaway VIP", "Donner des VIPs à toutes les personnes connectées", {}, true, {
                    onSelected = function()
                        local days = null.fct.input("Nombre de jours")
                        if days ~= nil and tonumber(days) and tonumber(days) > 0 then
                            local confirm = null.fct.confirm("Êtes-vous sûr de vouloir donner " .. days .. " jours de VIP à tout le monde ?")
