local handleTerritoryPreviewCrackActive = false
local handleTerritoryPreviewPed = nil

local function handleTerritoryPreviewCrack()
    handleTerritoryPreviewCrackActive = true

    Citizen.CreateThread(function()
        local animDict = "anim@heists@ornate_bank@hack"
        ESX.Streaming.RequestAnimDict(animDict)

        local previewInstructions = SetupInstructionalButtons({
            { key = 172, label = "Avant" },
            { key = 173, label = "Arrière" },
            { key = 174, label = "Gauche" },
            { key = 175, label = "Droite" },
            { key = 314, label = "Monter" },
            { key = 315, label = "Descendre" },
            { key = 14,  label = "Rotation" }
        })

        handleTerritoryPreviewPed = ClonePed(PlayerPedId(), false, false, false)
        while not DoesEntityExist(handleTerritoryPreviewPed) do Citizen.Wait(0) end

        local playerCoords, forward = GetEntityCoords(PlayerPedId()), GetEntityForwardVector(PlayerPedId())
        local pedCoords = (playerCoords + forward * 3.0)

        SetEntityCoords(handleTerritoryPreviewPed, vector3(pedCoords.x, pedCoords.y, pedCoords.z), false, false, false,
            false)
        FreezeEntityPosition(handleTerritoryPreviewPed, true)

        local relativeCoords = GetOffsetFromEntityGivenWorldCoords(PlayerPedId(), pedCoords.x, pedCoords.y, pedCoords.z)
        relativeCoords = vector3(relativeCoords.x, relativeCoords.y, relativeCoords.z)

        local rot = GetEntityRotation(handleTerritoryPreviewPed, 2)
        rot = vector3(rot.x, rot.y, rot.z)

        local scene = nil

        local function setupScene()
            if scene ~= nil then
                ClearPedTasksImmediately(handleTerritoryPreviewPed)
                scene = nil
            end

            local coords = GetEntityCoords(handleTerritoryPreviewPed)

            scene = CreateSynchronizedScene(coords.x, coords.y, coords.z, rot.x, rot.y, rot.z, 2)
            SetSynchronizedSceneLooped(scene, true)
            TaskSynchronizedScene(handleTerritoryPreviewPed, scene, animDict, "hack_loop", 1000.0, -8.0, 4, 0, 0, 0)
        end

        setupScene()

        while handleTerritoryPreviewCrackActive do
            HideHudComponentThisFrame(19)
            HideHudComponentThisFrame(20)

            DrawScaleformMovieFullscreen(previewInstructions, 255, 255, 255, 255, 0)

            playerCoords, forward = GetEntityCoords(PlayerPedId()), GetEntityForwardVector(PlayerPedId())
            pedCoords = GetOffsetFromEntityInWorldCoords(PlayerPedId(), relativeCoords.x, relativeCoords.y,
                relativeCoords.z)

            SetEntityCoords(handleTerritoryPreviewPed, vector3(pedCoords.x, pedCoords.y, pedCoords.z), false, false,
                false, false)

            if IsControlPressed(0, 314) then
                relativeCoords = vector3(relativeCoords.x, relativeCoords.y, relativeCoords.z + 0.01)
            end

            if IsControlPressed(0, 315) then
                relativeCoords = vector3(relativeCoords.x, relativeCoords.y, relativeCoords.z - 0.01)
            end

            if IsControlPressed(0, 172) then
                pedCoords = pedCoords + 0.001 * forward
                relativeCoords = GetOffsetFromEntityGivenWorldCoords(PlayerPedId(), pedCoords.x, pedCoords.y, pedCoords
                    .z)
            end

            if IsControlPressed(0, 173) then
                pedCoords = pedCoords - 0.001 * forward
                relativeCoords = GetOffsetFromEntityGivenWorldCoords(PlayerPedId(), pedCoords.x, pedCoords.y, pedCoords
                    .z)
            end

            if IsControlPressed(0, 174) then
                pedCoords = pedCoords + 0.001 * vector3(-1.0 * forward.y, 1.0 * forward.x, 0.0)
                relativeCoords = GetOffsetFromEntityGivenWorldCoords(PlayerPedId(), pedCoords.x, pedCoords.y, pedCoords
                    .z)
            end

            if IsControlPressed(0, 175) then
                pedCoords = pedCoords + 0.001 * vector3(1.0 * forward.y, -1.0 * forward.x, 0.0)
                relativeCoords = GetOffsetFromEntityGivenWorldCoords(PlayerPedId(), pedCoords.x, pedCoords.y, pedCoords
                    .z)
            end

            if IsControlPressed(0, 14) then
                rot = vector3(rot.x, rot.y, rot.z + 3.0)
            end

            if IsControlPressed(0, 15) then
                rot = vector3(rot.x, rot.y, rot.z - 3.0)
            end

            setupScene()

            Citizen.Wait(0)
        end

        if DoesEntityExist(handleTerritoryPreviewPed) then
            DeletePed(handleTerritoryPreviewPed)
            handleTerritoryPreviewPed = nil
        end
    end)
end


local function getDefaultTerritoryData()
    return {
        name = nil,
        pos = nil,
        maxSells = nil,
        pnj = nil,
        points = {},
        minCops = nil,
        maxSellsCops = nil
    }
end


local function getDefaultTerritoryDrugData()
    return {
        name = nil,
        price = nil
    }
end

local function isTerritoryValid(data)
    if data.name == nil then
        return false
    end

    if data.pos == nil then
        return false
    end

    if data.minCops == nil then
        return false
    end

    if data.maxSellsCops == nil then
        return false
    end


    if data.pnj.pos == nil then
        return false
    end

    if data.points == nil then
        return false
    end

    if #data.points < 3 then
        return false
    end

    return true
end

local ShoWpedsAdmin = false
local clonedPed = nil

createPlayerPed = function(playerPed, zoom)
    if not ShoWpedsAdmin then
        local playerModel = GetEntityModel(playerPed)
        clonedPed = CreatePed(26, playerModel, 0.0, 0.0, 0.0, 0.0, false, false)
        ClonePedToTarget(playerPed, clonedPed)
        
        SetEntityCollision(clonedPed, false, false)
        SetEntityInvincible(clonedPed, true)
        SetEntityLocallyVisible(clonedPed)
        NetworkSetEntityInvisibleToNetwork(clonedPed, true)
        SetEntityCanBeDamaged(clonedPed, false)
        SetBlockingOfNonTemporaryEvents(clonedPed, true)
        SetEntityAlpha(clonedPed, 254)

        ESX.Streaming.RequestAnimDict("amb@world_human_hang_out_street@female_arms_crossed@idle_a", function()
            TaskPlayAnim(clonedPed, "amb@world_human_hang_out_street@female_arms_crossed@idle_a", "idle_a", 8.0, -8.0, -1, 49, 0, false, false, false)
        end)

        ShoWpedsAdmin = false

        local positionBuffer = {}
        local bufferSize = 5

        CreateThread(function()
            while ShoWpedsAdmin do
                local world, normal = GetWorldCoordFromScreenCoord(0.35, 0.49)
                local depth = 5
                local target = world + normal * depth
                local camRot = GetGameplayCamRot(2)

                table.insert(positionBuffer, target)
                if #positionBuffer > bufferSize then
                    table.remove(positionBuffer, 1)
                end

                local averagedTarget = vector3(0, 0, 0)
                for _, position in ipairs(positionBuffer) do
                    averagedTarget = averagedTarget + position
                end
                averagedTarget = averagedTarget / #positionBuffer

                SetEntityCoords(clonedPed, averagedTarget.x, averagedTarget.y, averagedTarget.z, false, false, false, true)
                SetEntityHeading(clonedPed, camRot.z + 170.0)
                SetEntityRotation(clonedPed, camRot.x * (-1), 0, camRot.z + 170.0, false, false)

                if not IsEntityPlayingAnim(clonedPed, "amb@world_human_hang_out_street@female_arms_crossed@idle_a", "idle_a", 3) then
                    ESX.Streaming.RequestAnimDict("amb@world_human_hang_out_street@female_arms_crossed@idle_a", function()
                        TaskPlayAnim(clonedPed, "amb@world_human_hang_out_street@female_arms_crossed@idle_a", "idle_a", 8.0, -8.0, -1, 49, 0, false, false, false)
                    end)
                end

                Wait(4)
            end
        end)
    end
end

ClosePedMenuAdmin = function()
    if clonedPed then
        ShoWpedsAdmin = false
        ClearPedTaskPreviewAdmin()
        DeleteEntity(clonedPed)
        clonedPed = nil
    end
end

ClearPedTaskPreviewAdmin = function()
    if clonedPed then
        ClearPedTasksImmediately(clonedPed)
    end
end

