                RageUI.Button('ID Unique du joueur', nil, {RightLabel = uniqueVehData.idunique and "Défini" or "Pas défini"}, true, {
                    onSelected = function()
                        uniqueVehData.idunique = null.fct.input("ID Unique du joueur")
                    end
                })
            end
            local can = false
            if uniqueVehData.price ~= nil and uniqueVehData.label ~= nil and uniqueVehData.stock ~= nil and uniqueVehData.label ~= nil and uniqueVehData.model ~= nil then
                can = true
            end
            RageUI.Button('Confirmer', nil, {}, can, {
                onSelected = function()
                    if not areForIdUnique then
                        uniqueVehData.idunique = nil
                    end
                    TriggerServerEvent("null:boutique:staff:UniqueVeh", nil, uniqueVehData)
