                    onSelected = function()
                        RechercheSocietyMembreList = nil
                    end
                })
                RageUI.Line()
                return
            end
            RageUI.Button('Rechercher', nil, {}, true, {
                onSelected = function()
                    local input = null.fct.input("Nom Prenom/Pseudo/Id unique/Identifier a rechercher")
                    if not input then return end
