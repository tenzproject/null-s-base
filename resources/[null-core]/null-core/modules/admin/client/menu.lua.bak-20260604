            RageUI.Button('Prix du véhicule unique', nil, {RightLabel = uniqueVehData.price and "Défini" or "Pas défini"}, true, {
                onSelected = function()
                    uniqueVehData.price = null.fct.input("Prix du véhicule Unique ? (Coin boutique)")
                end
            })
            if areForIdUnique == nil then areForIdUnique = false end
            RageUI.Checkbox('Uniquement pour un joueur (ID Unique)', nil, areForIdUnique, {}, {
                onChecked = function()
                    areForIdUnique = true
                end,
                onUnChecked = function()
                    areForIdUnique = false
