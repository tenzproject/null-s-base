                        end
                    })
                end]]
                RageUI.Button("Envoyer un message", nil, {}, true, {
                    onSelected = function()
                        local message = null.fct.input("Message")
                        if message ~= nil then
                            ExecuteCommand(("msgstaff %s %s"):format(nTable.idunique, message))
                        else
                            ESX.ShowNotification("Veuiller décrire votre message")
                        end
                    end
                })
                RageUI.Button("Screenshot", nil, {}, (StaffHasPerm("SCREEN")), {
                    onSelected = function()
                        
                        TriggerServerEvent("null:staff:screenshotplayer", nTable.source)
                    end
                })
                RageUI.Checkbox(AdminMenu:freezeByState(nTable.playerFreeze), nil, nTable.playerFreeze, {}, {
                    onChecked = function()
                        nTable.playerFreeze = true
                        ExecuteCommand(("%s %s"):format(Config.Admin.Commands.freeze, nTable.source))
                    end,
                    onUnChecked = function()
                        nTable.playerFreeze = false
                        ExecuteCommand(("%s %s"):format(Config.Admin.Commands.unfreeze,nTable.source))
                    end
                })
                RageUI.Line()
                if (StaffHasPerm("GIVE_GARAGE_VEH")) then
                    RageUI.Button("Attribuer un véhicule", nil, {}, true, {
                        onSelected = function()
                            local targetPos = GetEntityCoords(PlayerPedId(nTable.source))
                            local veh = null.fct.input("Model du véhicule ex : sultan, cyclone")
                            if veh ~= nil then
                                local hash = GetHashKey(veh)
                                if IsModelValid(hash) then
                                    ESX.Game.SpawnVehicle(veh, {x = targetPos.x, y = targetPos.y, z = targetPos.z}, 90.0, function(vehicle)
                                        table.insert(nTable.vehicleSell, vehicle)
                                        TaskWarpPedIntoVehicle(PlayerPedId(nTable.source), vehicle, -1)
                                        SetModelAsNoLongerNeeded(veh)
                                        local plaque = AdminMenu:CreatePlate()
                                        local vehicleProps = ESX.Game.GetVehicleProperties(nTable.vehicleSell[#nTable.vehicleSell])
                                        vehicleProps.plate = plaque
                                        SetVehicleNumberPlateText(nTable.vehicleSell[#nTable.vehicleSell], plaque)
                                        TriggerServerEvent("AdminMenu:giveGarageVeh", vehicleProps, nTable.source, GetDisplayNameFromVehicleModel(veh))
                                    end)
                                else
                                    ESX.ShowNotification("Ce véhicule n'existe pas !")
                                end
                            end
                        end
                    })
                end
                RageUI.List("Give options : ", nTable.giveType, nTable.List, nil, {}, true, {
                    onListChange = function(Index)
                        nTable.List = Index;
                    end,

                    onSelected = function(Index)
                        if Index == 1 then
                            if (StaffHasPerm("GIVE_VEH")) then
                                local veh = null.fct.input("Model du véhicule")
                                if veh ~= nil then
                                    local model = GetHashKey(veh)
                                    if IsModelValid(model) then
                                        RequestModel(model)
                                        while not HasModelLoaded(model) do Wait(20) end
                                        
                                        TriggerServerEvent("AdminMenu:giveVeh", nTable.source, model, veh)
                                    else
                                        ESX.ShowNotification("Ce model n'existe pas !")
                                    end
                                else
                                    ESX.ShowNotification("Ce model n'existe pas !")
                                end
                            else
                                ESX.ShowNotification("Vous n'avez pas la permission !")
                            end
                        end

                        if Index == 2 then
                            if (StaffHasPerm("GIVE_MONEY")) then
                                local amount = null.fct.input("Montant d'argent en cash à donner")
                                if amount ~= nil then
                                    
                                    TriggerServerEvent("AdminMenu:giveMoneyCash", nTable.source, amount)
                                else
                                    ESX.ShowNotification("Montant Invalide")
                                end
                            else
                                ESX.ShowNotification("Vous n'avez pas la permission !")
                            end
                        end

                        if Index == 3 then
                            if (StaffHasPerm("GIVE_MONEY")) then
                                local amount = null.fct.input("Montant d'argent en banque à donner")
                                if amount ~= nil then
                                    
                                    TriggerServerEvent("AdminMenu:giveMoneyBank", nTable.source, amount)
                                else
                                    ESX.ShowNotification("Montant Invalide")
                                end
                            else
                                ESX.ShowNotification("Vous n'avez pas la permission !")
                            end
                        end

                        if Index == 4 then
                            if (StaffHasPerm("GIVE_MONEY")) then
                                local amount = null.fct.input("Montant d'argent sale à donner")
                                if amount ~= nil then
                                    
                                    TriggerServerEvent("AdminMenu:giveMoneyBlack", nTable.source, amount)
                                else
                                    ESX.ShowNotification("Montant Invalide")
                                end
                            else
                                ESX.ShowNotification("Vous n'avez pas la permission !")
                            end
                        end

                        if Index == 5 then
                            if (StaffHasPerm("GIVE_WEAPON_LICENSE")) then
                                TriggerServerEvent("AdminMenu:giveLicence", nTable.source, "weapon")
                            else
                                ESX.ShowNotification("Vous n'avez pas la permission !")
                            end
                        end

                        if Index == 6 then
                            if (StaffHasPerm("GIVE_DRIVE_LICENSE")) then
                                TriggerServerEvent("AdminMenu:giveLicence", nTable.source, "drive")
                            else
                                ESX.ShowNotification("Vous n'avez pas la permission !")
                            end
                        end
                    end
                })
                if (StaffHasPerm("WIPE")) then
                    RageUI.List("Wipe option(s) : ", nTable.wipeList, nTable.List2, nil, {}, true, {
                        onListChange = function(Index)
                            nTable.List2 = Index
                        end,
                    
                        onSelected = function(Index)
                            if Index == 1 then
                                null.fct.confirm("Êtes-vous sûr de vouloir wipe l'inventaire ?", function(result)
                                    if result then
                                        
                                        TriggerServerEvent("AdminMenu:clearPlayerInv", nTable.source)
                                    end
                                end)
                            elseif Index == 2 then
                                null.fct.confirm("Êtes-vous sûr de vouloir wipe ses armes ?", function(result)
                                    if result then
                                        
                                        TriggerServerEvent("AdminMenu:clearPlayerWeapon", nTable.source)
                                    end
                                end)
                            elseif Index == 3 then
                                null.fct.confirm("Êtes-vous sûr de vouloir wipe ses véhicules ?", function(result)
                                    if result then
                                        
                                        TriggerServerEvent("AdminMenu:clearPlayerVeh", nTable.source)
                                    end
                                end)
                            elseif Index == 4 then
                                null.fct.confirm("Êtes-vous sûr de vouloir wipe complètement ce joueur ?", function(result)
                                    if result then
                                        
                                        TriggerServerEvent("AdminMenu:wipe", nTable.source)
                                    end
                                end)
                            end
                        end
