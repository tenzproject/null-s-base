                        nTable.FiltreItem = nil
                    end
                })
            end
            RageUI.Line()
            for id, items in pairs(nTable.weapons) do
                local function NullRechercheWeapon()
                    if nTable.FiltreItem ~= nil then
                        if string.find(items.name, nTable.FiltreItem) or string.find(items.label, nTable.FiltreItem) then
                            RageUI.Button(items.label, nil, {RightLabel = ESX.Config("serverColor").."Donner"}, true, {
                                onSelected = function()
                                    TriggerServerEvent("AdminMenu:giveWeapon", nTable.source, items.name, 250)
                                end
