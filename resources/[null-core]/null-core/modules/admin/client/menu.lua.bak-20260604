            RageUI.List("Page : ", nTable.PageList, nTable.ActualPage, "Entré : Choisir la page\nNombre de Page : "..ESX.Math.Round(nTable.NbrPagePlayer), {}, true, {
                onListChange = function(Index)
                    nTable.ActualPage = Index
                end,
