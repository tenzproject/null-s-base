                        end
                    }, sub_Server_Safezones_edit)
                else
                    if string.find(string.lower(v.name), nTable.FiltreZoneSafe) then
                        RageUI.Button(v.name, nil, {RightBadge = nil}, true, {
                            onSelected = function()
                                nTable.SelectedSafeZone = v

