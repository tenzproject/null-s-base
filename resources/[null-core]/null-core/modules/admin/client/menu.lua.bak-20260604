function UsableItemIsValid(data)
    if data.name == nil then
        return false
    end 
    if data.label == nil then
        return false
    end 
    if data.weight == nil then
        return false
    end 
    if data.usable then
        if data.type == nil then
            return false
        end 
        if data.number == nil then
            return false
        end 
    end
    return true
end

-- ============================================================
-- Helper : qualité Métabolisme pour les crafts restaurants
-- ============================================================
RestaurantCraftMetaQualities = { "junk", "meal", "gourmet", "drink", "soda", "alcohol" }
RestaurantCraftMetaQualityLabels = {
    junk    = "Junk Food (supérette)",
    meal    = "Plat équilibré (restaurant)",
    gourmet = "Gastronomie (haut de gamme)",
    drink   = "Boisson (eau / jus)",
    soda    = "Soda",
    alcohol = "Alcool",
}

function GetDefaultCraftMetabolism()
    return { quality = "meal" }
end

function EnsureCraftMetabolism()
    if nTable.CreateRestaurantCraftsMetabolism == nil then
        nTable.CreateRestaurantCraftsMetabolism = GetDefaultCraftMetabolism()
    end
    if nTable.CreateRestaurantCraftsMetabolismCatIdx == nil then
        nTable.CreateRestaurantCraftsMetabolismCatIdx = 2 -- "meal"
        for i, q in ipairs(RestaurantCraftMetaQualities) do
            if q == (nTable.CreateRestaurantCraftsMetabolism.quality or "meal") then
                nTable.CreateRestaurantCraftsMetabolismCatIdx = i
                break
            end
        end
    end
end

function RenderRestaurantCraftMetabolism()
    EnsureCraftMetabolism()
    local m = nTable.CreateRestaurantCraftsMetabolism
    RageUI.Separator("Qualité nutritionnelle")
    local display = {}
    for _, q in ipairs(RestaurantCraftMetaQualities) do
        table.insert(display, RestaurantCraftMetaQualityLabels[q])
    end
    RageUI.List("Qualité", display, nTable.CreateRestaurantCraftsMetabolismCatIdx,
        "Détermine l'impact sur la forme du joueur.", {}, true, {
        onListChange = function(Index)
            nTable.CreateRestaurantCraftsMetabolismCatIdx = Index
            m.quality = RestaurantCraftMetaQualities[Index]
        end,
    })
    RageUI.Line()
end

function ResetCraftMetabolism()
    nTable.CreateRestaurantCraftsMetabolism = GetDefaultCraftMetabolism()
    nTable.CreateRestaurantCraftsMetabolismCatIdx = 2
end

