                end
            })
        end)
        RageUI.IsVisible(sub_Server_Boutique_UniqueVehicles_Edit, function()
            while SelectedVeh == nil do 
                return RageUI.Separator("Chargement..")
            end
            RageUI.Separator("Stock Disponible: "..SelectedVeh.stock)
            if SelectedVeh.idunique then
                RageUI.Separator("Réservée à : "..tostring(SelectedVeh.idunique))
            end
            RageUI.Button('Changer le model', nil, {}, true, {
                onSelected = function()
                    local newData = null.fct.input("Nouveau model ?")
                    if not newData then return end
                    SelectedVeh.model = newData
                    TriggerServerEvent("null:boutique:staff:UniqueVeh", SelectedVeh.id, SelectedVeh)
                end
            })
            RageUI.Button('Changer l\'idunique réservée', nil, {}, true, {
                onSelected = function()
                    local newData = null.fct.input("Nouveau idunique (0 pour aucune) ?")
                    if not newData then return end
                    if newData == 0 then newData = nil end
                    SelectedVeh.idunique = newData
                    TriggerServerEvent("null:boutique:staff:UniqueVeh", SelectedVeh.id, SelectedVeh)
                end
            })
            RageUI.Button('Changer le stock disponible', nil, {}, true, {
                onSelected = function()
                    local newData = null.fct.input("Nouveau stock ?")
                    if not newData then return end
                    SelectedVeh.stock = newData
                    TriggerServerEvent("null:boutique:staff:UniqueVeh", SelectedVeh.id, SelectedVeh)
                end
            })
            RageUI.Button('Supprimer', nil, {}, true, {
                onSelected = function()
                    local confirm = null.fct.confirm("Êtes-vous sur ?")
                    if confirm then
                        TriggerServerEvent("null:boutique:staff:UniqueVeh", SelectedVeh.id, nil)
                        RageUI.GoBack()
                        RageUI.GoBack()
                        SelectedVeh = nil
                    end
                end
            })
        end)
