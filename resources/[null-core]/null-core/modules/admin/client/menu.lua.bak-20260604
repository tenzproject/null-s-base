local gamerTags = {}
local timerr = 0
local lastRequestGamertagChange = nil

-- ======================================================================
-- Helpers de rendu pour les gamertags staff (overlay screen-space)
-- ======================================================================

-- Dessine une ligne de texte centrée à des coords écran 2D normalisées.
-- La taille reste constante quelle que soit la distance.
local function StaffDrawScreenLine(x, y, text, scale, r, g, b, a)
    SetTextScale(0.0, scale or 0.28)
    SetTextFont(4)
    SetTextProportional(1)
    SetTextColour(r or 220, g or 220, b or 220, a or 230)
    SetTextDropshadow(0, 0, 0, 0, 220)
    SetTextDropShadow()
    SetTextOutline()
    SetTextEntry("STRING")
    SetTextCentre(true)
    AddTextComponentString(text)
    DrawText(x, y)
end

-- Dessine un rectangle screen-space pour les blocs de fond (semi-transparent)
local function StaffDrawBlockBg(x, y, w, h, r, g, b, a)
    DrawRect(x, y, w, h, r or 0, g or 0, b or 0, a or 110)
end

-- Couleurs (palette douce, pas flash)
local C = {
    label   = {170, 170, 180},  -- gris léger pour labels
    value   = {230, 230, 230},  -- blanc cassé pour valeurs neutres
    name    = {245, 245, 245},  -- nom RP (presque blanc)
    accent  = {120, 175, 220},  -- bleu doux (IDs / accents)
    vip     = {220, 180, 90},   -- or doux
    vie_ok  = {130, 200, 130},  -- vert doux
    vie_mid = {220, 200, 110},  -- jaune doux
    vie_low = {220, 130, 90},   -- orange doux
    vie_crit= {220, 90, 90},    -- rouge doux
    job     = {180, 200, 220},  -- bleu-gris (légal)
    illegal = {200, 150, 180},  -- mauve doux (illégal)
    new     = {220, 195, 90},   -- jaune doux pour NEW
    pack    = {210, 150, 200},  -- rose doux pour PACK GF
    kill    = {200, 130, 130},  -- rouge doux
    death   = {170, 170, 175},  -- gris
    report  = {210, 175, 110},  -- ambre doux
}

local function HealthColor(percent)
    if percent <= 0 then return C.vie_crit[1], C.vie_crit[2], C.vie_crit[3] end
    if percent > 70 then return C.vie_ok[1], C.vie_ok[2], C.vie_ok[3] end
    if percent > 40 then return C.vie_mid[1], C.vie_mid[2], C.vie_mid[3] end
    if percent > 15 then return C.vie_low[1], C.vie_low[2], C.vie_low[3] end
    return C.vie_crit[1], C.vie_crit[2], C.vie_crit[3]
end

local function FormatPlaytime(secs)
    secs = tonumber(secs) or 0
    if secs <= 0 then return "0m" end

    local d = math.floor(secs / 86400)
    local h = math.floor((secs % 86400) / 3600)
    local m = math.floor((secs % 3600) / 60)

    local parts = {}
    if d > 0 then table.insert(parts, ("%dj"):format(d)) end
    if h > 0 then table.insert(parts, ("%dh"):format(h)) end
    if m > 0 or #parts == 0 then table.insert(parts, ("%dm"):format(m)) end
    return table.concat(parts, " ")
end

--local uniqueid = 0
function showNames(bool)
    local oldBool = isNameShown
    isNameShown = bool
    if not null.cooldown and lastRequestGamertagChange ~= bool then
        null.fct.cooldown(2500)
        lastRequestGamertagChange = bool
        TriggerServerEvent("null:staff:changegamertag", bool, oldBool)
    end
    if isNameShown then
        -- Thread de rendu HUD (60fps) pour l'overlay screen-space au-dessus des gamertags
        CreateThread(function()
            while isNameShown do
                Wait(0)
                local myCoords = PlayerState.coords
                if not myCoords then myCoords = GetEntityCoords(PlayerPedId()) end
                local advanced = nTable.gamerTag2 == true
                local maxDist = advanced and 30.0 or 25.0

                for _, player in ipairs(GetActivePlayers()) do
                    local ped = GetPlayerPed(player)
                    if ped ~= 0 and DoesEntityExist(ped) then
                        local pedCoords = GetEntityCoords(ped, false)
                        local dist = #(myCoords - pedCoords)
                        if dist < maxDist and IsEntityOnScreen(ped) and not IsEntityOccluded(ped) then
                            local fetching = RetrievePlayersDataByID(GetPlayerServerId(player))
                            if fetching and fetching.idunique then
                                local headZ = pedCoords.z + (IsPedInAnyVehicle(ped, false) and 0.55 or 1.0)
                                local anchorZ = headZ + (advanced and 0.0 or 0.30)
                                local onScreen, sx, sy = World3dToScreen2d(pedCoords.x, pedCoords.y, anchorZ)
                                if onScreen then
                                    if not advanced then
                                        -- if fetching.new then
                                        --     StaffDrawScreenLine(sx, sy, "(NEW)", 0.30, C.new[1], C.new[2], C.new[3], 240)
                                        -- elseif fetching.havegfpack then
                                        --     StaffDrawScreenLine(sx, sy, "[PACK GF]", 0.28, C.pack[1], C.pack[2], C.pack[3], 235)
                                        -- elseif fetching.vip then
                                        --     StaffDrawScreenLine(sx, sy, "[VIP]", 0.28, C.vip[1], C.vip[2], C.vip[3], 235)
                                        -- end
                                    else
                                        local lh         = 0.018  -- hauteur d'une ligne
                                        local blockGap   = 0.008  -- espace entre blocs
                                        local mainScale  = 0.30
                                        local subScale   = 0.26
                                        local smallScale = 0.24

                                        local lines = {}
                                        local function pushLine(text, scale, r, g, b)
                                            lines[#lines+1] = {text = text, scale = scale, r = r, g = g, b = b}
                                        end
                                        local function pushGap()
                                            lines[#lines+1] = {gap = true}
                                        end

                                        local maxHp = GetEntityMaxHealth(ped) - 100
                                        local curHp = GetEntityHealth(ped) - 100
                                        if maxHp <= 0 then maxHp = 100 end
                                        if curHp < 0 then curHp = 0 end
                                        local pct = math.floor((curHp / maxHp) * 100)
                                        local hr, hg, hb = HealthColor(pct)
                                        local armor = GetPedArmour(ped) or 0
                                        local vieText
                                        if armor > 0 then
                                            vieText = ("VIE: %d / %d  (+%d arm)"):format(curHp, maxHp, armor)
                                        else
                                            vieText = ("VIE: %d / %d"):format(curHp, maxHp)
                                        end
                                        pushLine(vieText, mainScale, hr, hg, hb)
                                        pushGap()

                                        local nameLine = ""
                                        local hasVip = fetching.vip and true or false
                                        if hasVip then nameLine = "~y~[VIP]~s~ " end
                                        nameLine = nameLine .. ("[%s] "):format(fetching.source or "?")
                                        if fetching.firstname or fetching.lastname then
                                            nameLine = nameLine .. (("%s %s"):format(fetching.firstname or "", fetching.lastname or "")):gsub("^%s+", ""):gsub("%s+$", "")
                                        else
                                            nameLine = nameLine .. (GetPlayerName(player) or "?")
                                        end
                                        pushLine(nameLine, mainScale, C.name[1], C.name[2], C.name[3])

                                        local badgeBits = {}
                                        if fetching.new then badgeBits[#badgeBits+1] = "NEW" end
                                        if fetching.havegfpack then badgeBits[#badgeBits+1] = "PACK GF" end
                                        -- local rankSuffix = Config.Admin.RankListGamerTag[fetching.permission_group]
                                        local rankSuffix = Config.Admin.RankListLabel[fetching.permission_group]
                                        if rankSuffix and rankSuffix ~= "" then
                                            local clean = rankSuffix:gsub("^%s*%-%s*", "")
                                            badgeBits[#badgeBits+1] = clean
                                        end
                                        if #badgeBits > 0 then
                                            pushLine(table.concat(badgeBits, "  ·  "), smallScale, C.new[1], C.new[2], C.new[3])
                                        end
                                        pushGap()

                                        do
                                            local idu = fetching.idunique or "?"
                                            local pt = FormatPlaytime(fetching.playtime)
                                            local txt = ("ID Unique: U%s   |   Temps Jeu: %s"):format(idu, pt)
                                            pushLine(txt, subScale, C.accent[1], C.accent[2], C.accent[3])
                                        end

                                        do
                                            local jobLabel = fetching.job and (fetching.job.label or fetching.job.name) or "Aucun"
                                            local job2Label = fetching.job2 and (fetching.job2.label or fetching.job2.name) or "Aucun"
                                            pushLine(("Metier: %s   |   Illegal: %s"):format(jobLabel, job2Label), subScale, C.job[1], C.job[2], C.job[3])
                                        end
                                        pushGap()

                                        do
                                            local kills = fetching.staffKills or 0
                                            local deaths = fetching.staffDeaths or 0
                                            local rMade = fetching.staffReportsMade or 0
                                            local rActive = fetching.staffReportsActive or 0
                                            local statsLine = ("Kills: %d   |   Morts: %d   |   Reports: %d%s"):format(
                                                kills, deaths, rMade,
                                                rActive > 0 and (" ("..rActive.." actif"..(rActive > 1 and "s" or "")..")") or ""
                                            )
                                            local r, g, b
                                            if kills >= 5 or rActive > 0 then
                                                r, g, b = C.kill[1], C.kill[2], C.kill[3]
                                            else
                                                r, g, b = C.report[1], C.report[2], C.report[3]
                                            end
                                            pushLine(statsLine, subScale, r, g, b)
                                        end

                                        local totalH = 0
                                        for i = 1, #lines do
                                            if lines[i].gap then totalH = totalH + blockGap
                                            else totalH = totalH + lh end
                                        end
                                        local startY = sy - totalH
                                        if startY < 0.02 then startY = 0.02 end

                                        local bgW = 0.24
                                        --StaffDrawBlockBg(sx, startY + totalH/2, bgW, totalH + 0.012, 0, 0, 0, 95)

                                        local cy = startY
                                        for i = 1, #lines do
                                            local L = lines[i]
                                            if L.gap then
                                                cy = cy + blockGap
                                            else
                                                StaffDrawScreenLine(sx, cy, L.text, L.scale, L.r, L.g, L.b, 235)
                                                cy = cy + lh
                                            end
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end)

        CreateThread(function()
            while isNameShown do
                timerr = timerr + 1
                for _, player in pairs(GetActivePlayers()) do
                    local ped = GetPlayerPed(player)
                    if #(PlayerState.coords - GetEntityCoords(ped, false)) < 5000.0 then
                        local fetching = RetrievePlayersDataByID(GetPlayerServerId(player))

                        if nTable.gamerTag2 then
                            if gamerTags[player] then
                                RemoveMpGamerTag(gamerTags[player])
                                gamerTags[player] = nil
                            end
                            goto continue_player
                        end

                        local righttext, ids, names = "N/A", tostring(fetching.idunique), GetPlayerName(player)
                        if fetching.job2 then
                            righttext = fetching.job2.name
                        end

                        local newSuffix = fetching.new and " ~y~(NEW)~s~" or ""
                        gamerTags[player] = CreateFakeMpGamerTag(ped,
                        ("(%s) %s%s%s"):format(
                            ids,
                            names,
                            Config.Admin.RankListGamerTag[fetching.permission_group] or "",
                            newSuffix),
                        false, false, righttext or "N/A", 0)
       
                        -- écrit :
                        --SetMpGamerTagAlpha(gamerTags[player], 16, 255)
                        --SetMpGamerTagVisibility(gamerTags[player], 16, exports['chat']:inChat(player))

                        -- casque (radio) :
                        --SetMpGamerTagAlpha(gamerTags[player], 9, 255)
                        --SetMpGamerTagVisibility(gamerTags[player], 9, true)

                        -- voiture :
                        if IsPedInAnyVehicle(ped, false) and nTable.gamerTag2 then
                            SetMpGamerTagAlpha(gamerTags[player], 8, 255)
                            SetMpGamerTagVisibility(gamerTags[player], 8, true)
                        else
                            SetMpGamerTagVisibility(gamerTags[player], 8, false)
                        end

                        -- base :
                        SetMpGamerTagAlpha(gamerTags[player], 0, 255)
                        SetMpGamerTagAlpha(gamerTags[player], 2, 255)
                        SetMpGamerTagAlpha(gamerTags[player], 4, 255)
                        SetMpGamerTagAlpha(gamerTags[player], 7, 255)
                        SetMpGamerTagVisibility(gamerTags[player], 0, true)
                        SetMpGamerTagVisibility(gamerTags[player], 2, true)
                        SetMpGamerTagVisibility(gamerTags[player], 4, NetworkIsPlayerTalking(player))

                        
                        if fetching.status ~= nil and type(fetching.status) == "table" and nTable.gamerTag3 then
                            --[[local hunger = 0
                            local thirst = 0
                            for k,v in pairs(fetching.status) do
                                if v.name == "hunger" then hunger = v.percent end
                                if v.name == "thirst" then thirst = v.percent end
                            end
                            if timerr < 5 then
                                SetMpGamerTagDisablePlayerHealthSync(gamerTags[player], false)
                                SetMpGamerTagHealthBarColour(gamerTags[player],0)
                            elseif timerr < 10 then
                                SetMpGamerTagDisablePlayerHealthSync(gamerTags[player], true)
                                SetMpGamerTagOverridePlayerHealth(gamerTags[player], ESX.Math.Round(hunger)*2, GetEntityMaxHealth(ped))
                                SetMpGamerTagHealthBarColour(gamerTags[player],18)
                            elseif timerr < 15 then
                                SetMpGamerTagDisablePlayerHealthSync(gamerTags[player], true)
                                SetMpGamerTagOverridePlayerHealth(gamerTags[player], ESX.Math.Round(thirst)*2, GetEntityMaxHealth(ped))
                                SetMpGamerTagHealthBarColour(gamerTags[player],9)
                            elseif timerr < 20 and IsPedInAnyVehicle(ped, false) then 
                                SetMpGamerTagDisablePlayerHealthSync(gamerTags[player], true)
                                local vehHeal = math.floor(GetVehicleEngineHealth(GetVehiclePedIsIn(ped, false)) / 10)
                                SetMpGamerTagOverridePlayerHealth(gamerTags[player], vehHeal * 2, GetEntityMaxHealth(ped))
                                SetMpGamerTagHealthBarColour(gamerTags[player],3)
                            else
                                timerr = 0
                            end]]
                        else
                            SetMpGamerTagDisablePlayerHealthSync(gamerTags[player], false)
                            SetMpGamerTagHealthBarColour(gamerTags[player],0)
                        end

                        if nTable.gamerTag2 == false or (fetching.job2 == nil or fetching.job2.name == nil or fetching.job2.name == 'unemployed2' or fetching.job2.name == 'unemployed') then 
                            SetMpGamerTagVisibility(gamerTags[player], 1, false)
                        else
                            SetMpGamerTagVisibility(gamerTags[player], 1, true)
                        end
                        if fetching.vip and nTable.gamerTag2 then
                            SetMpGamerTagVisibility(gamerTags[player], 14, true)
                            SetMpGamerTagAlpha(gamerTags[player], 14, 255)
                            SetMpGamerTagColour(gamerTags[player], 14, 12)
                        end
                        if fetching.group ~= "user" then
                            local color = 6
                            local always = false
                            local star = false
                            for i,v in pairs(Config.Admin.RankList) do
                                if type(v) ~= "boolean" and v.rank == fetching.group then 
                                    color = v.gamertag_color
                                    always = v.alwayscolored
                                    star = v.star
                                end
                            end
                            if always then
                                if star then
                                    SetMpGamerTagVisibility(gamerTags[player], 7, true)
                                    SetMpGamerTagAlpha(gamerTags[player], 7, 255)
                                    SetMpGamerTagColour(gamerTags[player], 7, 0) 
                                end
                                -- Couleur Volant
                                SetMpGamerTagColour(gamerTags[player], 8, color)
                                -- Couleur Pseudo rouge
                                SetMpGamerTagVisibility(gamerTags[player], 0, true)
                                SetMpGamerTagAlpha(gamerTags[player], 0, 255)
                                SetMpGamerTagColour(gamerTags[player], 0, color) 
                            else
                                if fetching.staffmode then
                                    SetMpGamerTagVisibility(gamerTags[player], 0, true)
                                    SetMpGamerTagAlpha(gamerTags[player], 0, 255)
                                    SetMpGamerTagColour(gamerTags[player], 0, color) 
                                else
                                    SetMpGamerTagVisibility(gamerTags[player], 0, true)
                                    SetMpGamerTagAlpha(gamerTags[player], 0, 255)
                                    SetMpGamerTagColour(gamerTags[player], 0, 0) 
                                end
                            end

                            if fetching.gamertag then
                                SetMpGamerTagVisibility(gamerTags[player], 10, true)
                                SetMpGamerTagAlpha(gamerTags[player], 10, 255)
                                SetMpGamerTagColour(gamerTags[player], 10, 10) 
                            else
                                SetMpGamerTagVisibility(gamerTags[player], 10, false)
                                SetMpGamerTagAlpha(gamerTags[player], 10, 0)
                                SetMpGamerTagColour(gamerTags[player], 10, 10) 
                            end
                        end

                        if NetworkIsPlayerTalking(player) then
                            SetMpGamerTagHealthBarColour(gamerTags[player], 211)
                            SetMpGamerTagColour(gamerTags[player], 4, 211)
                            SetMpGamerTagColour(gamerTags[player], 0, 211)
                            SetMpGamerTagColour(gamerTags[player], 8, 211)
                        elseif fetching.group == "user"then
                            SetMpGamerTagHealthBarColour(gamerTags[player], 0)
                            SetMpGamerTagColour(gamerTags[player], 4, 0)
                            SetMpGamerTagColour(gamerTags[player], 0, 0)
                        end

                        --[[if DecorExistOn(ped, "staffl") then
                            SetMpGamerTagWantedLevel(ped, DecorGetInt(ped, "staffl"))
                        end
                        if mpDebugMode then
                            print(json.encode(DecorExistOn(ped, "staffl")).." - "..json.encode(DecorGetInt(ped, "staffl")))
                        end]]
                    else
                        RemoveMpGamerTag(gamerTags[player])
                        gamerTags[player] = nil
                    end
                    ::continue_player::
                    -- end
                end
                Wait(300)
            end
            for k,v in pairs(gamerTags) do
                RemoveMpGamerTag(v)
            end
            gamerTags = {}
        end)
    end
end

exports("showNames", showNames)

local allBlipsIllegal = {}
function showIllegalBlips()
    if nTable.illegalBlips then
        for k,v in pairs(Config.Admin.IllegalBlips) do
            allBlipsIllegal[k] = AddBlipForCoord(v.pos.x, v.pos.y, v.pos.z)
            SetBlipSprite(allBlipsIllegal[k], 84)
            SetBlipDisplay(allBlipsIllegal[k], 4)
            SetBlipScale(allBlipsIllegal[k], 0.8)
            SetBlipColour(allBlipsIllegal[k], 1)
            SetBlipAsShortRange(allBlipsIllegal[k], true)
            BeginTextCommandSetBlipName("STRING")
            AddTextComponentString("Illegal Point: "..v.label)
            EndTextCommandSetBlipName(allBlipsIllegal[k])
        end
    else
        for k,v in pairs(allBlipsIllegal) do
            if DoesBlipExist(v) then
                RemoveBlip(v)
            end
        end
    end
end


function SuperJump(bool)
    CreateThread(function()
        if bool then
            while nTable.superjump do
                SetSuperJumpThisFrame(PlayerId())
                Citizen.Wait(waitmax1)
            end
        end
    end)
end

function SuperSprint(bool)
    CreateThread(function()
        if bool then
            while nTable.supersprint do
                SetPedMoveRateOverride(PlayerPedId(), vitessesprint)
                Citizen.Wait(waitmax2)
            end
        end
    end)
end


