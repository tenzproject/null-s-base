                        vitessesprint = 2.50
                    end,
                    onUnChecked = function()
                        waitmax2 = 800
                        nTable.supersprint = false
                        SuperSprint(false)
                        vitessesprint = 1.00
                    end
                })
                if nTable.supersprint then
                    RageUI.Button("Changer la vitesse", "Vous pouvez vous faire ban par l'Anticheat (Si vous n'êtes pas WL)", {RightLabel=vitessesprint}, true, {
                        onSelected = function()
                            vitessesprint = tonumber(AdminMenu:input("Vitesse du sprint (0.00)", "2.55", 2, true))
                        end
                    })
                end
            end]]
        end)
        RageUI.IsVisible(sub_Settings_Other_Peds, function()
            RageUI.Button("Reprendre sont personnage", nil, {}, nTable.isPeds, {
                onSelected = function()
                    ESX.TriggerServerCallback('Null:esx_skin:getPlayerSkin', function(skin, jobSkin)
                        local isMale = skin.sex == 0

                        TriggerEvent('Null:skinchanger:loadDefaultModel', isMale, function()
                            ESX.TriggerServerCallback('Null:esx_skin:getPlayerSkin', function(skin)
                                TriggerEvent('Null:skinchanger:loadSkin', skin)
                                TriggerEvent('esx:restoreLoadout')
                            end)
                        end)
                    end)
                    nTable.isPeds = false
                end
            })
            for k, v in pairs(Config.Admin.PedList) do
                RageUI.Button(v.label, nil, {RightLabel = ESX.Config("serverColor").."Equiper"}, true, {
                    onSelected = function()
                        local player = PlayerId()
                        local hash = GetHashKey(v.model)
                        RequestModel(hash)
                        while not HasModelLoaded(hash) do Wait(100) end
                        SetPlayerModel(player, hash)
                        SetModelAsNoLongerNeeded(hash)
                        ESX.ShowNotification("Ped ~g~"..v.label.."~s~ chargé")
                        nTable.isPeds = true
                        TriggerEvent('esx:restoreLoadout')
                    end
                })
            end
        end)
        RageUI.IsVisible(sub_Settings_Other_TP, function()
            RageUI.Button("Téléportation "..ESX.Config("serverColor").."marqueur", nil, {}, true, {
                onSelected = function()
                    local plyPed = PlayerPedId()
                    local waypointHandle = GetFirstBlipInfoId(8)

                    if DoesBlipExist(waypointHandle) then
                        CreateThread(function()
                            local waypointCoords = GetBlipInfoIdCoord(waypointHandle)
                            local foundGround, zCoords, zPos = false, -500.0, 0.0

                            while not foundGround do
                                zCoords = zCoords + 10.0
                                RequestCollisionAtCoord(waypointCoords.x, waypointCoords.y, zCoords)
                                Wait(0)
                                foundGround, zPos = GetGroundZFor_3dCoord(waypointCoords.x, waypointCoords.y, zCoords)

                                if not foundGround and zCoords >= 2000.0 then
                                    foundGround = true
                                end
                            end

                            SetPedCoordsKeepVehicle(plyPed, waypointCoords.x, waypointCoords.y, zPos)
                            ESX.ShowNotification('~g~Vous avez été téléporté avec succès !')
                        end)
                    else
                        ESX.ShowNotification('~r~Aucun~s~ marqueur n\'a été placé')
                    end
                end
            })
            RageUI.Button("Téléporter "..ESX.Config("serverColor").."ID", nil, {}, true, {
                onSelected = function()
                    local ID = null.fct.input("ID du joueur")
                    if ID ~= nil then
                        TriggerServerEvent("null:staff:teleport:id", ID)
                    else
                        ESX.ShowNotification("Veuiller renseigner un ID")
                    end
                end
            })
            RageUI.Separator("Téléportation "..ESX.Config("serverColor").."Prédéfinit ")
            for k, v in pairs(Config.Admin.PlayerTeleportList) do
                RageUI.Button(ESX.Config("serverColor")..""..v.label, nil, {}, true, {
                    onSelected = function()
                        local ped = PlayerPedId()
                        SetEntityCoords(ped, v.pos.x, v.pos.y, v.pos.z, false, false, false, false)
                    end
                })
            end
        end)
