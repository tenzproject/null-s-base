                if v.firstname == nil or v.lastname == nil or v.lastname == nil or v.name == nil then goto continue end
                if RechercheSocietyMembreList ~= nil then
                    if string.find(string.lower(v.name), RechercheSocietyMembreList) or string.find(v.idunique, RechercheSocietyMembreList) or string.find(string.lower(v.identifier), RechercheSocietyMembreList) or string.find(string.lower(v.lastname), RechercheSocietyMembreList) or string.find(string.lower(v.firstname), RechercheSocietyMembreList) then
                        RageUI.Button(v.firstname.." "..v.lastname.." ("..v.name..", U"..v.idunique..")", "Id unique : "..v.idunique.."\n"..v.identifier, {}, true, {
                            onSelected = function()
                                -- @TODO: Ajoute un sous menu gestion membre companies
                                ESX.ShowNotification("Aucune action disponible sur les membres d'entreprise pour l'instant.") 
                            end
                        })
                    end
                else
                    RageUI.Button(v.firstname.." "..v.lastname.." ("..v.name..", U"..v.idunique..")", "Id unique : "..v.idunique.."\n"..v.identifier, {}, true, {
                        onSelected = function()
                            
                        end
                    })
                end
                ::continue::
            end
        end)
        RageUI.IsVisible(sub_Server_Companies_Selected_SetJob, function()
            if nTable.SelectedEntreprise == nil then
                return RageUI.Separator("Chargement de l'entreprise")
            end
            if nTable.allGrades == nil then
                return RageUI.Separator("Chargement des grades de l'entreprise")
            end

            if nTable.SelectedEntreprise.label ~= nil and nTable.SelectedEntreprise.name ~= nil and nTable.SelectedEntreprise.type ~= nil then
                RageUI.InfoPanel({
                    title = "Entreprise sélectionnée",
                    items = {
                        { label = "Nom", value = nTable.SelectedEntreprise.label },
                        { label = "Type d'entreprise", value = nTable.SelectedEntreprise.type },
                        { label = "Setjob", value = nTable.SelectedEntreprise.name },
                        { label = "Nombre de membre", value = (nTable.SelectedEntreprise.members ~= nil and #nTable.SelectedEntreprise.members or "N/A") },
                    }
                })
            else 
                return RageUI.Separator("Chargement...")
            end

            for k, v in pairs(nTable.allGrades) do
                RageUI.Button(v.gradeLabel, nil, {RightLabel = "~b~Attribuer"}, true, {
                    onSelected = function()
                        ExecuteCommand(("%s %s %s %s"):format(Config.Admin.Commands.setjob, ESX.PlayerData.idunique, nTable.SelectedEntreprise.name, v.gradeJob))
                    end
                })
            end

        end)
        RageUI.IsVisible(sub_Server_Companies_Selected_Garage, function()
            if nTable.SelectedEntreprise.Garage == nil then
                return RageUI.Separator("Chargement du garage")
            end
            RageUI.Button("Attribuer un véhicule", nil, {}, true, {
                onSelected = function()
                    local model = null.fct.input("Model du véhicule ?")
                    local type = null.fct.input("Type du véhicule ? (car, boat, aircraft)")
                    if model == nil or type == nil then return end
                    TriggerServerEvent("Kayce:AddVehToClient", nTable.SelectedEntreprise.name, model, nil, type, false, true, true)         
                
                    Wait(1000)
                    ESX.TriggerServerCallback("null:staff:getsocietyVeh", function(result1)
                        nTable.SelectedEntreprise.Garage = result1
                    end, nTable.SelectedEntreprise.name)
                end
            })
            if RechercheNullPlayerGarage == nil then
                RageUI.Button("Rechercher", nil, {}, true, {
                    onSelected = function()
                        local input = null.fct.input("Plaque/Model/Nom du véhicule")
                        if not input then return end
                        RechercheNullPlayerGarage = string.lower(input)
                    end
                })
            else
                RageUI.Button("Arreter la recherche", nil, {}, true, {
                    onSelected = function()
                        RechercheNullPlayerGarage = nil
                    end
                })
            end
            RageUI.Line()
            for k,x in pairs(nTable.SelectedEntreprise.Garage) do
                    if RechercheNullPlayerGarage ~= nil then
                        if string.find(RechercheNullPlayerGarage, string.lower(x.plate)) or string.find(RechercheNullPlayerGarage, string.lower(x.vehicle.model)) or string.find(RechercheNullPlayerGarage, string.lower(x.label)) then
                            local rightBadgeBoutique = {}
                            boutiquelabel = "Non"
                            if x.state == true then
                                rightBadgeBoutique = {}
                                boutiquelabel = "Oui"
                            end
                            if x.state == nil or x.state == false then
                                rightBadgeBoutique = {}
                                boutiquelabel = "Non"
                            end
                            RageUI.Button('['..GetLabelText(GetDisplayNameFromVehicleModel(x.vehicle.model))..'] - '..x.label.." ("..x.plate..")", "Appuyez sur [ENTRER] pour supprimer le véhicule\n\nPlaque : "..x.plate.."\nFourriere : "..boutiquelabel, rightBadgeBoutique, true, {
                                onSelected = function()
                                    TriggerServerEvent("vAdminMenu:deletegaragevh", x.vehicle.model, x.plate)
                                end
                            })
                        end
                    else
                        local rightBadgeBoutique = {}
                        boutiquelabel = "Non"
                        if x.state == true then
                            rightBadgeBoutique = {}
                            boutiquelabel = "Oui"
                        end
                        if x.state == nil or x.boutique == false then
                            rightBadgeBoutique = {}
                            boutiquelabel = "Non"
                        end
                        RageUI.Button('['..GetLabelText(GetDisplayNameFromVehicleModel(x.vehicle.model))..'] - '..x.label.." ("..x.plate..")", "Appuyez sur [ENTRER] pour supprimer le véhicule\n\nPlaque : "..x.plate.."\nFourriere : "..boutiquelabel, rightBadgeBoutique, true, {
                            onSelected = function()
                                TriggerServerEvent("vAdminMenu:deletegaragevh", x.vehicle.model, x.plate)
                            end
                        })
                    end
            end
        end)

