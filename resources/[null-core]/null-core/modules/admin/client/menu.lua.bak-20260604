        RageUI.IsVisible(sub_Server_Factions, function()
            RageUI.Button('Ajoutez un nouveau Groupe Illégal', nil, {}, true, {
                onSelected = function()
                    PosZoneGang = {}
                    RageUI.Visible(sub_Server_Factions_Create, true)
            end})
            RageUI.Button('Modifier/Supprimer un Groupe Illégal', nil, {}, true, {
                onSelected = function()
                    if #GangsList == 0 then
                        TriggerServerEvent('null:initGangs')
                    end
            end}, sub_Server_Factions_List)
        end)

        RageUI.IsVisible(sub_Server_Factions_Create, function()
            RageUI.Button('Nom du SetJob', "Aucune majuscule ni espace !", {RightLabel = namegang}, true, {
                onSelected = function()
                    local setJobName = null.fct.input("Quel nom veux-tu mettre ?")
            
                    if setJobName and setJobName ~= '' then
                        namegang = setJobName
                    end
                end
            })
            RageUI.Button('Nom Affiché', nil, {RightLabel = labelgang}, true, {
                onSelected = function()
                    local labelName = null.fct.input("Quel nom veux-tu mettre ?")
            
                    if labelName and labelName ~= '' then
                        labelgang = labelName
                    end
                end
            })            
            RageUI.Button('Coffre', posCoffre or 'Aucune', {}, true, {
                onSelected = function()
                    posCoffre = GetEntityCoords(PlayerPedId())
            end})

            RageUI.Button('Position Fabrication', posFabCreation or 'Aucune', {}, true, {
                onSelected = function()
                    posFabCreation = GetEntityCoords(PlayerPedId())
            end}) 
            
            
            RageUI.Button("Ajouter un point de zone", nil, {}, true, {
                onSelected = function()
                    if namegang == nil then
                        return ESX.ShowNotification("~r~Veuillez d'abord entrer le nom de la zone")
                    end

                    local pos = GetEntityCoords(PlayerPedId())
                    table.insert(PosZoneGang, vector2(pos.x, pos.y))

                    if tempZoneGang == nil then
                        tempZoneGang = PolyZone:Create({
                            vector2(pos.x, pos.y)
                        }, {
                            name = ("territories_%s"):format(namegang),
                            debugGrid = true
                        })
                    else
                        tempZoneGang.points[#tempZoneGang.points + 1] = vector2(pos.x, pos.y)
                    end
                end
            })

            if #PosZoneGang > 0 then
                RageUI.Button("Retirer le dernier point de la zone", nil, {}, true, {
                    onSelected = function()
                        PosZoneGang[#PosZoneGang] = nil

                        if tempZoneGang ~= nil then
                            tempZoneGang.points[#tempZoneGang.points] = nil
                        end

                        if #PosZoneGang == 0 then
                            if tempZoneGang ~= nil then
                                tempZoneGang:destroy()
                                tempZoneGang = nil
                            end
                        end
                    end
                })

                RageUI.Button("Retirer tous les points de zone", nil, {}, true, {
                    onSelected = function()
                        if tempZoneGang ~= nil then
                            tempZoneGang:destroy()
                            tempZoneGang = nil
                        end

                        PosZoneGang = {}
                    end
                })
            end
            RageUI.List("Type", nTable.TypeGangBuilder, nTable.IndexTypeGangBuilder, nil, {}, true, {
                onListChange = function(Index)
                    nTable.IndexTypeGangBuilder = Index;
                end
            })
            if nTable.TypeGangBuilder[nTable.IndexTypeGangBuilder] ~= nil then
                local Starterpacklabel = ""
                local TheStarter = Config.StarterPack["Illégal"] and Config.StarterPack["Illégal"][nTable.TypeGangBuilder[nTable.IndexTypeGangBuilder]]
                if TheStarter then
                    for i = 1, #TheStarter do
                        v = TheStarter[i]

                        Starterpacklabel = Starterpacklabel.."\n"..v.quantity.."x "..v.name.." ("..v.type..")"
                    end

                    RageUI.Checkbox("Starter Pack", "Starter Pack : "..nTable.TypeGangBuilder[nTable.IndexTypeGangBuilder].."\n"..Starterpacklabel, StarterPack, {}, {
                        onSelected = function(Index)
                            StarterPack = Index
                        end
                    })
                end
            end
            RageUI.Checkbox("Kit Arme", nil, KitArme, {}, {
                onSelected = function(Index)
                    KitArme = Index
                end
            })
            RageUI.Checkbox("Craft Arme", nil, KitArmeFab, {}, {
                onSelected = function(Index)
                    KitArmeFab = Index
                end
            })
            RageUI.Button('Confirmer', nil, { Color = { BackgroundColor = {255,244,79, 120} } }, true, {
                onSelected = function()
                    TriggerServerEvent('null:createGang', namegang, labelgang, posCoffre, KitArme, KitArmeFab, PosZoneGang, StarterPack, nTable.TypeGangBuilder[nTable.IndexTypeGangBuilder], posFabCreation)
                    RageUI.GoBack() 
                    if tempZoneGang ~= nil then
                        tempZoneGang:destroy()
                    end
                    KitArme = false
                    KitArmeFab = false
                    Point = 0
                    namegang = 'Aucun'
                    labelgang = 'Aucun'
                    StarterPack = false
                    posFabCreation = 'Aucune'
                    posCoffre = 'Aucune'
            end})
        end)

        RageUI.IsVisible(sub_Server_Factions_List, function()
            RageUI.Button('Rechercher', nil, {}, true, {
                onSelected = function()
                    local input = null.fct.input("Nom du groupe a rechercher")
                    if not input then return end
                    RechercheGangList = string.lower(input)
                end
            })
            RageUI.Button('Arreter votre recherche', nil, {}, true, {
                onSelected = function()
                    RechercheGangList = nil
                end
            })
            RageUI.Line()
            for k,v in pairs(GangsList) do
                if RechercheGangList ~= nil then
                    if string.find(string.lower(v.name), RechercheGangList) or string.find(string.lower(v.label), RechercheGangList) then
                        RageUI.Button(v.label.." ("..v.name..")", nil, {}, true, {
                            onSelected = function()
                                if TempZoneCreateForEditGang ~= nil then
                                    TempZoneCreateForEditGang:destroy()
                                    if #v.zone > 0 then
                                        TempZoneCreateForEditGang = PolyZone:Create(v.zone, {
                                            name = ("gangtemp_%s"):format(v.name),
                                            debugGrid = true
                                        })
                                    end
                                else
                                    if #v.zone > 0 then
                                        TempZoneCreateForEditGang = PolyZone:Create(v.zone, {
                                            name = ("gangtemp_%s"):format(v.name),
                                            debugGrid = true
                                        })
                                    end
                                end
                                SelectedGang = v
                                NewCoffrePosition = vector3(math.floor(SelectedGang.posCoffre.x), math.floor(SelectedGang.posCoffre.y), math.floor(SelectedGang.posCoffre.z))
                                if SelectedGang.posFabrication then
                                    NewFabricationPosition = vector3(math.floor(SelectedGang.posFabrication.x), math.floor(SelectedGang.posFabrication.y), math.floor(SelectedGang.posFabrication.z))
                                end
                                PositionChanged = false 
                                NbrPointGang = v.Point
                                NbrPointGangSave = v.Point
                                KitArmeGang = false
                                KitArmeFabGang = false
                                PositionChangedCoffre = false
                                FinishKitArmeValue = false
                                if SelectedGang.FabArme == 1 then
                                    KitArmeFabGang = true
                                else
                                    KitArmeFabGang = false
                                end
                                if SelectedGang.KitArme == 1 then
                                    KitArmeGang = true
                                else
                                    KitArmeGang = false
                                end
                        end}, sub_Server_Factions_List_Select)
                    end
                else
                    RageUI.Button(v.label.." ("..v.name..")", nil, {}, true, {
                        onSelected = function()
                            if TempZoneCreateForEditGang ~= nil then
                                TempZoneCreateForEditGang:destroy()
                                if #v.zone > 0 then
                                    TempZoneCreateForEditGang = PolyZone:Create(v.zone, {
                                        name = ("gangtemp_%s"):format(v.name),
                                        debugGrid = true
                                    })
                                end
                            else
                                if #v.zone > 0 then
                                    TempZoneCreateForEditGang = PolyZone:Create(v.zone, {
                                        name = ("gangtemp_%s"):format(v.name),
                                        debugGrid = true
                                    })
                                end
                            end
                            SelectedGang = v
                            NewCoffrePosition = vector3(math.floor(SelectedGang.posCoffre.x), math.floor(SelectedGang.posCoffre.y), math.floor(SelectedGang.posCoffre.z))
                            if SelectedGang.posFabrication then
                                NewFabricationPosition = vector3(math.floor(SelectedGang.posFabrication.x), math.floor(SelectedGang.posFabrication.y), math.floor(SelectedGang.posFabrication.z))
                            end
                            PositionChanged = false
                            NbrPointGang = v.Point
                            NbrPointGangSave = v.Point
                            KitArmeGang = false
                            KitArmeFabGang = false
                            PositionChangedCoffre = false
                            FinishKitArmeValue = false
                            if SelectedGang.FabArme == 1 then
                                KitArmeFabGang = true
                            else
                                KitArmeFabGang = false
                            end
                            if SelectedGang.KitArme == 1 then
                                KitArmeGang = true
                            else
                                KitArmeGang = false
                            end
                    end}, sub_Server_Factions_List_Select)
                end
            end
        end)

        RageUI.IsVisible(sub_Server_Factions_List_Select, function()
            if SelectedGang.name ~= nil then
                RageUI.Separator("Nom du groupe illégal : "..SelectedGang.label)
                RageUI.Separator("setjob2 : "..SelectedGang.name)
                RageUI.Line()
                RageUI.Button('Liste des membres', nil, {Null = {id = "staff-plylistgang", LoadingOnSelect = 300, description = "Chargement de la liste des membres."}}, true, {
                    onSelected = function()
                        ESX.TriggerServerCallback("Null:GetMemberOfGangs", function(result) 
                            SelectedGang.PlyList = result
                        end, "staff", SelectedGang.name)
                    end
                }, sub_Server_Factions_List_Select_Members)
                if (StaffHasPerm("WIPE")) then
                    RageUI.Button('Wipe tous les membres du groupe', nil, {}, true, {
                        onSelected = function()
                            local result = null.fct.confirm('Voulez-vous wipe les membres du groupe')
                            if result ~= true then return end
                            TriggerServerEvent("Null:wipeallGangMember", SelectedGang.name)
                        end
                    })
                end
                RageUI.Button('~r~Supprimer le groupe illégal~s~', nil, {}, true, {
                    onSelected = function()
                        local result = null.fct.confirm('Voulez-vous supprimer ce groupe')
                        if result ~= true then return end
                        TriggerServerEvent('null:DeleteGangs', SelectedGang.name)
                        RageUI.GoBack()
                        if TempZoneCreateForEditGang ~= nil then
                            TempZoneCreateForEditGang:destroy()
                        end
                    end
                })
                RageUI.Button('Se téléporter au coffre', nil, {}, true, {
                    onSelected = function()
                        SetEntityCoords(PlayerPedId(), vector3(math.floor(SelectedGang.posCoffre.x), math.floor(SelectedGang.posCoffre.y), math.floor(SelectedGang.posCoffre.z)))
                    end
                })
                RageUI.Line()
                RageUI.Button('Définir la position du coffre', NewCoffrePosition, {}, true, {
                    onSelected = function()
                        NewCoffrePosition = GetEntityCoords(PlayerPedId())
                        SelectedGang.posCoffre.x = NewCoffrePosition.x
                        SelectedGang.posCoffre.y = NewCoffrePosition.y
                        SelectedGang.posCoffre.z = NewCoffrePosition.z
                        PositionChangedCoffre = true
                        TriggerServerEvent('null:UpdateGangs', {name = SelectedGang.name, CoffrePos = NewCoffrePosition, FabPos = NewFabricationPosition, KitArme = KitArmeGang, FabArme = KitArmeFabGang, NBRPoint = NbrPointGang})
                    end
                })
                RageUI.Button('Définir la position Fabrication', NewCoffrePosition, {}, true, {
                    onSelected = function()
                        NewFabricationPosition = GetEntityCoords(PlayerPedId())
                        SelectedGang.posCoffre.x = NewFabricationPosition.x
                        SelectedGang.posCoffre.y = NewFabricationPosition.y
                        SelectedGang.posCoffre.z = NewFabricationPosition.z
                        PositionChangedCoffre = true
                        TriggerServerEvent('null:UpdateGangs', {name = SelectedGang.name, CoffrePos = NewCoffrePosition, FabPos = NewFabricationPosition, KitArme = KitArmeGang, FabArme = KitArmeFabGang, NBRPoint = NbrPointGang})
                    end
                })
                RageUI.Checkbox("Kit d'arme", "Cette option permet au groupe illégal d'acheter des objets et des armes via le coffre", KitArmeGang, {}, {
                    onSelected = function(Index)
                        KitArmeGang = Index
                        TriggerServerEvent('null:UpdateGangs', {name = SelectedGang.name, CoffrePos = NewCoffrePosition, KitArme = KitArmeGang, FabArme = KitArmeFabGang, NBRPoint = NbrPointGang})
                    end
                })
                RageUI.Checkbox("Fabrications Arme", "Cette option permet au groupe illégal de fabriquer des objets et des armes via le coffre", KitArmeFabGang, {}, {
                    onSelected = function(Index)
                        KitArmeFabGang = Index
                        TriggerServerEvent('null:UpdateGangs', {name = SelectedGang.name, CoffrePos = NewCoffrePosition, KitArme = KitArmeGang, FabArme = KitArmeFabGang, NBRPoint = NbrPointGang})
                    end
                })
                RageUI.Button('Ouvrir le coffre du groupe illégal', nil, {}, true, {
                    onSelected = function()
                        RageUI.CloseAll()
                        ESX.TriggerServerCallback('null:getCoffre', function(data, id)
                            if data then
                                local inventory = data
                                inventory.weight = 0
                                inventory.id = id
                                inventory.maxWeight = 1000
                                inventory.type = "SOCIETY"
                                TriggerEvent("inventory:openTarget",inventory)
                            end
                        end, SelectedGang.name, "SOCIETY", 1000)
                    end
                })
                RageUI.Button('Garage du groupe illégal', nil, {}, true, {
                    onSelected = function()
                        ESX.TriggerServerCallback("null:staff:getsocietyVeh", function(result1)
                            SelectedGang.Garage = result1
                        end, SelectedGang.name)
                    end
                }, sub_Server_Factions_List_Select_Garage)
                RageUI.Button('Setjob du groupe illégal', nil, {}, true, {
                    onSelected = function()
                        ExecuteCommand("setjob2 "..myidunique.." "..SelectedGang.name.." 0")
                    end
                })
                RageUI.Line()
                RageUI.Button('~y~Tablette / XP / Missions~s~', "Gérer le niveau, l'XP, les missions et les stats du groupe", {Null = {id = "staff-gangtablet", LoadingOnSelect = 300, description = "Chargement des données tablette."}}, true, {
                    onSelected = function()
                        ESX.TriggerServerCallback('null:staff:getGangTabletData', function(result)
                            staffGangTabletData = result
                        end, SelectedGang.name)
                    end
                }, sub_Server_Factions_List_Select_Tablet)
                --[[RageUI.Button('Confirmer', nil, { Color = { BackgroundColor = {255,244,79, 120} } }, true, {
                    onSelected = function()
                        if not PositionChangedCoffre then
                            NewCoffrePosition = SelectedGang.posCoffre
                        end
                        TriggerServerEvent('null:UpdateGangs', {name = SelectedGang.name, CoffrePos = NewCoffrePosition, KitArme = KitArmeGang, FabArme = KitArmeFabGang, NBRPoint = NbrPointGang})
                        --TriggerServerEvent("null:UpdateGangsPoint", {name=SelectedGang.name,NBRPoint = NbrPointGang})
                        if NbrPointGangSave == NbrPointGang then
                        else
                            GangsList[ESX.PlayerData.job2.name].Point = NbrPointGang
                            TriggerServerEvent("Null:ChangePointGangs", SelectedGang, NbrPointGang)
                        end
                        RageUI.GoBack()
                    end
                })]]
            end
        end)
        
