                        if string.find(v.id, string.lower(Recherche)) or string.find(v.type, string.lower(Recherche)) or string.find(v.Owner, string.lower(Recherche)) then
                            RageUI.Button(v.id.." - "..v.owner.." ("..v.type..")", "Coordonnées : "..json.encode(v.coords), {}, true, {
                                onSelected = function()
                                    SelectedLaboratoire = k
                                end
                            }, sub_Server_Laboratories_list_edit)
                        end
                    else
                        RageUI.Button(v.id.." - "..v.owner.." ("..v.type..")", "Coordonnées : "..json.encode(v.coords), {}, true, {
                            onSelected = function()
                                SelectedLaboratoire = k
                            end
                        }, sub_Server_Laboratories_list_edit)
                    end
                end
            end
        end)
        RageUI.IsVisible(sub_Server_Laboratories_list_edit, function()
            while SelectedLaboratoire == nil do 
                return RageUI.Separator("Chargement en cours..")
            end
            local selectLabo = null.data.illegals.laboratories.list[SelectedLaboratoire]
            RageUI.Separator("ID du laboratoire: ~y~"..selectLabo.id)
            RageUI.Button("Se téléporter sur ce Laboratoire", nil, {}, true, {
                onSelected = function()
                    SetEntityCoords(PlayerState.ped, vec3(selectLabo.coords.x, selectLabo.coords.y, selectLabo.coords.z))
                end
            })
            RageUI.Button("Modifier la position d'entrée", nil, {}, true, {
                onSelected = function()
                    local result = null.fct.confirm("Êtes-vous sûr de vouloir déplacer la position du laboratoire sur vous ?")
                    if result ~= true then return end
                    TriggerServerEvent("null:labo:staff:editPos", selectLabo.id, GetEntityCoords(PlayerPedId()))
                end
            })
            RageUI.Button("Modifier les upgrades", nil, {}, true, {
                --[[onSelected = function()
                    local result = null.fct.confirm("Êtes-vous sûr de vouloir modifier les updates du laboratoire ?")
                    if result ~= true then return end
                    local upgradesList = {}
                    local upgradesList2 = {}
                    for k,v in pairs(Config.laboratoire.upgrades) do
                        if (v.type ~= nil and v.type == selectLabo.type) or v.type == "all" or selectLabo.type == nil then
                            local buyed = false
                            if null.data.illegals.laboratories.list[selectLabo.id].upgrades then
                                buyed = true
                            end
                            if selectLabo.upgrades[k] == nil then
                                table.insert(upgradesList2, {
                                    value = k,
                                    label = v.label.." (Prix: "..v.prices.oneTime.."$)",
                                })
                            else
                                table.insert(upgradesList, {
                                    value = k,
                                    label = v.label.." (Prix: "..v.prices.oneTime.."$)",
                                })
                            end
                        end
                    end
                    local newUpgrades = null.fct.input("Votre choix", true, {
                        {
                            type = "multi-select",
                            label = "à supprimer :",
                            required = true,
                            options = upgradesList,
                        },
                        {
                            type = "multi-select",
                            label = "à ajouter :",
                            required = true,
                            options = upgradesList2,
                        },
                    })
                    if newUpgrades == nil then return end
                    print(json.encode(newUpgrades))
                end]]
                onSelected = function()
                    local result = null.fct.confirm("Êtes-vous sûr de vouloir modifier les updates du laboratoire ?")
                    if result ~= true then return end
                    local upgradesList = {}
                    for k,v in pairs(Config.laboratoire.upgrades) do
                        local buyed = false
                        if null.data.illegals.laboratories.list[selectLabo.id].upgrades and null.data.illegals.laboratories.list[selectLabo.id].upgrades[k] == true then
                            buyed = true
                        end
                        local areValide = false
                        if v.type == "all" or v.type == selectLabo.type then
                            areValide = true
                        end
                        upgradesList[v.index] = {
                            type = "checkbox",
                            value = k,
                            checked = buyed,
                            disabled = not areValide, 
                            label = v.label.." (Prix: "..v.prices.oneTime.."$)",
                        }
                    end
                    local newUpgrades = null.fct.input2("Votre choix", true, upgradesList, false)
                    if newUpgrades == nil then 
                        return 
                    end
                    NewUpgrades = {}
                    for k,v in ipairs(newUpgrades) do 
                        local upgradeData = nil
                        for k2,v2 in pairs(Config.laboratoire.upgrades) do 
                            if v2.index == k then
                                upgradeData = k2
                            end
                        end
                        if upgradeData and v == true  then
                            NewUpgrades[upgradeData] = true
                        end
                    end
                    TriggerServerEvent("null:labo:staff:updateUpgrade", selectLabo.id,NewUpgrades)
                end
            })
            RageUI.Button("Modifier le type", nil, {}, true, {
                onSelected = function()
                    local result = null.fct.confirm("Êtes-vous sûr de vouloir modifier le type du laboratoire ?")
                    if result ~= true then return end
                    local allType = {}
                    for k,v in pairs(Config.laboratoire.type) do
                        table.insert(allType, {
                            value = k,
                            label = v.label.." (Prix: "..v.price.."$)"
                        })
                    end
                    local newType = null.fct.input("Votre choix", true, {
                        {
                            type = "select",
                            label = "Nouveau Type",
                            required = true,
                            options = allType,
                        }
                    })
                    if newType == nil then return end
                    TriggerServerEvent("null:labo:staff:updateType", selectLabo.id,newType)
                end
            })
            RageUI.Button("Supprimer ce Laboratoire", nil, {BackgroundColor = {Color = {255, 0, 0, 120}}}, true, {
                onSelected = function()
                    local result = null.fct.confirm("Êtes-vous sûr de vouloir modifier le type du laboratoire ?")
                    if result ~= true then return end
                    TriggerServerEvent("null:labo:staff:delete", SelectedLaboratoire)
                    SelectedLaboratoire = nil
                    RageUI.GoBack()
                    RageUI.GoBack()
                end
            })
        end)
        RageUI.IsVisible(sub_Server_Streamers, function()
            RageUI.Button("Ajouter un streamer", nil, {}, true, {
                onSelected = function()
                    idunique = null.fct.input("ID Unique du joueur ?")
                    if idunique == nil then return end
                    TriggerServerEvent("null:staff:setStreamer", tonumber(idunique), true)
                    Wait(1000)
                    ESX.TriggerServerCallback("null:getConntectedStreamer", function(result, data) 
                        nTable.StreamerConnected = result
                        nTable.StreamerList = data
                    end)
                end
            }, sub_Server_Streamers)
            RageUI.Button("Rechercher", nil, {}, true, {
                onSelected = function()
                    local input = null.fct.input("Que voulez-vous chercher ?")
                    if not input then return end
                    RechercheStreamer = string.lower(input)
                end
            })
            RageUI.Button("Arreter la rechercher", nil, {}, true, {
                onSelected = function()
                    RechercheStreamer = nil
                end
            })
            RageUI.Line()
            RageUI.Separator("Streamer Connecter")
            for k,v in pairs(nTable.StreamerConnected) do
                if RechercheStreamer ~= nil then
                    if string.find(string.lower(v.name), RechercheStreamer) or string.find(v.idunique, RechercheStreamer) then
                        RageUI.Button(v.name.." (U"..v.idunique..")", nil, {}, true, {
                            onSelected = function()
                                result = null.fct.confirm("Êtes-vous sur de vouloir supprimer ce streamer ?")
                                if result == true then
                                    TriggerServerEvent("null:staff:setStreamer", v.idunique, false)
                                    nTable.StreamerConnected[k] = nil
                                else
                                    return
                                end
                            end
                        })
                    end
                else
                    RageUI.Button(v.name.." (U"..v.idunique..")", nil, {}, true, {
                        onSelected = function()
                            local result = null.fct.confirm("Êtes-vous sûr de vouloir supprimer ce streamer ?")
                            if result ~= true then return end
                    
                            TriggerServerEvent("null:staff:setStreamer", v.idunique, false)
                            nTable.StreamerList[k] = nil -- Suppression locale immédiate
                        end
                    })
                end
            end
            RageUI.Line()
            RageUI.Separator("Streamer Déconnecter")
            for k, v in pairs(nTable.StreamerList) do
                if nTable.StreamerConnected[k] ~= nil then goto continue end
                if RechercheStreamer ~= nil then
                    if string.find(v.name, RechercheStreamer) or string.find(v.idunique, RechercheStreamer) then
                        RageUI.Button(v.name .. " (U" .. v.idunique .. ")", nil, {}, true, {
                            onSelected = function()
                                local result = null.fct.confirm("Êtes-vous sûr de vouloir supprimer ce streamer ?")
                                if result ~= true then return end
                        
                                TriggerServerEvent("null:staff:setStreamer", v.idunique, false)
                                nTable.StreamerList[k] = nil -- Suppression locale immédiate
                            end
                        })                        
                    end
                else
                    RageUI.Button(v.name .. " (U" .. v.idunique .. ")", nil, {}, true, {
                        onSelected = function()
                            local result = null.fct.confirm("Êtes-vous sûr de vouloir supprimer ce streamer ?")
                            if result ~= true then return end
                    
                            TriggerServerEvent("null:staff:setStreamer", v.idunique, false)
                            nTable.StreamerList[k] = nil -- Suppression locale immédiate
                        end
                    })                            
            end            

                ::continue::
            end
        end)
        RageUI.IsVisible(sub_Server_PlayersInFarming, function()
            for k,v in pairs(nTable.PlyInFarm) do
                RageUI.Button(v.name.." (U"..v.idunique.." T"..v.source..")", nil, {}, true, {})
            end
