local AeroEvent = TriggerServerEvent
local FirstSpawn = true
local IsInPersoMenu = false
local CONNECTION_CAMERA = 0;
InCharSelector = true

local finishVerif = false

exports("finishVerif", function()
    finishVerif = true
end)

AddEventHandler('playerSpawned', function()
	Citizen.CreateThread(function()
        while not ESX.PlayerLoaded do Wait(10) end
        while PlayerIsDead == nil do
			Citizen.Wait(10)
        end
        if playerIsDead() then return end
        if FirstSpawn then
            finishVerif = false
            if GetResourceState("detectrppack") == "started" then
                Wait(1000)
                ExecuteCommand("detectrppack")
                while not finishVerif do Wait(100) end
                Wait(1000)
            end

            ClearTimecycleModifier()
            TriggerServerEvent("null:esx:enter", true)
            ClearExtraTimecycleModifier()
            ESX.TriggerServerCallback('Null:esx_skin:getPlayerSkin', function(skin, jobSkin)
                if skin ~= nil then
                    OpenPersoMenu(true)
                    InCharSelector = true
                else
                    OpenPersoMenu(false)
                    InCharSelector = true
                end
            end)
            FirstSpawn = false
        end
	end)
end)

RegisterCommand("debug", function ()
    TriggerScreenblurFadeOut(1000)
    SetNuiFocus(false, false)
    exports["null-core"]:ActiveFrontend(false)
    null.DisplayHud(true)
    pcall(function()
        exports["null-core"]:setChatCanOpen(true)
    end)
    OpenPersoMenu(true)
    SetPlayerControl(PlayerId(), true, 12)
end)

local ScriptClient = {}
ScriptClient.Functions = {}
ScriptClient.PlayerInformations = {
    firstname = "",
    lastname = "",
    sex = "",
    dateOfBirth = "",
    money = 0,
    bank = 0,
    blackMoney = 0
}

function ScriptClient.Functions:GetPlayerInformations()
    return ScriptClient.PlayerInformations
end

function ScriptClient.Functions:FormatInformations(data)
    ScriptClient.PlayerInformations.firstname = data.firstname
    ScriptClient.PlayerInformations.lastname = data.lastname
    ScriptClient.PlayerInformations.sex = data.sex
    ScriptClient.PlayerInformations.dateOfBirth = data.dateOfBirth
    ScriptClient.PlayerInformations.money = data.money
    ScriptClient.PlayerInformations.bank = data.bank
    ScriptClient.PlayerInformations.blackMoney = data.blackMoney

    ScriptClient.PlayerInformations.isexpired = data.isexpired
    ScriptClient.PlayerInformations.vip = data.vip
    ScriptClient.PlayerInformations.expirationmsg = data.expirationmsg
end

local function playerAccount(account)
    ESX.PlayerData = ESX.GetPlayerData()
    for k,v in pairs(ESX.PlayerData.accounts) do
        if v.name == account then
            return v.money..'$'
        end
    end
end

RegisterNetEvent('brx_spawn:OnPlayerConnect', function(data)
    ScriptClient.Functions:FormatInformations(data)
end)

