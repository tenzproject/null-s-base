        RageUI.IsVisible(sub_Server_Weather, function()
            local canTrigger = ActionCooldown("triggerRequestWeatherTimer", 30000, false)
            if canTrigger then TriggerServerEvent("null:weather:requestWeatherTimer") end
            local minutesDisplay = localTime.minutes
            if minutesDisplay < 10 then minutesDisplay = "0"..minutesDisplay end
            local hoursDisplay = localTime.hours
            if hoursDisplay < 10 then hoursDisplay = "0"..hoursDisplay end
            RageUI.Separator("Heure Actuelle: "..ESX.Config("serverColor")..hoursDisplay..":"..minutesDisplay.."~s~ Météo Actuelle: "..ESX.Config("serverColor")..LabelWeather[CurrentWeather])
            if not freezeWeather then
                RageUI.Separator("Prochaine Météo: "..ESX.Config("serverColor")..LabelWeather[NextWeather].."~s~ (dans "..ESX.Config("serverColor")..newWeatherTimer.."~s~ minutes)")
            end
            RageUI.Checkbox("Bloquer l'heure", nil, freezeTime, {}, {
                onChecked = function()
                    freezeTime = true
                    TriggerServerEvent("null:weather:changeFreeze", freezeTime, freezeWeather)
                end,
                onUnChecked = function()
                    freezeTime = false
                    TriggerServerEvent("null:weather:changeFreeze", freezeTime, freezeWeather)
                end
            })
            if Config.Weather.UseRealTime then
                RageUI.Button('Définir l\'heure', nil, {}, freezeTime, {
                    onSelected = function()
                        local input = null.fct.input2("Définir la nouvelle Heure du Serveur", true, {
                            {type = 'number', label = 'Nouvelle Heure', default = localTime.hours, required = true, min = 0, max = 24},
                            {type = 'number', label = 'Nouvelle Minutes', default = localTime.minutes, required = true, min = 0, max = 60},
                        })
                        if input then
                            TriggerServerEvent("null:weather:changeTime", input[1], input[2])
                        end
                    end
                })
            else
                RageUI.Button('Définir l\'heure', nil, {}, true, {
                    onSelected = function()
                        local input = null.fct.input2("Définir la nouvelle Heure du Serveur", true, {
                            {type = 'number', label = 'Nouvelle Heure', default = localTime.hours, required = true, min = 0, max = 24},
                            {type = 'number', label = 'Nouvelle Minutes', default = localTime.minutes, required = true, min = 0, max = 60},
                        })
                        if input then
                            TriggerServerEvent("null:weather:changeTime", input[1], input[2])
                        end
                    end
                })
            end
            RageUI.Checkbox("Animation des lumières", nil, blackoutAnim, {}, {
                onChecked = function()
                    blackoutAnim = true
                    TriggerServerEvent("null:weather:changeBlackOutAnim", blackoutAnim)
                end,
                onUnChecked = function()
                    blackoutAnim = false
                    TriggerServerEvent("null:weather:changeBlackOutAnim", blackoutAnim)
                end
            })
            RageUI.Checkbox("Lumière de la ville", nil, not inBlackout, {}, {
                onChecked = function()
                    inBlackout = not true
                    TriggerServerEvent("null:weather:changeBlackout", inBlackout)
                end,
                onUnChecked = function()
                    inBlackout = not false
                    TriggerServerEvent("null:weather:changeBlackout", inBlackout)
                end
            })
            RageUI.Checkbox("Bloquer la météo", nil, freezeWeather, {}, {
                onChecked = function()
                    freezeWeather = true
                    TriggerServerEvent("null:weather:changeFreeze", freezeTime, freezeWeather, true)
                end,
                onUnChecked = function()
                    freezeWeather = false
                    TriggerServerEvent("null:weather:changeFreeze", freezeTime, freezeWeather, true)
                end
            })
            RageUI.Line()
            for k,v in pairs(LabelWeather) do
                if not freezeWeather then 
                    RageUI.Button(v.." - "..k, "En appuyant vous changerez la prochaine Météo\n\nTips: pour changer la météo actuelle il faut Bloquer la météo.", {}, true, {
                        onSelected = function()
                            TriggerServerEvent("null:weather:changeWeather", k, true)
                        end
                    })
                else
                    RageUI.Button(v.." - "..k, "En appuyant vous changerez la Météo Actuelle\n\nTips: pour changer la prochaine météo il faut Débloquer la météo.", {}, true, {
                        onSelected = function()
                            TriggerServerEvent("null:weather:changeWeather", k)
                        end
                    })
                end
            end
        end)

        RageUI.IsVisible(sub_Server_GunFightZones, function()
            local close = false
            local nbrClose = 0
            local nbrTotalZoneGf = 0
            for k, v in pairs(NullGF.zoneGf) do
                nbrTotalZoneGf = nbrTotalZoneGf + 1
                if not v.isOpen then
                    nbrClose = nbrClose + 1
                end
            end
            if nbrClose == nbrTotalZoneGf then close = true end
            RageUI.Button('Reset Zone Gunfight', nil, {}, true, {
                onSelected = function()
                    local result = null.fct.confirm("Êtes-vous sûr de vouloir reset la zone Gunfight ?")
                    if result then
                        TriggerServerEvent("ZoneGF:admin:resetleader")
                    end
                end
            })
            RageUI.Checkbox("Fermer les zones", "Ceci bloquera l'entrer dans les zones\n⚠️  Les joueurs present dans les zones ne seront pas expulser.", close, {}, {
                onChecked = function()
                    close = true
                    for k, v in pairs(NullGF.zoneGf) do
                        TriggerServerEvent("null:zonegf:close", v.id, false)
                    end
                end,
                onUnChecked = function()
                    close = false
                    for k, v in pairs(NullGF.zoneGf) do
                        TriggerServerEvent("null:zonegf:close", v.id, true)
                    end
                end
            })
            RageUI.Button('Exclure les joueurs en zone', nil, {}, true, {
                onSelected = function()
                    local result = null.fct.confirm("Êtes-vous sûr de vouloir exclure tous les joueurs de la zone ?")
                    if result then
                        TriggerServerEvent("ZoneGF:admin:kickzonegf", "all")
                    end
                end
            })            
            RageUI.Button('Créer une Zone Gunfight', nil, {}, true, {}, sub_Server_GunFightZones_Create)
            RageUI.Button('Gérer les Zones Gunfight', nil, {}, true, {}, sub_Server_GunFightZones_List)
        end)
        
        RageUI.IsVisible(sub_Server_GunFightZones_List, function()
            while not NullGF.isLoad do return RageUI.Separator("Chargement en cours..") end
            for k,v in pairs(NullGF.zoneGf) do
                local final = ""
                if v.isOpen then
                    final = "~g~Ouvert~s~"
                else
                    final = "~r~Fermer~s~"
                end
                RageUI.Button(v.label.." ("..final..")", "\n[E] Se téléporter a la zone\n[Entré] Modifier la zone\n", {RightLabel=v.nbrPlayers.."/"..v.maxPlayers}, true, {
                    onActive = function()
                        if IsControlJustPressed(0, 54) then
                            SetEntityCoords(PlayerPedId(), v.position)
                        end
                    end,
                    onSelected = function()
                        SelectedZoneGF = v
                    end
                }, sub_Server_GunFightZones_List_Select)
            end
        end)
        RageUI.IsVisible(sub_Server_GunFightZones_List_Select, function()
            while SelectedZoneGF == nil do return end
            RageUI.Separator(SelectedZoneGF.label.." ("..SelectedZoneGF.nbrPlayers.."/"..SelectedZoneGF.maxPlayers..")")
            RageUI.Button('Exclure les joueurs', nil, {}, SelectedZoneGF.nbrPlayers ~= 0 and true or false, {
                onSelected = function()
                    TriggerServerEvent("ZoneGF:admin:kickzonegf", "zone", SelectedZoneGF.id)
                end
