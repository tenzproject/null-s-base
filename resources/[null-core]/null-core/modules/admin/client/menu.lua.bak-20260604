                    onSelected = function()
                        local input = null.fct.input("Nom du garage")
                        if input == nil then
                            return ESX.ShowNotification("~r~Le nom du garage ne peut pas être nul")
                        end

                        garageSearch = input
                    end
                })
            else
                RageUI.Button("Réinitialiser la recherche", nil, {}, true, {
                    onSelected = function()
                        garageSearch = nil
                    end
                })
            end

            for k,v in pairs(GarageList) do
                if garageSearch == nil then
                    RageUI.Button(v.name, nil, {}, true, {
                        onSelected = function()
                            local result = null.fct.confirm("Êtes-vous sûr de vouloir supprimer ?")
                            if result then
                                TriggerServerEvent("null:deleteGarage", v.name)
                            end
                        end
                    })                                      
                else
