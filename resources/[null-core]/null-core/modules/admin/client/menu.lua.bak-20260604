                end
            })
            if nTable.PagePlayers[nTable.ActualPage] ~= nil then
                for k,v in pairs(nTable.PagePlayers[nTable.ActualPage]) do
                    if RechercheallPlayersMenu ~= nil then
                        if string.find(v.idunique, RechercheallPlayersMenu) then
                            RageUI.Button(('%s (%s)'):format(v.name, v.idunique), nil, {}, true, {
                                onSelected = function()
                                    nTable.SelectedAllPlayer = v
                                    nTable.SelectedIsCo = false
                                    for w,y in pairs(nPlayer) do
                                        if tonumber(v.idunique) == y.idunique  then
                                            nTable.SelectedIsCo = true
                                            break
                                        end
                                    end
                                end
                            }, allPlayersMenuSelect)
                        end
                    else
                        RageUI.Button(('%s (%s)'):format(v.name, v.idunique), nil, {}, true, {
                            onSelected = function()
                                nTable.SelectedAllPlayer = v
                                nTable.SelectedIsCo = false
                                for w,y in pairs(nPlayer) do
                                    if tonumber(v.idunique) == y.idunique  then
