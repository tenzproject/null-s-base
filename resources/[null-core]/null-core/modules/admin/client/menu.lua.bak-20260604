                            if i == 1 then
                                SetEntityCoords(PlayerPedId(), nTable.SelectedEntreprise.PosBoss.x, nTable.SelectedEntreprise.PosBoss.y, nTable.SelectedEntreprise.PosBoss.z)
                            elseif i == 2 then
                                SetEntityCoords(PlayerPedId(), nTable.SelectedEntreprise.PosVestiaire.x, nTable.SelectedEntreprise.PosVestiaire.y, nTable.SelectedEntreprise.PosVestiaire.z)
