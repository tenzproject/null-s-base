function OpenPersoMenu(value)
    local tryNr = 0
    while GetVIPLoad() == false do
        Wait(1)
        tryNr = tryNr + 1
        if tryNr > 2000 then
            break
        end
    end
    TriggerServerEvent("null:esx:enter", true)
    --[[while GetVIP() == nil do
        Wait(10)
    end
    while not GetVIPLoad() do
        Wait(10)
    end]]
    TriggerServerEvent('brx_spawn:OnPlayerConnect')
    Wait(500)

    IsInPersoMenu = true
    local CAMERA = CAMERA_POSITION[math.random(1,#CAMERA_POSITION)]
    if (CAMERA) then
        if (CONNECTION_CAMERA == 0) then
            CONNECTION_CAMERA = CreateCameraPERSO("DEFAULT_SCRIPTED_CAMERA")
        end
        SetEntityVisible(PlayerPedId(), false)
        SetCamCoord(CONNECTION_CAMERA, CAMERA.coords)
        ShakeCam(CONNECTION_CAMERA, "HAND_SHAKE", 0.3)
        SetCamRot(CONNECTION_CAMERA, CAMERA.rot.x, CAMERA.rot.y, CAMERA.rot.z, 2)
        SetCamActive(CONNECTION_CAMERA, true)
        SetFocusPosAndVel(CAMERA.coords, 0, 0, 0)
        RenderScriptCams(1, 0, 500, false, false)
    end

    DoScreenFadeIn(2000)
    DisplayRadar(false)
    null.DisplayHud(false)
    local isVip = false
    local viptabl = {
        VipTime = {
            d = nil,
            h = nil,
        }
    }

    if GetVIP() then
        isVip = GetVIP()
        viptabl.VipTime.d = PlayerState.vip.time.days
        viptabl.VipTime.h = PlayerState.vip.time.hours
    end 
    AnimpostfxStopAll()
    local menu = RageUI.CreateMenu("", "Bienvenue sur "..ESX.Config("serverName"))
    local preloadstream = RageUI.CreateSubMenu(menu, "", "Bienvenue sur "..ESX.Config("serverName"))
    RageUI.Visible(menu, not RageUI.Visible(menu))
    menu.Closable = false
    local startMenu = LPH_NO_VIRTUALIZE(function()
        while menu do
            print("intoWhile 0 wait")
            Citizen.Wait(0)
            RageUI.IsVisible(menu, function()
                local vipText = ""
                local vipText2 = ""

                if not isVip then
                    --RageUI.Separator("⛔ Votre statut VIP à expiré ⛔")
                    vipText = "⭐ Vous n'avez pas de statut VIP"
                elseif isVip then
                    vipText = "⌛ ~r~Expiration VIP~s~"
                    vipText2 = viptabl.VipTime.d.." jours et "..ESX.Math.Round(viptabl.VipTime.h).." heures."
                end

                if ESX.PlayerData == nil then
                    ESX.PlayerData.lastname = ""
                    ESX.PlayerData.firstname = ""
                    ESX.PlayerData.dateofbirth = ""
                    ESX.PlayerData.sex = ""
                else
                    if ESX.PlayerData.lastname == nil then
                        ESX.PlayerData.lastname = ""
                    end
                    if ESX.PlayerData.firstname == nil then
                        ESX.PlayerData.firstname = ""
                    end
                    if ESX.PlayerData.dateofbirth == nil then
                        ESX.PlayerData.dateofbirth = ""
                    end
                    if ESX.PlayerData.sex == nil then
                        ESX.PlayerData.sex = ""
                    end
                end

                if value then
                    RageUI.Button(''..ESX.PlayerData.firstname.." "..ESX.PlayerData.lastname, nil, {}, true, {
                        onSelected = function()
                    
                            RageUI.Visible(menu, false)
                            DoScreenFadeOut(5000)
                            
                            while not IsScreenFadedOut() do
                                Citizen.Wait(0)
                            end
                            getBaseSkin()
                            if (CONNECTION_CAMERA ~= 0) then
                                DestroyCam(CONNECTION_CAMERA);
                                ClearFocus()
                                RenderScriptCams(false, false, false, 0, 0)
                                CONNECTION_CAMERA = 0
                            end
                            SetEntityVisible(PlayerPedId(), true)
                            DoScreenFadeIn(2000)
                            while not IsScreenFadedIn() do
                                Citizen.Wait(0)
                            end
                            
                            InCharSelector = false

                            Citizen.Wait(2000)
                            
                            TriggerEvent("pma-voice:mutePlayer")
                            DisplayRadar(true)
                            --exports["lc-inventory-v2"]:lockInventory(false)
                            IsInPersoMenu = false
                            Citizen.Wait(200)
                            TriggerServerEvent("null:esx:enter", false)
                            null.DisplayHud(true)
                        end
                    })
                    RageUI.Info(ESX.PlayerData.firstname.." "..ESX.PlayerData.lastname, {
                        'Sexe',
                        'Date de Naissance',
                        'Argent',
                        'Argent Sale',
                        'Argent en Banque',
                        vipText,
                    }, {
                        ESX.PlayerData.sex == "1" and "Femme" or "Homme",
                        ESX.PlayerData.dateofbirth,
                        playerAccount('cash'),
                        playerAccount('dirtycash'),
                        playerAccount('bank'),
                        vipText2,
                    })
                end
                if not value then
                    RageUI.Button('Crée son Personnage', nil, {}, true, {
                        onSelected = function()
                            RageUI.Visible(menu, false)
                            if (CONNECTION_CAMERA ~= 0) then
                                DestroyCam(CONNECTION_CAMERA);
                                ClearFocus()
                                RenderScriptCams(false, false, false, 0, 0)
                                CONNECTION_CAMERA = 0
                            end
                            SetEntityVisible(PlayerPedId(), true)
                            InCharSelector = false
                            --TriggerEvent("pma-voice:mutePlayer")
                            TriggerEvent('null-ui:openCreator', true)
                            --TriggerEvent('brx_spawn:playerSpawned')
                            IsInPersoMenu = false
                        end
                    })

                    RageUI.Info("Bienvenue sur "..ESX.Config("serverColor")..ESX.Config("serverName").."~s~", {
                        "Appuyez sur "..ESX.Config("serverColor").."ENTER~s~ pour créer votre personnage",
                        "",
                        ESX.Config("serverDiscord"),
                    }, {
                        "",
                        "",
                        "",
                    })
                end
            end, function()
            end)
            
            RageUI.IsVisible(preloadstream, function()
                while not IsScreenFadedIn() do
                    Citizen.Wait(0)
                end
                RageUI.Button("Souhaitez-vous Précharger les vêtements ?", nil, {}, true, {
                    onSelected = function()
                        RageUI.CloseAll()
                        TriggerEvent("null:streams:preload:open")
                    end
                })
            end, function()
            end)

            if not RageUI.Visible(menu) and not RageUI.Visible(preloadstream) then
                menu = RMenu:DeleteType('menu', true)
            end
        end
    end)
    startMenu()
end

function CreateCameraPERSO(name)
    local camera = CreateCam(name or "DEFAULT_SCRIPTED_CAMERA")
    while (camera == -1) do
        camera = CreateCam(name or "DEFAULT_SCRIPTED_CAMERA");
        Citizen.Wait(1.0)
    end
    return camera
end


function getBaseSkin()
    ESX.TriggerServerCallback('Null:esx_skin:getPlayerSkin', function(skin, jobSkin)
        local isMale = skin.sex == 0
        TriggerEvent('skinchanger:loadDefaultModel', isMale, function()
            ESX.TriggerServerCallback('Null:esx_skin:getPlayerSkin', function(skin)
                TriggerEvent('Null:skinchanger:loadSkin', skin)
                TriggerEvent('esx:restoreLoadout')
            end)
        end)

    end)
end