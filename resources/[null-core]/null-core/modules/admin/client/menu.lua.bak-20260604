    exports["null-core"]:ActiveFrontend(false)
    ReplaceHudColourWithRgba(117, 0, 0, 0, 186)
end

local function isSafeZoneValid(data)
    if data.pos == nil then
        return false
    end

    if data.name == nil then
        return false
    end

    if data.points == nil then
        return false
    end

    if #data.points < 3 then
        return false
    end
    
    return true
end

local function isTerritoryShopValid(data)
    if data.name == nil then
        return false
    end

    if data.price == nil then
        return false
    end

    if data.points == nil then
        return false
    end

    if data.type == nil then
        return false
    end

    return true
end

