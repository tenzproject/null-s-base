                        RageUI.Button(v.name, nil, {}, true, {
                            onSelected = function()
                                local input = null.fct.input("Êtes-vous sur ? (Y ou N)")
                                if input == nil then
                                    return 
                                end
                                if input ~= "y" and input ~= "Y" then
                                    return
                                end
                                TriggerServerEvent("null:deleteGarage", v.name)
                            end
                        })
                    end
                end
            end
        end)

        
