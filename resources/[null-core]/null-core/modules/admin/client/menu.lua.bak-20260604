        RageUI.IsVisible(sub_Server_Factions_List_Select_Garage, function()
            if SelectedGang.Garage == nil then
                return RageUI.Separator("Chargement du garage")
            end
            RageUI.Button("Attribuer un véhicule", nil, {}, true, {
                onSelected = function()
                    local model = null.fct.input("Model du véhicule ?")
                    local type = null.fct.input("Type du véhicule ? (car, boat, aircraft)")
                    if model == nil or type == nil then return end
                    TriggerServerEvent("Kayce:AddVehToClient", SelectedGang.name, model, nil, type, false, true, true)  
                    Wait(1000)
                    ESX.TriggerServerCallback("null:staff:getsocietyVeh", function(result1)
                        SelectedGang.Garage = result1
                    end, SelectedGang.name)       
                end
            })
            if RechercheNullPlayerGarage == nil then
                RageUI.Button("Rechercher", nil, {}, true, {
                    onSelected = function()
                        local input = null.fct.input("Plaque/Model/Nom du véhicule")
                        if not input then return end
                        RechercheNullPlayerGarage = string.lower(input)
                    end
                })
            else
                RageUI.Button("Arreter la recherche", nil, {}, true, {
                    onSelected = function()
                        RechercheNullPlayerGarage = nil
                    end
                })
            end
            RageUI.Line()
            for k,x in pairs(SelectedGang.Garage) do
                if RechercheNullPlayerGarage ~= nil then
                    if string.find(RechercheNullPlayerGarage, string.lower(x.plate)) or string.find(RechercheNullPlayerGarage, string.lower(x.vehicle.model)) or string.find(RechercheNullPlayerGarage, string.lower(x.label)) then
                        local rightBadgeBoutique = {}
                        boutiquelabel = "Non"
                        if x.state == true then
                            rightBadgeBoutique = {}
                            boutiquelabel = "Oui"
                        end
                        if x.state == nil or x.state == false then
                            rightBadgeBoutique = {}
                            boutiquelabel = "Non"
                        end
                        RageUI.Button('['..GetLabelText(GetDisplayNameFromVehicleModel(x.vehicle.model))..'] - '..x.label.." ("..x.plate..")", "Appuyez sur [ENTRER] pour supprimer le véhicule\n\nPlaque : "..x.plate.."\nFourriere : "..boutiquelabel, rightBadgeBoutique, true, {
                            onSelected = function()
                                TriggerServerEvent("vAdminMenu:deletegaragevh", x.vehicle.model, x.plate)
                                Wait(1000)
                                ESX.TriggerServerCallback("null:staff:getsocietyVeh", function(result1)
                                    SelectedGang.Garage = result1
                                end, SelectedGang.name)   
                            end
                        })
                    end
                else
                    local rightBadgeBoutique = {}
                    boutiquelabel = "Non"
                    if x.state == true then
                        rightBadgeBoutique = {}
                        boutiquelabel = "Oui"
                    end
                    if x.state == nil or x.boutique == false then
                        rightBadgeBoutique = {}
                        boutiquelabel = "Non"
                    end
                    RageUI.Button('['..GetLabelText(GetDisplayNameFromVehicleModel(x.vehicle.model))..'] - '..x.label.." ("..x.plate..")", "Appuyez sur [ENTRER] pour supprimer le véhicule\n\nPlaque : "..x.plate.."\nFourriere : "..boutiquelabel, rightBadgeBoutique, true, {
                        onSelected = function()
                            TriggerServerEvent("vAdminMenu:deletegaragevh", x.vehicle.model, x.plate)
                            Wait(1000)
                            ESX.TriggerServerCallback("null:staff:getsocietyVeh", function(result1)
                                SelectedGang.Garage = result1
                            end, SelectedGang.name)   
                        end
                    })
                end
            end
        end)

        RageUI.IsVisible(sub_Server_Factions_List_Select_Tablet, function()
            if staffGangTabletData == nil then
                return RageUI.Separator("Chargement des données...")
            end
            RageUI.Separator("Groupe : "..staffGangTabletData.label)
            RageUI.Separator("Niveau : "..staffGangTabletData.level.." / "..staffGangTabletData.maxLevel)
            RageUI.Separator("XP : "..staffGangTabletData.xp.." / "..staffGangTabletData.requiredXP)
            RageUI.Separator("Territoires gagnés : "..staffGangTabletData.totalTerritoriesWon)
            RageUI.Line()
            RageUI.Button("Définir le niveau", "Changer le niveau du groupe", {RightLabel = "Niv. "..staffGangTabletData.level}, true, {
                onSelected = function()
                    local input = tonumber(null.fct.input("Nouveau niveau (1-"..staffGangTabletData.maxLevel..")"))
                    if input == nil then return end
                    TriggerServerEvent('null:staff:setGangLevel', SelectedGang.name, input)
                    Wait(500)
                    ESX.TriggerServerCallback('null:staff:getGangTabletData', function(result)
                        staffGangTabletData = result
                    end, SelectedGang.name)
                end
            })
            RageUI.Button("Ajouter de l'XP", "Ajouter de l'expérience au groupe", {}, true, {
                onSelected = function()
                    local input = tonumber(null.fct.input("Quantité d'XP à ajouter"))
                    if input == nil or input <= 0 then return end
                    TriggerServerEvent('null:staff:addGangXP', SelectedGang.name, input)
                    Wait(500)
                    ESX.TriggerServerCallback('null:staff:getGangTabletData', function(result)
                        staffGangTabletData = result
                    end, SelectedGang.name)
                end
            })
            RageUI.Button("~r~Réinitialiser XP & Niveau~s~", "Remet le groupe au niveau 1 avec 0 XP", {}, true, {
                onSelected = function()
                    local result = null.fct.confirm("Voulez-vous réinitialiser l'XP et le niveau ?")
                    if result ~= true then return end
                    TriggerServerEvent('null:staff:resetGangXP', SelectedGang.name)
                    Wait(500)
                    ESX.TriggerServerCallback('null:staff:getGangTabletData', function(result2)
                        staffGangTabletData = result2
                    end, SelectedGang.name)
                end
            })
            RageUI.Line()
            RageUI.Button("~o~Réinitialiser les missions~s~", "Régénère toutes les missions quotidiennes et hebdomadaires", {}, true, {
                onSelected = function()
                    local result = null.fct.confirm("Voulez-vous réinitialiser les missions ?")
                    if result ~= true then return end
                    TriggerServerEvent('null:staff:resetGangMissions', SelectedGang.name)
                    Wait(500)
                    ESX.TriggerServerCallback('null:staff:getGangTabletData', function(result2)
                        staffGangTabletData = result2
                    end, SelectedGang.name)
                end
            })
            RageUI.Line()
            RageUI.Button("Gérer les stats du groupe", "Criminalité, Confiance, Honneur, Morale", {}, true, {
                onSelected = function()
                end
            }, sub_Server_Factions_List_Select_Tablet_Stats)
        end)

        RageUI.IsVisible(sub_Server_Factions_List_Select_Tablet_Stats, function()
            if staffGangTabletData == nil or staffGangTabletData.groupStats == nil then
                return RageUI.Separator("Chargement des données...")
            end
            local stats = staffGangTabletData.groupStats
            for _, statInfo in ipairs({
                {key = "criminalité", label = "Criminalité"},
                {key = "confiance", label = "Confiance"},
                {key = "honneur", label = "Honneur"},
                {key = "morale", label = "Morale"},
            }) do
                local val = stats[statInfo.key] or 0
                RageUI.Button(statInfo.label, "Appuyez pour modifier la valeur (0-100)", {RightLabel = string.format("%.0f%%", val)}, true, {
                    onSelected = function()
                        local input = tonumber(null.fct.input(statInfo.label.." (0-100), actuellement : "..string.format("%.0f", val)))
                        if input == nil then return end
                        TriggerServerEvent('null:staff:setGangStat', SelectedGang.name, statInfo.key, input)
                        Wait(500)
                        ESX.TriggerServerCallback('null:staff:getGangTabletData', function(result)
                            staffGangTabletData = result
                        end, SelectedGang.name)
                    end
                })
            end
        end)

        RageUI.IsVisible(sub_Players_ByUID, function()
            if nTable.hasFoundPlayerByUID then
                RageUI.Button("Dernière recherche", nil, {}, true, {}, sub_Player_ByIdUnique)
            end
            RageUI.Button("Recherche une UID", nil, {}, true, {
                onSelected = function()
                    isonlineidunique = false
                    nTable.hasFoundPlayerByUID = false
                    local playerIdUnique = tonumber(null.fct.input('ID Unique du joueur'))
                    if type(playerIdUnique) == 'number' then 
                        if playerIdUnique ~= nil and playerIdUnique ~= '' then
                            nTable.selectIdUnique = playerIdUnique
                            TriggerServerEvent("Null:staff2:getiduinfo", playerIdUnique)
                            if nPlayer[playerIdUnique] ~= nil then
                                local v = nPlayer[playerIdUnique]
                                isonlineidunique = true
                                nTable.source = v.source
                                nTable.group = v.permission_group
                                if v.permission_group == "fondateur" then
                                    nTable.fonda = true
                                else
                                    nTable.fonda = false
                                end
                                nTable.name = v.name
                                nTable.job = v.job
                                nTable.job2 = v.job2
                                nTable.cash = v.cash
                                nTable.bank = v.bank
                                nTable.black = v.black
                                nTable.idunique = v.idunique
                            end
                            local count = 0
                            while not nTable.hasFoundPlayerByUID do
                                if count > 20 then
                                    break 
                                end
                                Wait(100) 
                                count += 1
                            end
                            if nTable.hasFoundPlayerByUID then
                                --[[ESX.TriggerServerCallback("Null:IsInJail", function(result, result2, result3)
                                    nTable.injail = result
                                    nTable.injailtime = result2
                                    nTable.injailraison = result3
                                end, nil,nTable.playerAsBeenSearchIdUnique)]]
                                RageUI.Visible(sub_Player_ByIdUnique, true)
                            end
                        end
                    else
                        ESX.ShowNotification("Veuillez entrer un nombre")
                    end
                end
            })
            
            RageUI.Button("Recherche une Discord ID", nil, {}, false, {
                onSelected = function()
                    isonlineidunique = false
                    nTable.hasFoundPlayerByUID = false
                    local playerIdUnique = tonumber(null.fct.input("ID Discord du joueur"))
                    if type(playerIdUnique) == 'number' then 
                        if playerIdUnique ~= nil and playerIdUnique ~= '' then
                            nTable.selectIdUnique = playerIdUnique
                            TriggerServerEvent("Null:staff2:getiduinfo", playerIdUnique, "discord")
                            local count = 0
                            while not nTable.hasFoundPlayerByUID do
                                if count > 20 then
                                    break 
                                end
                                Wait(100) 
                                count += 1
                            end
                            if nTable.hasFoundPlayerByUID then
                                --[[ESX.TriggerServerCallback("Null:IsInJail", function(result, result2, result3)
                                    nTable.injail = result
                                    nTable.injailtime = result2
                                    nTable.injailraison = result3
                                end, nil,nTable.playerAsBeenSearchIdUnique)]]
                                RageUI.Visible(sub_Player_ByIdUnique, true)
                            end
                        end
                    else
                        ESX.ShowNotification("Veuillez entrer un nombre")
                    end
                end
            })
        end)
