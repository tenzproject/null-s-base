        RageUI.IsVisible(openSelectedCoffre, function()
            while nTable.CoffreSelected == nil do
                return RageUI.Separator("Chargement en cours.")
            end

            local object = nTable.CoffreSelected.data
            while object == nil do Wait(50) end
            local description = ("Nom : %s\nId : %s\nPropriétaire : %s\nModele : %s\nPosition : (%s, %s, %s)\nRotation : (%s, %s, %s)")
                :format(object.name, object.id, object.owner.name.." ("..object.owner.idunique..")", object.model, ESX.Math.Round(object.pos.x),
                ESX.Math.Round(object.pos.y), ESX.Math.Round(object.pos.z), ESX.Math.Round(object.rotation.x),
                ESX.Math.Round(object.rotation.y), ESX.Math.Round(object.rotation.z))

            RageUI.Button("Ouvrir le coffre", description, {}, true, {
                onSelected = function()
                    RageUI.CloseAll()
                    ESX.TriggerServerCallback('null:getCoffre', function(data2, id)
                        if data2 then
                            local inventory = data2
                            inventory.weight = 0
                            inventory.id = id
                            inventory.maxWeight = object.weight
                            inventory.type = "STASH"
                            TriggerEvent("inventory:openTarget",inventory)
                        end
                    end, object.type.."_"..object.id, "STASH", object.weight)
                end
            })

            RageUI.Button("Se teleporter", description, {}, true, {
                onSelected = function()
                    SetEntityCoords(PlayerState.ped, object.pos.x, object.pos.y, object.pos.z)
                end
            })
            if object.upgrade["cadena"] ~= nil then
                RageUI.Button("Supprimer le cadena", description, {}, true, {
                    onSelected = function()
                        TriggerServerEvent("null:chest:upgrade", {type = "cadena", code = 0, chest = object.id}, "staff")
                        object.upgrade["cadena"] = nil
                    end
                })
            else
                RageUI.Button("Installer un cadena", description, {}, true, {
                    onSelected = function()
                        local Code = null.fct.input2("Veuillez noter le code du cadena", true, {
                            {type = "number", icon = 'fa-solid fa-lock', description = "4 Chiffres, veuillez eviter les 0000, 1234, ...", min = 1111, max = 9999, required = true},
                        }, false)
    
                        TriggerServerEvent("null:chest:upgrade", {type = "cadena", code = Code, chest = object.id}, "staff")
                        object.upgrade["cadena"] = {Code}
                    end
                })
            end

            RageUI.Button("Changer de propriétaire", description, {}, true, {
                onSelected = function()
                    local input = ESX.GetNumberInput("Indiquer un ID Unique")
                    if input == nil then
                        return ESX.ShowNotification("🚨 Vous devez indiquer un nombre")
                    end
                    --TriggerServerEvent('null:props:server:changeOwner', object, input)
                end
            })

            RageUI.Button("Supprimer", description, {}, true, {
                onSelected = function()
                    TriggerServerEvent('Null:chest:delete', "staff", object.id)
                    RageUI.GoBack()
                end
            })
        end)


