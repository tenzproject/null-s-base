        RageUI.IsVisible(sub_Player_ByIdUnique_history_connection, function()
            if not searchInHistoCoDeco then
                RageUI.Button("Rechercher une date", nil, {}, true, {
                    onSelected = function()
                        local recherche = null.fct.input2("Quelle date voulez-vous chercher", true, {
                            {
                                type = 'date', 
                                returnString = true,
                                format = "YYYY/MM/DD",
                                label = "La date pour votre recherche"
                            }
                        })
                        if recherche and recherche[1] and recherche[1] ~= "Invalid Date" then
                            searchInHistoCoDeco = recherche[1]
                        end
                    end
                })
                RageUI.Button("Rechercher entre deux dates", "Peut ne pas fonctionner", {}, true, {
                    onSelected = function()
                        local recherche = null.fct.input2("Quelle date voulez-vous chercher", true, {
                            {
                                type = 'date-range', 
                                returnString = true,
                                format = "YYYY/MM/DD",
                                label = "Les dates pour votre recherche"
                            }
                        })
                        if recherche and recherche[1] and recherche[1] ~= "Invalid Date" then
                            searchInHistoCoDeco = recherche[1]
                        end
                    end
                })
            else
                RageUI.Button("Arreter la recherche", nil, {}, true, {
                    onSelected = function()
                        searchInHistoCoDeco = nil
                    end
                })
            end
            for k,v in ipairs(nTable.historyDecoReco) do
                if searchInHistoCoDeco and type(searchInHistoCoDeco) == "string" then
                    if string.find(searchInHistoCoDeco, v.date:sub(1, 10)) then
                        if v.type == "co" then
                            RageUI.Button("Connection le "..v.date:sub(1, 10).." à "..v.date:sub(13, 16).." heures", "Date : "..v.date:sub(1, 10).."\nHeure : "..v.date:sub(12, 16), {}, true, {
                                onSelected = function()
                                end
                            })
                        elseif v.type == "deco" then
                            RageUI.Button("Déconnection le "..v.date:sub(1, 10).." à "..v.date:sub(13, 16).." heures", "Date : "..v.date:sub(1, 10).."\nHeure : "..v.date:sub(12, 16), {}, true, {
                                onSelected = function()
                                    
                                end
                            })
                        end
                    end
                elseif searchInHistoCoDeco and type(searchInHistoCoDeco) == "table" then
                    local inSpectre = false
                    local day, mouth, year = v.date:sub(9, 11), v.date:sub(6, 7), v.date:sub(1, 4)
                    local day2, mouth2, year2 = searchInHistoCoDeco[1]:sub(9, 11), searchInHistoCoDeco[1]:sub(6, 7), searchInHistoCoDeco[1]:sub(1, 4)
                    local day3, mouth3, year3 = searchInHistoCoDeco[2]:sub(9, 11), searchInHistoCoDeco[2]:sub(6, 7), searchInHistoCoDeco[2]:sub(1, 4)

                    print(searchInHistoCoDeco[1], searchInHistoCoDeco[2])
                    print(day2, mouth2, year2)
                    print(day3, mouth3, year3)
                    print(day, mouth, year)

                    if year >= year2 and year <= year3 then
                        if mouth >= mouth2 and mouth <= mouth3 then
                            if day >= day2 and day <= day3 then
                                inSpectre = true
                            end
                        end
                    end

                    if inSpectre then
                        if v.type == "co" then
                            RageUI.Button("Connection le "..v.date:sub(1, 10).." à "..v.date:sub(13, 16).." heures", "Date : "..v.date:sub(1, 10).."\nHeure : "..v.date:sub(12, 16), {}, true, {
                                onSelected = function()
                                end
                            })
                        elseif v.type == "deco" then
                            RageUI.Button("Déconnection le "..v.date:sub(1, 10).." à "..v.date:sub(13, 16).." heures", "Date : "..v.date:sub(1, 10).."\nHeure : "..v.date:sub(12, 16), {}, true, {
                                onSelected = function()
                                    
                                end
                            })
                        end
                    end
                else
                    if v.type == "co" then
                        RageUI.Button("Connection le "..v.date:sub(1, 10).." à "..v.date:sub(13, 16).." heures", "Date : "..v.date:sub(1, 10).."\nHeure : "..v.date:sub(12, 16), {}, true, {
                            onSelected = function()
                            end
                        })
                    elseif v.type == "deco" then
                        RageUI.Button("Déconnection le "..v.date:sub(1, 10).." à "..v.date:sub(13, 16).." heures", "Date : "..v.date:sub(1, 10).."\nHeure : "..v.date:sub(12, 16), {}, true, {
                            onSelected = function()
                                
                            end
                        })
                    end
                end
            end
        end)

        RageUI.IsVisible(sub_Player_ByIdUnique_give_items, function()
            if nTable.FiltreItem == nil then
                RageUI.Button("Rechercher", nil, {}, true, {
                    onSelected = function()
                        local input = null.fct.input("Nom de l'item a rechercher")
                        if input ~= nil and input ~= "" then
                            nTable.FiltreItem = string.lower(input)
                        end
                    end
                })
            else
                RageUI.Button("Arreter la recherche", nil, {}, true, {
                    onSelected = function()
                        nTable.FiltreItem = nil
                    end
                })
            end
            RageUI.Line()
            for id, items in pairs(nTable.items) do
                local function NullRechercheItem()
                    if nTable.FiltreItem ~= nil then
                        if string.find(items.name, nTable.FiltreItem) or string.find(items.label, nTable.FiltreItem) then
                            RageUI.Button(items.label, nil, {RightLabel = ESX.Config("serverColor").."Donner"}, true, {
                                onSelected = function()
                                    null.fct.inputCb("Nombre d'item à give",function(amount) 
                                        if amount ~= nil then
                                            
                                            TriggerServerEvent("AdminMenu:giveItem", nTable.source, items.name, items.label, tonumber(amount))
                                        else
                                            ESX.ShowNotification("Montant Invalide")
                                        end
                                    end)
                                end
                            })
                        end
                    else
                        RageUI.Button(items.label, nil, {RightLabel = ESX.Config("serverColor").."Donner"}, true, {
                            onSelected = function()
                                null.fct.inputCb("Nombre d'item à give",function(amount) 
                                    if amount ~= nil then
                                        
                                        TriggerServerEvent("AdminMenu:giveItem", nTable.source, items.name, items.label, tonumber(amount))
                                    else
                                        ESX.ShowNotification("Montant Invalide")
                                    end
                                end)
                            end
                        })
                    end
                end
                if (StaffHasPerm("GIVE_ITEM_BOUTIQUE")) then
                    NullRechercheItem()
                else
                    if ESX.ContribItem(items.name) then
                    else
                        NullRechercheItem()
                    end
                end
            end
        end)

        RageUI.IsVisible(sub_Player_ByIdUnique_give_weapons, function()
            if nTable.FiltreItem == nil then
                RageUI.Button("Rechercher", nil, {}, true, {
                    onSelected = function()
                        null.fct.inputCb("Nom de l'arme a rechercher",function(data) 
                            if data ~= nil then
                                nTable.FiltreItem = data
