        RageUI.IsVisible(sub_Player_ByIdUnique_boutique, function()
            if nTable.IdBoutiqueIdU == nil then
                if NotifiedForBoutique ~= nil and not NotifiedForBoutique then
                    NotifiedForBoutique = true
                    ESX.ShowNotification("❌ Cette personne n'a pas lier sont compte CFX.\nSi vous voulez quand même connaitre sont ID Boutique, vérifiez quand il est connecté.")
                end
                RageUI.Separator("Ce joueur n'a pas lier sont compte CFX.")
                return
            end
            RageUI.Separator("ID Boutique: "..ESX.Config("serverColor")..nTable.IdBoutiqueIdU)
            RageUI.Separator("Nombre Coin(s): "..ESX.Config("serverColor")..nTable.boutiquecoinU)
            RageUI.Separator("Total des achats: "..ESX.Config("serverColor")..nTable.boutiquefidU[1].."~s~ coins")
            RageUI.Separator("Progression Fidéliter: "..ESX.Config("serverColor")..nTable.boutiquefidU[2].."/5000")
            RageUI.Button("Ajouter des coins", nil, {RightLabel = ""}, true, {
                onSelected = function()
                    local number = null.fct.input("Nombre à ajouter")
                    if number == nil then return end
                    if type(number) ~= "number" then return end
                    if number <= 0 then return end
                    ESX.ShowNotification("⏱ Ajout en cours..")
                    TriggerServerEvent("null:staff:boutique:addcoins", nTable.IdBoutiqueIdU, number, nTable.selectIdUnique)
                    Wait(1000)
                    ESX.TriggerServerCallback("AdminMenu:getIdUniqueBoutiqueInfo", function(result, result2, result3, result4, result5)
                        if result ~= nil then
                            nTable.historiqueidu = result
                            nTable.packidu = result2 or {}
                            nTable.IdBoutiqueIdU = result3
                            nTable.boutiquecoinU = result4
                            nTable.boutiquefidU = result5
                        else
                            nTable.historiqueidu = {}
                            nTable.IdBoutiqueIdU = nil
                        end
                    end, nTable.selectIdUnique)
                end
            }) 
            RageUI.Button("Ajouter un Pack", nil, {RightLabel = ""}, nTable.packidu ~= nil and #nTable.packidu == 5 and false or true, {
                onSelected = function()
                    local optionlist = {}
                    local ListePack = {
                        ["entreprise"] = {label="Création d'entreprise"},
                        ["gang"] = {label="Création Gang/Orga"},
                        ["deplacement"] = {label="Déplacement Gang/Orga"},
                        ["bunker"] = {label="Bunker Gang/Orga"},
                        ["veh-unique"] = {label="Véhicule au Choix"},
                    }
                    for k,v in pairs(nTable.packidu) do
                        ListePack[k] = nil
                    end
                    for k,v in pairs(ListePack) do
                        table.insert(optionlist, {value=k,label=v.label})
                    end

                    local PackToAdd = null.fct.input("Votre choix", true, {
                        {type = 'select', label = 'Quelle pack voulez vous ajouter',options=optionlist},})
                    if PackToAdd == nil then return end
                    TriggerServerEvent("Null:boutique:staff:addpack", nTable.idunique, PackToAdd, nTable.IdBoutiqueIdU)
                    Wait(1000)
                    ESX.TriggerServerCallback("AdminMenu:getIdUniqueBoutiqueInfo", function(result, result2, result3, result4, result5)
                        if result ~= nil then
                            nTable.historiqueidu = result
                            nTable.packidu = result2 or {}
                            nTable.IdBoutiqueIdU = result3
                            nTable.boutiquecoinU = result4
                            nTable.boutiquefidU = result5
                        else
                            nTable.historiqueidu = {}
                            nTable.IdBoutiqueIdU = nil
                        end
                    end, nTable.selectIdUnique)
                end,
                onActive = function()
                    if nTable.packidu == nil then
                        RageUI.Info("Informations Pack de "..nTable.name, {"Création d'entreprise","Création Gang/Orga","Déplacement Gang/Orga","Bunker Gang/Orga ","Véhicule au Choix"}, {"❌","❌","❌","❌","❌",})
                    else
                        RageUI.Info("Informations Pack de "..nTable.name, {"Création d'entreprise","Création Gang/Orga","Déplacement Gang/Orga","Bunker Gang/Orga ","Véhicule au Choix"}, {
                            nTable.packidu["entreprise"] == true and "✅" or "❌",
                            nTable.packidu["gang"] == true and "✅" or "❌",
                            nTable.packidu["deplacement"] == true and "✅" or "❌",
                            nTable.packidu["bunker"] == true and "✅" or "❌",
                            nTable.packidu["veh-unique"] == true and "✅" or "❌",
                        })
                    end
                end
            }) 
            RageUI.Button("Supprimer un Pack", nil, {RightLabel = ""}, nTable.packidu ~= nil and #nTable.packidu == 0 and false or true, {
                onSelected = function()
                    local optionlist = {}
                    local ListePack = {
                        ["entreprise"] = {label="Création d'entreprise"},
                        ["gang"] = {label="Création Gang/Orga"},
                        ["deplacement"] = {label="Déplacement Gang/Orga"},
                        ["bunker"] = {label="Bunker Gang/Orga"},
                        ["veh-unique"] = {label="Véhicule au Choix"},
                    }

                    for k,v in pairs(nTable.packidu) do
                        table.insert(optionlist, {value=k,label=ListePack[k].label})
                    end

                    local PackToDelete = null.fct.input("Votre choix", true, {
                        {type = 'select', label = 'Quelle pack voulez vous supprimez',options=optionlist},})
                    if PackToDelete == nil then return end
                    TriggerServerEvent("Null:boutique:staff:deletepack", nTable.idunique, PackToDelete)
                    Wait(1000)
                    ESX.TriggerServerCallback("AdminMenu:getIdUniqueBoutiqueInfo", function(result, result2, result3, result4, result5)
                        if result ~= nil then
                            nTable.historiqueidu = result
                            nTable.packidu = result2 or {}
                            nTable.IdBoutiqueIdU = result3
                            nTable.boutiquecoinU = result4
                            nTable.boutiquefidU = result5
                        else
                            nTable.historiqueidu = {}
                            nTable.IdBoutiqueIdU = nil
                        end
                    end, nTable.selectIdUnique)
                end,
                onActive = function()
                    if nTable.packidu == nil then
                        RageUI.Info("Informations Pack de "..nTable.name, {"Création d'entreprise","Création Gang/Orga","Déplacement Gang/Orga","Bunker Gang/Orga ","Véhicule au Choix"}, {"❌","❌","❌","❌","❌",})
                    else
                        RageUI.Info("Informations Pack de "..nTable.name, {"Création d'entreprise","Création Gang/Orga","Déplacement Gang/Orga","Bunker Gang/Orga ","Véhicule au Choix"}, {
                            nTable.packidu["entreprise"] == true and "✅" or "❌",
                            nTable.packidu["gang"] == true and "✅" or "❌",
                            nTable.packidu["deplacement"] == true and "✅" or "❌",
                            nTable.packidu["bunker"] == true and "✅" or "❌",
