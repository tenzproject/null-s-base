            createLaboData = createLaboData or {}
            createLaboData.id = #null.data.illegals.laboratories.list+1
            tempIndexLabo = tempIndexLabo or 1
            RageUI.Separator("ID du laboratoire : ~y~"..#null.data.illegals.laboratories.list+1)
            RageUI.Button("Position de la porte", createLaboData.coords ~= nil and "Défini" or "Pas défini", {}, true, {
                onSelected = function()
                    createLaboData.coords = PlayerState.coords
                end,
                onActive = function()
                    TriggerEvent('SHOW_IMAGE', false)
                end
            })
            RageUI.Button("Heading de sortie", createLaboData.heading ~= nil and "Défini" or "Pas défini", {}, true, {
                onSelected = function()
                    createLaboData.heading = GetEntityHeading(PlayerState.ped)
                end,
                onActive = function()
                    TriggerEvent('SHOW_IMAGE', false)
                end
            })
            inCameraPlacement = inCameraPlacement or false
            RageUI.Button("Placer la camera exterieur", createLaboData.camera ~= nil and "Défini" or "Pas défini", {}, true, {
                onSelected = function()
                    if inCameraPlacement then return end
                    inCameraPlacement = true
                    null.fct.game.placeProps(GetHashKey("prop_cctv_cam_01a"), function(coords, rotation)
                        Wait(500)
                        inCameraPlacement = false
                        if coords and rotation then
                            createLaboData.camera = {
                                coords = coords,
                                rotation = rotation,
                            }
                        else
                            createLaboData.camera = nil
                        end
                    end, function()
                        Wait(500)
                        inCameraPlacement = false
                        createLaboData.camera = nil
                    end)
                end,
                onActive = function()
                    TriggerEvent('SHOW_IMAGE', false)
                end
            })
            inCartonPlacement = inCartonPlacement or false
            RageUI.Button("Placer le colis de récéption", createLaboData.dropbox ~= nil and "Défini" or "Pas défini", {}, true, {
                onSelected = function()
                    if inCartonPlacement then return end
                    inCartonPlacement = true
                    null.fct.game.placeProps(GetHashKey("prop_elecbox_02a"), function(coords, rotation)
                        Wait(500)
                        inCartonPlacement = false
                        if coords and rotation then
                            createLaboData.dropbox = {
                                coords = coords,
                                rotation = rotation,
                            }
                        else
                            createLaboData.dropbox = nil
                        end
                    end, function()
                        Wait(500)
                        inCartonPlacement = false
                        createLaboData.dropbox = nil
                    end)
                end,
                onActive = function()
                    TriggerEvent('SHOW_IMAGE', false)
                end
            })
