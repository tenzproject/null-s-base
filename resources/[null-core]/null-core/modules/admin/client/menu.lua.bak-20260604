        RageUI.IsVisible(sub_Server_World_Vehicles, function()
            RageUI.Checkbox('Trier par le plus proche', nil, worldVehicleDistance, {}, {
                onChecked = function()
                    worldVehicleDistance = true
                end,
                onUnChecked = function()
                    worldVehicleDistance = false
                end
            })

            local currentTime = GetGameTimer()

            if worldVehicleDistance == true then
                if currentTime - lastSortTime > sortInterval then
                    lastSortTime = currentTime

                    sortedVehicles = {}

                    for k, v in pairs(null.data.world.vehicles.list) do
                        v.distance = #(PlayerState.coords - v.pos)
                        v.id = v.id
                        table.insert(sortedVehicles, v)
                    end

                    table.sort(sortedVehicles, function(a, b)
                        return a.distance < b.distance
                    end)
                end

                if sortedVehicles ~= nil then
                    for _, v in ipairs(sortedVehicles) do
                        local vehicleName = GetDisplayNameFromVehicleModel(getValidModel(v.model)) or v.model

                        if v.index == nil then
                            v.index = 1
                        end

                        RageUI.List(("%s (%sM)"):format(vehicleName, math.round(#(PlayerState.coords - v.pos))),
                            { "Se teleporter", "Changer la couleur", "Supprimer" }, v.index, nil,
                            { LeftBadge = RageUI.BadgeStyle.Medal, BadgeArgs = { BadgeColour = { R = v.color[1], G = v.color[2], B = v.color[3] } } },
                            true, {
                                onListChange = function(Index)
                                    v.index = Index
                                end,

                                onSelected = function(Index)
                                    if Index == 1 then
                                        SetEntityCoords(PlayerState.ped, v.pos)
                                    elseif Index == 2 then
                                        local input = lib.inputDialog(
                                            title,
                                            {
                                                { type = "color", label = "Couleur du véhicule", format = 'hex', default = "#ffffff" }
                                            },
                                            { allowCancel = true }
                                        )

                                        if input ~= nil and input[1] ~= nil then
                                            TriggerServerEvent('worldvehicle:server:changeColor', v.id, input[1])
                                        end
                                    else
                                        TriggerServerEvent('worldvehicle:server:remove', v.id)
                                    end
                                end
                            })
                    end
                end
            else
                for k, v in pairs(null.data.world.vehicles.list) do
                    local vehicleName = GetDisplayNameFromVehicleModel(getValidModel(v.model)) or v.model

                    if v.index == nil then
                        v.index = 1
                    end

                    RageUI.List(("%s (%sM)"):format(vehicleName, math.round(#(PlayerState.coords - v.pos))),
                        { "Se teleporter", "Changer la couleur", "Supprimer" }, v.index, nil,
                        { LeftBadge = RageUI.BadgeStyle.Medal, BadgeArgs = { BadgeColour = { R = v.color[1], G = v.color[2], B = v.color[3] } } },
                        true, {
                            onListChange = function(Index)
                                v.index = Index
                            end,

                            onSelected = function(Index)
                                if Index == 1 then
                                    SetEntityCoords(PlayerState.ped, v.pos)
                                elseif Index == 2 then
                                    local input = lib.inputDialog(
                                        title,
                                        {
                                            { type = "color", label = "Couleur du véhicule", format = 'hex', default = "#ffffff" }
                                        },
                                        { allowCancel = true }
                                    )

                                    if input ~= nil and input[1] ~= nil then
                                        TriggerServerEvent('worldvehicle:server:changeColor', k, input[1])
                                    end
                                else
                                    TriggerServerEvent('worldvehicle:server:remove', k)
                                end
                            end
                        })
                end
            end
        end)
        
        RageUI.IsVisible(sub_Server_World_Vehicles_Create, function()
            if worldVehicle['vehicle'] ~= nil and DoesEntityExist(worldVehicle['vehicle']) then
                local entity = worldVehicle['vehicle']
                local position = GetCoordsFromGamePlayCameraPointAtSynced(PlayerState.ped)
                local heading = GetEntityHeading(entity)

                EnableControlAction(0, 14, true)
                if IsControlPressed(0, 14) then
                    heading += 4.5
                end

                EnableControlAction(0, 15, true)
                if IsControlPressed(0, 15) then
                    heading -= 4
                end

                if placeEntityProperlyOnTheGround then
                    SetVehicleOnGroundProperly(previewProp)
                end

                if IsControlJustPressed(0, 22) then -- SPACE
                    placeEntityProperlyOnTheGround = not placeEntityProperlyOnTheGround
                end

                if IsMaterialAtCoordsIsWater(vec3(position.x, position.y, position.z)) then
                    ground, newZ = GetWaterHeightNoWaves(position.x, position.y, position.z)
                else
                    ground, newZ = GetGroundZFor_3dCoord(position.x, position.y, position.z + 0.5)
                end

                if ground then
                    local newPosition = vector3(position.x, position.y, newZ)
                    SetEntityCoords(entity, newPosition)
                    SetEntityHeading(entity, heading)
                end
            end

            RageUI.Button("Modèle du véhicule", false, {}, true, {
                onSelected = function()
                    local input = null.fct.input("Modèle du véhicule")
            
                    if input and input ~= "" then
                        local model = input
            
                        if DoesEntityExist(worldVehicle['vehicle']) then
                            DeleteEntity(worldVehicle['vehicle'])
                        end
            
                        worldVehicle['model'] = model
                        worldVehicle['vehicle'] = handlePreviewEventEntity(model, 'vehicle')
            
                        if worldVehicle['colorRgb'] then
                            SetVehicleCustomPrimaryColour(worldVehicle['vehicle'], worldVehicle['colorRgb'][1], worldVehicle['colorRgb'][2], worldVehicle['colorRgb'][3])
                            SetVehicleCustomSecondaryColour(worldVehicle['vehicle'], worldVehicle['colorRgb'][1], worldVehicle['colorRgb'][2], worldVehicle['colorRgb'][3])
                        end
                    end
                end
            })            

            RageUI.Button("Couleur du véhicule", false, {}, true, {
                onSelected = function()
                    local input = lib.inputDialog(
                        title,
                        {
                            { type = "color", label = "Couleur du véhicule", format = 'hex', default = "#ffffff" }
                        },
                        { allowCancel = true }
                    )

                    if input[1] ~= nil then
                        local r, g, b = hexToRGB(input[1])

                        worldVehicle['color'] = input[1]
                        worldVehicle['colorRgb'] = { r, g, b }
                        if worldVehicle['vehicle'] and DoesEntityExist(worldVehicle['vehicle']) then
                            SetVehicleCustomPrimaryColour(worldVehicle['vehicle'], r, g, b)
                            SetVehicleCustomSecondaryColour(worldVehicle['vehicle'], r, g, b)
                        end
                    end
                end
            })

            if worldVehicle ~= nil and worldVehicle.vehicle ~= nil and DoesEntityExist(worldVehicle['vehicle']) then
                RageUI.Button("Créer le véhicule", false, {}, true, {
                    onSelected = function()
                        local pos = GetEntityCoords(worldVehicle['vehicle'])
                        local rotation = GetEntityRotation(worldVehicle['vehicle'])
                        local color = worldVehicle['color'] or "#ffffff"
                        local model = GetEntityModel(worldVehicle['vehicle'])
                        TriggerServerEvent('worldvehicle:server:add', model, pos, rotation, color)
                        RageUI.GoBack()
                    end
                })
            end
        end)

        RageUI.IsVisible(sub_Settings_Other_CreateItem, function()
            if nTable.createdItem == nil then 
                nTable.createdItem = {}
                nTable.createdItem.utilisable = false
                nTable.createdItem.index = 1
                nTable.createdItem.weight = 1
                nTable.createdItem.number = 0
            end
            if nTable.createdItem.index == nil then nTable.createdItem.index = 0 end
            if nTable.createdItem.weight == nil then nTable.createdItem.weight = 0 end
            if nTable.createdItem.number == nil then nTable.createdItem.number = 0 end
            if nTable.createdItem.utilisable == nil then nTable.createdItem.utilisable = false end
            RageUI.Button('Nom de l\'item', nil, {RightLabel = nTable.createdItem.name == nil and nil or nTable.createdItem.name}, true, {
                onSelected = function()
                    local input = null.fct.input("Nom de l'item (Ni majuscule ni Espace)")
                    nTable.createdItem.name = input
                end
            })
            RageUI.Button('Label de l\'item', nil, {RightLabel = nTable.createdItem.label == nil and nil or nTable.createdItem.label}, true, {
                onSelected = function()
                    local input = null.fct.input("Label de l'item")
                    nTable.createdItem.label = input
                end
            })
            RageUI.Button('Poids de l\'item', nil, {RightLabel = nTable.createdItem.weight == nil and nil or nTable.createdItem.weight}, true, {
                onSelected = function()
                    nTable.createdItem.weight = tonumber(null.fct.input("Poid de l'item"))
                end
            })
            RageUI.Checkbox('Objet utilisable ?', false, nTable.createdItem.utilisable, {}, {
                onChecked = function()
                    nTable.createdItem.utilisable = true
                end,
                onUnChecked = function()
                    nTable.createdItem.utilisable = false
                end
            })
            if nTable.createdItem.utilisable then
                sub_Settings_Other_CreateItem.EnableMouse = true
                RageUI.Line()
                RageUI.List("Type : ", {"Manger","Boire","Drogue","Alcool","Medical","Armure"}, nTable.createdItem.index , nil, {}, true, {
                    onListChange = function(Index)
                        nTable.createdItem.index = Index
                        if Index == 1 then
                            nTable.createdItem.type = "hunger"
                        elseif Index == 2 then
                            nTable.createdItem.type = "thirst"
                        elseif Index == 3 then
                            nTable.createdItem.type = "drug"
                        elseif Index == 4 then
                            nTable.createdItem.type = "drunk"
                        elseif Index == 5 then
                            nTable.createdItem.type = "heal"
                        elseif Index == 6 then
                            nTable.createdItem.type = "armor"
                        end
                    end,
                    onSelected = function(Index)
                        if Index == 1 then
                            nTable.createdItem.type = "hunger"
                        elseif Index == 2 then
                            nTable.createdItem.type = "thirst"
                        elseif Index == 3 then
                            nTable.createdItem.type = "drug"
                        elseif Index == 4 then
                            nTable.createdItem.type = "drunk"
                        elseif Index == 5 then
                            nTable.createdItem.type = "heal"
                        elseif Index == 6 then
                            nTable.createdItem.type = "armor"
                        end
                    end
                })
                RageUI.PercentagePanel(nTable.createdItem.number, 'Pourcentage : ', '0%', '100%', {
                    onProgressChange = function(Percentage)
                        nTable.createdItem.number = Percentage
                    end
                }, 5) 
                RageUI.Line()

                -- ===== Qualité nutritionnelle (Métabolisme) =====
                local mtType = nTable.createdItem.type
                if mtType == "hunger" or mtType == "thirst" or mtType == "drunk" then
                    if nTable.createdItem.metabolism == nil then
                        local defQ = { hunger = "junk", thirst = "drink", drunk = "alcohol" }
                        nTable.createdItem.metabolism = { quality = defQ[mtType] or "junk" }
                    end
                    if not nTable.createdItem.metabolismCatIdx then
                        local qList = { "junk", "meal", "gourmet", "drink", "soda", "alcohol" }
                        nTable.createdItem.metabolismCatIdx = 1
                        for i, q in ipairs(qList) do
                            if q == (nTable.createdItem.metabolism.quality or "junk") then
                                nTable.createdItem.metabolismCatIdx = i; break
                            end
                        end
                    end
                    local m = nTable.createdItem.metabolism
                    local qList   = { "junk", "meal", "gourmet", "drink", "soda", "alcohol" }
                    local qLabels = {
                        junk    = "Junk Food (supérette)",
                        meal    = "Plat équilibré (restaurant)",
                        gourmet = "Gastronomie (haut de gamme)",
                        drink   = "Boisson (eau / jus)",
                        soda    = "Soda",
                        alcohol = "Alcool",
                    }
                    local qDisplay = {}
                    for _, q in ipairs(qList) do table.insert(qDisplay, qLabels[q]) end
                    RageUI.Separator("Qualité nutritionnelle")
                    RageUI.List("Qualité", qDisplay, nTable.createdItem.metabolismCatIdx,
                        "Détermine l'impact sur la forme du joueur.", {}, true, {
                        onListChange = function(Index)
                            nTable.createdItem.metabolismCatIdx = Index
                            m.quality = qList[Index]
                        end,
                    })
                    RageUI.Line()
                end
            else
                sub_Settings_Other_CreateItem.EnableMouse = false
            end
            RageUI.Button('Créer l\'item', nil, { Color = { BackgroundColor = {255,244,79, 120} } }, UsableItemIsValid(nTable.createdItem), {
                onSelected = function()
                    if nTable.createdItem.utilisable then
                        TriggerServerEvent("null:usableitem:new", nTable.createdItem)
                    end
                    TriggerServerEvent("null:item:new", nTable.createdItem)
                    RageUI.GoBack()
                end
            })
        end)

