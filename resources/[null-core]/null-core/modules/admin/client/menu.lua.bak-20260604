        RageUI.IsVisible(sub_Player_ByIdUnique_garage, function()
            if nTable.SelectedPlayers.Garage == nil then
                return RageUI.Separator("Chargement du garage")
            end
            RageUI.List("Filtre(s) :", {'Aucun','Entreprise','Gang/Organisation','Boutique'}, nTable.List, nil, {}, true, {
                onListChange = function(Index)
                    nTable.List = Index;
                end
            })
            if RechercheNullPlayerGarage == nil then
                RageUI.Button("Rechercher", nil, {}, true, {
                    onSelected = function()
                        local input = null.fct.input("Plaque/Model/Nom du véhicule")
                        if not input then return end
                        RechercheNullPlayerGarage = string.lower(input)
                    end
                })
            else
                RageUI.Button("Arreter la recherche", nil, {}, true, {
                    onSelected = function()
                        RechercheNullPlayerGarage = nil
                    end
                })
            end
            if nTable.List == 1 then
                for k,v in pairs(nTable.SelectedPlayers.Garage) do
                    for i,x in pairs(v) do
                        if RechercheNullPlayerGarage ~= nil then
                            if string.find(RechercheNullPlayerGarage, string.lower(x.plate)) or string.find(RechercheNullPlayerGarage, string.lower(x.vehicle.model)) or string.find(RechercheNullPlayerGarage, string.lower(x.label)) then
                                local rightBadgeBoutique = {}
                                boutiquelabel = "Non"
                                if x.boutique == true then
                                    rightBadgeBoutique = {RightBadge = RageUI.BadgeStyle.Star}
                                    boutiquelabel = "Oui"
                                end
                                if x.boutique == nil or x.boutique == false then
                                    rightBadgeBoutique = {}
                                    boutiquelabel = "Non"
                                end
                                RageUI.Button('['..GetLabelText(GetDisplayNameFromVehicleModel(x.vehicle.model))..'] - '..x.label.." ("..x.plate..")", "Plaque : "..x.plate.."\nBoutique : "..boutiquelabel, rightBadgeBoutique, true, {
                                    onSelected = function()
                                        local result = null.fct.confirm("Êtes-vous sur ?")
                                        if result ~= true then return end
                                        TriggerServerEvent("null:staff:deleteownedveh:plate", x.plate)
                                        nTable.SelectedPlayers.Garage[k][i] = nil
                                    end
                                })
                            end
                        else
                            local rightBadgeBoutique = {}
