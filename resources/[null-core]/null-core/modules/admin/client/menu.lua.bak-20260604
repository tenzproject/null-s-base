        RageUI.IsVisible(sub_Settings_Vehicle, function()
            RageUI.Button("Supprimer le véhicule", nil, {}, true, {
                onActive = function ()
                    ClosetVehWithDisplay()
                end,
                onSelected = function()
                    local veh, dist = ESX.Game.GetClosestVehicle()
                    if dist < 10 then
                        ESX.Game.DeleteVehicle(veh)
                       -- DeleteEntity(veh)
                    end
                end
            })
            RageUI.Button('Supprimer véhicule (zone)', nil, {}, true, {
                onSelected = function()
                    local input = tonumber(null.fct.input("Indiquer la zone (10-100)"))
                    if not input then
                        return ESX.ShowNotification("🚨 Vous devez indiquer un nombre")
                    end
            
                    if input < 10 or input > 100 then
                        return ESX.ShowNotification("~r~La zone doit être entre 10 et 100")
                    end
            
                    local vehicles = ESX.Game.GetVehiclesInArea(PlayerState.coords, input)
            
                    for _, vehicle in ipairs(vehicles) do
                        if DoesEntityExist(vehicle) and NetworkHasControlOfEntity(vehicle) then
                            ESX.Game.DeleteVehicle(vehicle)
                            DeleteEntity(vehicle)
                        end
                    end
                end
            })
            
            RageUI.Button('Réparer le véhicule (zone)', nil, {}, true, {
                onSelected = function()
                    local input = tonumber(null.fct.input("Indiquer la zone (10-100)"))
                    if not input then
                        return ESX.ShowNotification("🚨 Vous devez indiquer un nombre")
                    end
            
                    if input < 10 or input > 100 then
                        return ESX.ShowNotification("~r~La zone doit être entre 10 et 100")
                    end
            
                    local vehicles = ESX.Game.GetVehiclesInArea(PlayerState.coords, input)
            
                    for _, v in pairs(vehicles) do
                        SetVehicleFixed(v)
                        SetVehicleDeformationFixed(v)
                        SetVehicleDirtLevel(v, 0.0)
                        SetVehicleEngineHealth(v, 1000.0)
                    end
            
                    ESX.ShowNotification(('Vous avez réparé ~b~%s~s~ véhicule(s)'):format(#vehicles))
                end
            })            
                RageUI.Button('Réparer le véhicule', nil, {}, true, {
                    onActive = function()
                        ClosetVehWithDisplay()
                    end,
                    onSelected = function()
                        local veh = ESX.Game.GetClosestVehicle(PlayerState.coords)
                        if not (veh) then
                            ESX.ShowNotification('🚨 Aucun véhicule au alentours')
                        else
                            SetVehicleFixed(veh)
                            SetVehicleDeformationFixed(veh)
                            SetVehicleDirtLevel(veh, 0.0)
                            SetVehicleEngineHealth(veh, 1000.0)
                        end
                    end
                })
                RageUI.Button("Nettoyer le véhicule", nil, {}, true, {
                    onActive = function()
                        ClosetVehWithDisplay()
                    end,
                    onSelected = function()
                        local veh = ESX.Game.GetClosestVehicle(PlayerState.coords)
                        if not (veh) then
                            ESX.ShowNotification('🚨 Aucun véhicule au alentours')
                        else
                            SetVehicleDirtLevel(veh, 0.0)
                        end
                    end
                })
                --[[RageUI.Button('Freeze/Unfreeze le véhicule', nil, {}, true, {
                    onActive = function()
                        ClosetVehWithDisplay()
                    end,
                    onSelected = function()
                        local veh = ESX.Game.GetClosestVehicle(PlayerState.coords)
                        if not (veh) then
                            ESX.ShowNotification('🚨 Aucun véhicule au alentours')
                        else
                            TriggerServerEvent('null:admin:freezeVehicle', NetworkGetNetworkIdFromEntity(veh))
                        end
                    end
                })]]
                RageUI.Button('Retourner le véhicule', nil, {}, true, {
                    onActive = function()
                        ClosetVehWithDisplay()
                    end,
                    onSelected = function()
                        local veh = ESX.Game.GetClosestVehicle(PlayerState.coords)
                        if not (veh) then
                            ESX.ShowNotification('🚨 Aucun véhicule au alentours')
                        else
                            SetEntityCoords(veh, GetEntityCoords(veh))
                        end
                    end
                })
        end)
        RageUI.IsVisible(sub_Settings_Other, function()
            RageUI.Button('Message de Zone', nil, {}, true, {
                onSelected = function()
                    local input = tonumber(null.fct.input("Indiquer la zone (10-100)"))
                    if not input then
                        return ESX.ShowNotification("🚨 Vous devez indiquer un nombre")
                    end
            
                    if input < 10 or input > 100 then
                        return ESX.ShowNotification("~r~La zone doit être entre 10 et 100")
                    end
            
                    local input2 = null.fct.input("Indiquer le message")
                    if not input2 or input2 == "" then
                        return ESX.ShowNotification("~r~Le message ne peut pas être nul")
                    end
            
                    local players = ESX.Game.GetPlayersServerIdsInArea(PlayerState.coords, input)
            
                    Citizen.CreateThread(function()
                        Citizen.Wait(500)
                        for _, v in pairs(players) do
                            TriggerServerEvent("null:staff:messageplayer", v, input2)
                        end
                    end)
                end
            })
            
            RageUI.Button('Heal de Zone', nil, {}, true, {
                onSelected = function()
                    local input = tonumber(null.fct.input("Indiquer la zone (10-100)"))
                    if not input then
                        return ESX.ShowNotification("🚨 Vous devez indiquer un nombre")
                    end
            
                    if input < 10 or input > 100 then
                        return ESX.ShowNotification("~r~La zone doit être entre 10 et 100")
                    end
            
                    ExecuteCommand("healall "..input)
                end
            })
            
            RageUI.Button("Revive de zone", nil, {}, true, {
                onSelected = function()
                    local input = tonumber(null.fct.input("Indiquer la zone (10-100)"))
                    if not input then
                        return ESX.ShowNotification("🚨 Vous devez indiquer un nombre")
                    end
            
                    if input < 10 or input > 100 then
                        return ESX.ShowNotification("~r~La zone doit être entre 10 et 100")
                    end
            
                    ExecuteCommand("reviver "..input)
                end
            })
            
            RageUI.Button("Limité physiquement de zone", nil, {}, true, {
                onSelected = function()
                    local radius = tonumber(null.fct.input("Nombre de mètres"))
                    local time = tonumber(null.fct.input("Temps de la limite physique"))
                    if radius and time then
                        local plyinzone = ESX.Game.GetClosestPlayerInRadius(GetEntityCoords(PlayerPedId()), radius)
            
                        for _, v in pairs(plyinzone) do
                            TriggerServerEvent("ata:server:staff:updateNoCane", v.id, time)
                        end
                    else
                        ESX.ShowNotification("🚨 Veuillez entrer des valeurs valides !")
                    end
                end
            })
            
            RageUI.Button('Faire apparaître un véhicule', nil, {}, true, {
                onSelected = function()
                    local input = null.fct.input("Indiquer le nom du véhicule")
                    if not input or input == "" then
                        return ESX.ShowNotification("~r~Le nom ne peut pas être nul")
                    end
            
                    local model = GetHashKey(input)
                    if not IsModelValid(model) then
                        return ESX.ShowNotification("🚨 Ce modèle n'existe pas")
                    end
            
                    ExecuteCommand(("car %s"):format(input))
                end
            })
            
            RageUI.Button('Faire apparaître un véhicule sur un joueur', nil, {}, true, {
                onSelected = function()
                    local input = null.fct.input("Indiquer le nom du véhicule")
