        RageUI.IsVisible(sub_Server_Companies_Selected_Crafts_Create, function()
            RageUI.Button('Nom de l\'item', nil, {RightLabel = nTable.CreateRestaurantCraftsItemname}, true, {
                onSelected = function() 
                    nTable.CreateRestaurantCraftsItemname = null.fct.input("Nom de l'item")
                end
            })
            RageUI.Button('Label de l\'item', nil, {RightLabel = nTable.CreateRestaurantCraftsItemlabel}, true, {
                onSelected = function() 
                    nTable.CreateRestaurantCraftsItemlabel = null.fct.input("Label de l'item")
                end
            })
            RageUI.Button('Temps de craft', nil, {RightLabel = nTable.CreateRestaurantCraftsItemTime}, true, {
                onSelected = function() 
                    nTable.CreateRestaurantCraftsItemTime = tonumber(null.fct.input("Temps de craft en seconde"))
                end
            })
            RageUI.Button('Catégorie (borne)', "Groupe d'affichage dans la borne de commande (ex: Burgers, Boissons, Desserts...)",
                { RightLabel = nTable.CreateRestaurantCraftsItemCategory or "Menu" }, true, {
                onSelected = function()
                    local input = null.fct.input("Catégorie de l'item")
                    if input and input ~= "" then
                        nTable.CreateRestaurantCraftsItemCategory = input
                    end
                end
            })
            RageUI.Button('Prix de vente', "Prix facturé au client à la borne.",
                { RightLabel = "$"..tostring(nTable.CreateRestaurantCraftsItemSellPrice or 20) }, true, {
                onSelected = function()
                    local n = tonumber(null.fct.input("Prix de vente en $"))
                    if n and n >= 0 then
                        nTable.CreateRestaurantCraftsItemSellPrice = n
                    end
                end
            })
            RageUI.Checkbox('Commandable à la borne', "Décoche pour un craft interne uniquement (non visible par les clients).",
                nTable.CreateRestaurantCraftsItemOrderable == true, {}, {
                onChecked = function() nTable.CreateRestaurantCraftsItemOrderable = true end,
                onUnChecked = function() nTable.CreateRestaurantCraftsItemOrderable = false end,
            })
            RageUI.Button('Items require', nil, {}, true, {
                onSelected = function() 
                    local optionlist = {}
                    for k,v in pairs(nTable.RestaurantItemCanAdd) do
                        table.insert(optionlist, {value=v.name,label=v.name.." - "..v.label, label2 = v.label})
                    end
                    nTable.CreateRestaurantCraftsRequirmements = {}
                    local result2 = null.fct.input("Votre choix", true, {
                        {type = 'multi-select', label = 'Qu\'elles items sont require pour votre craft',options=optionlist, searchable = true},})
                    if result2 == nil then return end
                    for k,v in pairs(result2) do
                        local Label = v
                        for x,y in pairs(optionlist) do
                            if y.value == v then
                                Label = y.label2
                                break
                            end
                        end
                        table.insert(nTable.CreateRestaurantCraftsRequirmements, {
                            Label = Label,
                            ItemName = v,
                            Icon = "../../assets/img/foodjobs/"..v..".webp",
                            Amount = tonumber(null.fct.input("Nombre de "..Label.." require")),
                        })
                    end
                end
            })

            RenderRestaurantCraftMetabolism()

            RageUI.Button('Confirmer l\'ajout', nil, {}, true, {
                onSelected = function() 
                    EnsureCraftMetabolism()
                    nTable.CreateRestaurantCrafts[nTable.CreateRestaurantCraftsItemname] = {
                        Item = nTable.CreateRestaurantCraftsItemname,
                        Label = nTable.CreateRestaurantCraftsItemlabel,
                        Description = nTable.CreateRestaurantCraftsItemlabel,
                        Category = nTable.CreateRestaurantCraftsItemCategory or "Menu",
                        Icon = "../../assets/img/foodjobs/"..nTable.CreateRestaurantCraftsItemname..".webp",
                        Time = nTable.CreateRestaurantCraftsItemTime,
                        SellPrice = nTable.CreateRestaurantCraftsItemSellPrice or 20,
                        Orderable = nTable.CreateRestaurantCraftsItemOrderable ~= false,
                        Requirements = nTable.CreateRestaurantCraftsRequirmements,
                        Metabolism = nTable.CreateRestaurantCraftsMetabolism,
                    }
                    table.insert(nTable.RestaurantItemCanAdd, {name = nTable.CreateRestaurantCraftsItemname,label = nTable.CreateRestaurantCraftsItemlabel})
                    TriggerServerEvent('null:editRestaurant', nTable.SelectedEntreprise.name, nTable.CreateRestaurantCrafts)
                    RageUI.GoBack()
                end
            })
        end)

