RegisterKeyMapping("openAdmin", "Ouvrir le menu d'Administration", "keyboard", "F9")
RegisterCommand("openAdmin", function()
    if ESX.PlayerData.group ~= "user" then
        MenuAdmin(Config.GroupeGrade[mygroup], mygroup)
    end
end, false)


RegisterKeyMapping("tpMarket", "TP Marker (Staff)", "keyboard", Config.Admin.Controls.tpMarker)
RegisterCommand("tpMarket", function()
    if ESX.PlayerData.group ~= "user" then
        if nTable.staffMode then
            local plyPed = PlayerPedId()
            local waypointHandle = GetFirstBlipInfoId(8)
    
            if DoesBlipExist(waypointHandle) then
                CreateThread(function()
                    local waypointCoords = GetBlipInfoIdCoord(waypointHandle)
                    local foundGround, zCoords, zPos = false, -500.0, 0.0
    
                    while not foundGround do
                        zCoords = zCoords + 10.0
                        RequestCollisionAtCoord(waypointCoords.x, waypointCoords.y, zCoords)
                        Wait(0)
                        foundGround, zPos = GetGroundZFor_3dCoord(waypointCoords.x, waypointCoords.y, zCoords)
    
                        if not foundGround and zCoords >= 2000.0 then
                            foundGround = true
                        end
                    end
    
                    SetPedCoordsKeepVehicle(plyPed, waypointCoords.x, waypointCoords.y, zPos)
                    ESX.ShowNotification('~g~Vous avez été téléporté avec succès !')
                end)
            else
                ESX.ShowNotification(ESX.Config("serverColor")..'Aucun~s~ marqueur n\'a été placé')
            end
        end
    end
end, false)


RegisterNetEvent("AdminMenu:Revive")
AddEventHandler("AdminMenu:Revive", function(player)
    local xPlayer = ESX.GetPlayerFromId(player)
    ExecuteCommand("revive "..xPlayer.idunique)
    ESX.ShowNotification(ESX.Config("serverColor").."Vous avez revive :~g~"..player)
end)




function DrawTextOnScreen(text)
   SetTextProportional(0) -- Might not be needed. Play around with it I guess
   SetTextFont(4) -- Font for the text we are drawing
   SetTextOutline()
   SetTextScale(0.4,0.4)
   SetTextColour(255,255,255, 255)
   SetTextEntry("STRING") -- Initiates a new string for our text
   AddTextComponentString(text) -- Sets the text
   DrawText(0.8, 0.85) -- Draws the text (x, y on your screen)
end 

function sendStaffInfo()
    pcall(function()
        ShowInfo("Informations staff", {
            {left = "Joueurs en ligne", leftIcon = "fas fa-users", right = PlayerCount.."/"..null.data.server.maxplayers, color = "rgb("..ESX.Config("r")..","..ESX.Config("g")..","..ESX.Config("b")..")"},
            {left = "Reports ouverts / pris", leftIcon = "fas fa-flag", right = ESX.Table.SizeOf(nTable.reportList).." ∕ "..nTable.takenReporttt, color = "rgb("..ESX.Config("r")..","..ESX.Config("g")..","..ESX.Config("b")..")"},
            {left = "Admins en service", leftIcon = "fas fa-shield-alt", right = StaffCount, color = "rgb("..ESX.Config("r")..","..ESX.Config("g")..","..ESX.Config("b")..")"},
        }, "info_dialog_staff")
    end)
end 

function toggleShowReport()
    nTable.adminHud = not nTable.adminHud
    Citizen.CreateThread(function()
        while nTable.adminHud do
            sendStaffInfo()
            Wait(1000)
        end 
        pcall(function()
            HideInfo()
        end)
    end)
end


--[[Citizen.CreateThread(function()
    null.fct.waitPlayerLoaded()

    while true do
        loopFrames = 2500

        if ESX.GetPlayerData()['group'] ~= 'user' and nTable.Service then
            for k,v in pairs(PlayersShow) do 
                local playerPos = v.coords
    
                local distance = #(GetEntityCoords(PlayerPedId())-v.coords)
    
                if distance < 20 then
                    if distance < 10 then
                        loopFrames = 0
                        local text = ('Joueur Tué : %s\nDétail du tueur %s\nRaison : %s\nArme : %s'):format(v.killedPlayer, v.playerName, v.reason, v.loadout)
                        ESX.Game.Utils.DrawText3D(v.coords, text, 0.75, 4)
                    end
                end
            end
        end

        Wait(loopFrames)
    end
end)]]

local BlipsJoueursLoin = {}
local CreatedBlipsJoueursLoin = {}
local ActivePlayers = {}

RegisterNetEvent("null:staff:recevieBlips")
AddEventHandler("null:staff:recevieBlips", function(result)
    for k,v in pairs(ActivePlayers) do
        if result[GetPlayerServerId(v)] ~= nil then
            result[GetPlayerServerId(v)] = nil
        end
    end
    BlipsJoueursLoin = result
    for k,v in pairs(CreatedBlipsJoueursLoin) do
        RemoveBlip(v)
    end
    Wait(500)
    CreatedBlipsJoueursLoin = {}
    for k,v in pairs(BlipsJoueursLoin) do
        CreatedBlipsJoueursLoin[k] = AddBlipForCoord(vector3(v.x, v.y,0))
        SetBlipSprite(CreatedBlipsJoueursLoin[k], 1)
        SetBlipScale(CreatedBlipsJoueursLoin[k], 0.85)
        SetBlipColour(CreatedBlipsJoueursLoin[k], 3)
        SetBlipCategory(CreatedBlipsJoueursLoin[k], 7)
        SetBlipRotation(CreatedBlipsJoueursLoin[k], 0)

        BeginTextCommandSetBlipName('STRING')
        AddTextComponentString("Joueurs (Loins)")
        EndTextCommandSetBlipName(CreatedBlipsJoueursLoin[k])
    end
end)

CreateThread(function()
    while true do
        if isadmin == true then
            if nTable.blipActive then
                ActivePlayers = GetActivePlayers()
                for _, player in pairs(ActivePlayers) do
                    local ped = GetPlayerPed(player)
                    local blip = GetBlipFromEntity( ped )
                    if not DoesBlipExist( blip ) then
                        blip = AddBlipForEntity(ped)
                        SetBlipCategory(blip, 7)
                        SetBlipScale( blip,  0.85 )
                        ShowHeadingIndicatorOnBlip(blip, true)
                        SetBlipSprite(blip, 1)
                        SetBlipColour(blip, 0)
                    end
                    SetBlipNameToPlayerName(blip, player)
                    local veh = GetVehiclePedIsIn(ped, false)
                    local blipSprite = GetBlipSprite(blip)
                    if IsEntityDead(ped) or GetEntityHealth(ped) == 104 then
                        if blipSprite ~= 303 then
                            SetBlipSprite( blip, 303 )
                            SetBlipColour(blip, 1)
                            ShowHeadingIndicatorOnBlip( blip, false )
                        end
                    elseif veh ~= nil then
                        if IsPedInAnyBoat( ped ) then
                            if blipSprite ~= 427 then
                                SetBlipSprite( blip, 427 )
                                SetBlipColour(blip, 0)
                                ShowHeadingIndicatorOnBlip( blip, false )
                            end
                        elseif IsPedInAnyHeli( ped ) then
                            if blipSprite ~= 43 then
                                SetBlipSprite( blip, 43 )
                                SetBlipColour(blip, 0)
                                ShowHeadingIndicatorOnBlip( blip, false )
                            end
                        elseif IsPedInAnyPlane( ped ) then
                            if blipSprite ~= 423 then
                                SetBlipSprite( blip, 423 )
                                SetBlipColour(blip, 0)
                                ShowHeadingIndicatorOnBlip( blip, false )
                            end
                        elseif IsPedInAnyPoliceVehicle( ped ) then
                            if blipSprite ~= 137 then
                                SetBlipSprite( blip, 137 )
                                SetBlipColour(blip, 0)
                                ShowHeadingIndicatorOnBlip( blip, false )
                            end
                        elseif IsPedInAnySub( ped ) then
                            if blipSprite ~= 308 then
                                SetBlipSprite( blip, 308 )
                                SetBlipColour(blip, 0)
                                ShowHeadingIndicatorOnBlip( blip, false )
                            end
                        elseif IsPedInAnyVehicle( ped ) then
                            if blipSprite ~= 225 then
                                SetBlipSprite( blip, 225 )
                                SetBlipColour(blip, 0)
                                ShowHeadingIndicatorOnBlip( blip, false )
                            end
                        else
                            SetBlipSprite( blip, 1 )
                            SetBlipColour(blip, 0)
                            ShowHeadingIndicatorOnBlip( blip, true )
                        end
                    else
                        if blipSprite ~= 1 then
                            SetBlipSprite( blip, 1 )
                            SetBlipColour(blip, 0)
                            ShowHeadingIndicatorOnBlip( blip, true )
                        end
                    end
                    if veh then
                        SetBlipRotation( blip, math.ceil( GetEntityHeading( veh ) ) )
                    else
                        SetBlipRotation( blip, math.ceil( GetEntityHeading( ped ) ) )
                    end
                end
                Wait(1)
            else
                for k,v in pairs(CreatedBlipsJoueursLoin) do
                    RemoveBlip(v)
                    CreatedBlipsJoueursLoin[k] = nil
                end
                for _, player in pairs(GetActivePlayers()) do
                    local blip = GetBlipFromEntity( GetPlayerPed(player) )
                    if blip ~= nil then
                        RemoveBlip(blip)
                    end
                end
                Wait(3000)
            end
        else
            Wait(5000)
        end
    end
end)

local CreatedBlips = {}

function ActiveTirAppel()
    for k,v in pairs(CreatedBlips) do
        Citizen.CreateThread(function()
            local blipId = AddBlipForCoord(v.data.x, v.data.y, v.data.z)
            SetBlipSprite(blipId, 161)
            SetBlipScale(blipId, 0.4)
            SetBlipColour(blipId, 3)
            
            BeginTextCommandSetBlipName("STRING")
            AddTextComponentString('Staff: Coup de feu')
            EndTextCommandSetBlipName(blipId)
    
            table.insert(CreatedBlips, {id = blipId, data = data})
            Wait(60 * 1000)
            if DoesBlipExist(blipId) then
                RemoveBlip(blipId)
            end
            for _,x in pairs(CreatedBlips) do if x.id == blipId then table.remove(CreatedBlips, k) end end
        end)
    end
end

function DesactiveTirAppel()
    for k,v in pairs(CreatedBlips) do
        RemoveBlip(v.id)
    end
end

RegisterNetEvent("null:staff:recevieAppelTir", function(data)
    if not nTable.tirAppels then return end
    Citizen.CreateThread(function()
        local blipId = AddBlipForCoord(data.x, data.y, data.z)
        SetBlipSprite(blipId, 161)
        SetBlipScale(blipId, 0.4)
        SetBlipColour(blipId, 3)
        
        BeginTextCommandSetBlipName("STRING")
        AddTextComponentString('Staff: Coup de feu')
        EndTextCommandSetBlipName(blipId)

        table.insert(CreatedBlips, {id = blipId, data = data})
        Wait(60 * 1000)
        if DoesBlipExist(blipId) then
            RemoveBlip(blipId)
        end
        for _,x in pairs(CreatedBlips) do if x.id == blipId then table.remove(CreatedBlips, k) end end
    end)
end)

RegisterNetEvent("MP:freeze")
AddEventHandler("MP:freeze", function(bool)
    FreezeEntityPosition(PlayerPedId(), bool)
end)

local OldCoords = nil

function SpectatePlayer(targetPed)
    local playerPed = PlayerPedId()

    if targetPed == playerPed then nTable.in_spectate = false return end
        
    if nTable.in_spectate then
        OldCoords = GetEntityCoords(playerPed)
        SetEntityCoords(targetPed, GetEntityCoords(targetPed, false).x, GetEntityCoords(targetPed, false).z , GetEntityCoords(targetPed, false).y)
        SetEntityInvincible(playerPed, true)
        local targetx,targety,targetz = table.unpack(GetEntityCoords(targetPed, false))
        RequestCollisionAtCoord(targetx, targety, targetz)
        NetworkSetInSpectatorMode(true, targetPed)
    else
        SetEntityCoords(targetPed, OldCoords.x, OldCoords.z , OldCoords.y)
        SetEntityInvincible(playerPed, false)
        local targetx,targety,targetz = table.unpack(GetEntityCoords(targetPed, false))
        RequestCollisionAtCoord(targetx, targety, targetz)
        NetworkSetInSpectatorMode(false, targetPed)
    end
end

function godMod(bool)
    CreateThread(function()
        if bool then
            while nTable.invincible do
                SetEntityInvincible(PlayerPedId(), true)
                SetEntityHealth(PlayerPedId(), 200)
                SetEntityMaxHealth(PlayerPedId(), 200)
                Wait(1)
            end
        else
            SetEntityInvincible(PlayerPedId(), false)
        end
    end)
end


function godmodvehicle(bool)
    CreateThread(function()
        if bool then
            if IsPedSittingInAnyVehicle(PlayerPedId()) then
                while nTable.godmodvehicle do
                    local veh = ESX.Game.GetClosestVehicle(PlayerCoords)
                    SetVehicleFixed(veh)
                    SetVehicleDeformationFixed(veh)
                    SetVehicleDirtLevel(veh, 0.0)
                    SetVehicleEngineHealth(veh, 1000.0)
                    Wait(1000)
                end
            else
                ESX.ShowNotification('Vous n\'êtes pas dans un véhicule</C>')
            end
        end
    end)
end


function SpawnCar(bool)
    CreateThread(function()
        if bool then
            while nTable.spawncarr do
                if IsPedShooting(GetPlayerPed(-1)) then
                    local entity = GetPlayerPed(-1)
                    local heading = GetEntityHeading(entity)
                    local coords = GetEntityCoords(entity)
                    local vehiclemodel = "0x1B38E955"
                    local vel = GetEntityVelocity(PlayerPedId())
                    local velmax = vel*100
                    SetPedCanRagdoll(entity, false)
                    ESX.Game.SpawnVehicle("policet", coords, heading, function(vehicle)
                        ClearPedTasksImmediately(PlayerPedId())
                        SetPedCanRagdoll(entity, false)
                        SetVehicleNumberPlateText(vehicle, 'Null') 
                        SetVehicleEngineOn(vehicle, true, true, false)
                        SetVehicleForwardSpeed(vehicle, 100)
                        SetEntityVelocity(vehicle, velmax)
                    end)
                end
                Wait(1)
            end
        end
    end)
end

function getEntity(player) -- function To Get Entity Player Is Aiming At
    local _, entity = GetEntityPlayerIsFreeAimingAt(player)
    return entity
end

function aimCheck(player)
    return IsPedShooting(player)
end


function setCoords(bool)
    CreateThread(function()
        if bool then
            while nTable.setCoord do
                local pedPos = GetEntityCoords(PlayerPedId())
                local h = GetEntityHeading(PlayerPedId())
                Visual.Subtitle("~r~X: ~s~"..pedPos.x.."~o~ Y: ~s~"..pedPos.y..ESX.Config("serverColor").." Z: "..pedPos.z.."\n~b~H: "..h)
                Wait(1)
            end
        end
    end)
end
