                end
            })
            RageUI.Button('Label du véhicule unique', nil, {RightLabel = uniqueVehData.label and "Défini" or "Pas défini"}, true, {
                onSelected = function()
                    uniqueVehData.label = null.fct.input("Label du véhicule Unique ?")
                end
