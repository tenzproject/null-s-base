                    if Index == 1 then
                        PositionRecolte = GetEntityCoords(PlayerPedId(), true)
                    elseif Index == 2 then
                        PositionBoss = GetEntityCoords(PlayerPedId(), true)
                    elseif Index == 3 then
                        PosVestiaire = GetEntityCoords(PlayerPedId(), true)
                    elseif Index == 4 then
                        PosTraitement = GetEntityCoords(PlayerPedId(), true)
                    end
                end
            })
            RageUI.Button(('Ajouter une borne de commande (%d)'):format(#nTable.CreateRestaurantOrderPoints), 'Les clients pourront commander à cette position', {}, true, {
                onSelected = function()
                    table.insert(nTable.CreateRestaurantOrderPoints, GetEntityCoords(PlayerPedId(), true))
                end
            })
            if #nTable.CreateRestaurantOrderPoints > 0 then
                RageUI.Button('Retirer la dernière borne', nil, { Color = { BackgroundColor = { 180, 80, 80, 120 } } }, true, {
                    onSelected = function()
                        table.remove(nTable.CreateRestaurantOrderPoints)
                    end
                })
            end
            RageUI.Button('Confirmer', nil, { Color = { BackgroundColor = { 0, 255, 0, 120 } } }, true, {
                onSelected = function() 
                    if namejob == nil or 
                    labeljob == nil or 
                    PositionRecolte == nil or 
                    PosTraitement == nil or 
                    PosVestiaire == nil or 
                    blipsprite == nil or 
                    blipcolor == nil or 
                    PositionBoss == nil then
                        return
                    end
                    TriggerServerEvent('null:createrestaurant', namejob, labeljob, PositionRecolte, PositionBoss, PosVestiaire, blipsprite, blipcolor, nTable.CreateRestaurantCrafts, PosTraitement, {
                        brandColor = nTable.CreateRestaurantBrandColor or "#e74c3c",
                        logo = nTable.CreateRestaurantBrandLogo or "",
                        description = nTable.CreateRestaurantBrandDescription or "",
                        orderPoints = nTable.CreateRestaurantOrderPoints or {},
                    })
                    nTable.CreateRestaurantBrandColor = "#e74c3c"
                    nTable.CreateRestaurantBrandLogo = ""
                    nTable.CreateRestaurantBrandDescription = ""
                    nTable.CreateRestaurantOrderPoints = {}
                    RageUI.GoBack()
                    Citizen.SetTimeout(2000, function()
                        ESX.TriggerServerCallback("AdminMenu:getEntreprise", function(data, data2)
                            nTable.Entreprises = data
                            nTable.Entreprises2 = data2
                        end)
                    end)
                end
            })
        end)
        RageUI.IsVisible(sub_Server_Companies_Create_Restaurant_Crafts, function()
            if labeljob ~= nil then
                RageUI.Separator("Création des crafts du restaurant "..labeljob or "")
            else
                RageUI.Separator("Création des crafts du restaurant ")
            end
            RageUI.Line()
            RageUI.Button('Rechercher un craft', nil, {}, true, {
                onSelected = function() 
                   local input = null.fct.input("Que voulez faire rechercher ?")
                   if not input then return end
                   RechercheCraftResto = string.lower(input)
                end
            })
            RageUI.Button('Arreter la recherche', nil, {}, true, {
                onSelected = function() 
                    RechercheCraftResto = nil
                end
            })
            RageUI.Button('Ajouter un craft', nil, {}, true, {
                onSelected = function() 
                    nTable.CreateRestaurantCraftsItemlabel = ""
                    nTable.CreateRestaurantCraftsItemname = ""
                    nTable.CreateRestaurantCraftsItemTime = 2
                    nTable.CreateRestaurantCraftsItemCategory = "Menu"
                    nTable.CreateRestaurantCraftsItemSellPrice = 20
                    nTable.CreateRestaurantCraftsItemOrderable = true
                    ResetCraftMetabolism()
                end
            }, sub_Server_Companies_Create_Restaurant_Crafts_Create)
            RageUI.Line()
            for k,v in pairs(nTable.CreateRestaurantCrafts) do
                if RechercheCraftResto ~= nil then
                    if string.find(string.lower(v.Item), RechercheCraftResto) or string.find(string.lower(v.Label), RechercheCraftResto) then
                        RageUI.Button(v.Item.." - "..v.Label.." ("..v.Time..")", "Temps: "..v.Time.."\nCategory: "..v.Category.."\nIcon: "..v.Icon, {}, true, {
                            onSelected = function() 
                                local result = null.fct.confirm("Voulez-vous vraiment surpprimer ce craft ?")
                                if result == true then
                                    nTable.CreateRestaurantCrafts[k] = nil
                                end
                            end
                        }) 
                    end
                else
                    RageUI.Button(v.Item.." - "..v.Label.." ("..v.Time..")", "Temps: "..v.Time.."\nCategory: "..v.Category.."\nIcon: "..v.Icon, {}, true, {
                        onSelected = function() 
                            local result = null.fct.confirm("Voulez-vous vraiment surpprimer ce craft ?")
                            if result == true then
                                nTable.CreateRestaurantCrafts[k] = nil
                            end
                        end
                    }) 
                end
            end
        end)
        RageUI.IsVisible(sub_Server_Companies_Create_Restaurant_Crafts_Create, function()
            RageUI.Button('Nom de l\'item', nil, {RightLabel = nTable.CreateRestaurantCraftsItemname}, true, {
                onSelected = function() 
                    nTable.CreateRestaurantCraftsItemname = null.fct.input("Nom de l'item")
                end
            })
            RageUI.Button('Label de l\'item', nil, {RightLabel = nTable.CreateRestaurantCraftsItemlabel}, true, {
                onSelected = function() 
                    nTable.CreateRestaurantCraftsItemlabel = null.fct.input("Label de l'item")
                end
            })
            RageUI.Button('Temps de craft', nil, {RightLabel = nTable.CreateRestaurantCraftsItemTime}, true, {
                onSelected = function() 
                    nTable.CreateRestaurantCraftsItemTime = tonumber(null.fct.input("Temps de craft en seconde"))
                end
            })
            RageUI.Button('Catégorie (borne)', "Groupe d'affichage dans la borne de commande (ex: Burgers, Boissons, Desserts...)",
                { RightLabel = nTable.CreateRestaurantCraftsItemCategory or "Menu" }, true, {
                onSelected = function()
                    local input = null.fct.input("Catégorie de l'item")
                    if input and input ~= "" then
                        nTable.CreateRestaurantCraftsItemCategory = input
                    end
                end
            })
            RageUI.Button('Prix de vente', "Prix facturé au client à la borne.",
                { RightLabel = "$"..tostring(nTable.CreateRestaurantCraftsItemSellPrice or 20) }, true, {
                onSelected = function()
                    local n = tonumber(null.fct.input("Prix de vente en $"))
                    if n and n >= 0 then
                        nTable.CreateRestaurantCraftsItemSellPrice = n
                    end
                end
            })
            RageUI.Checkbox('Commandable à la borne', "Décoche pour un craft interne uniquement (non visible par les clients).",
                nTable.CreateRestaurantCraftsItemOrderable == true, {}, {
                onChecked = function() nTable.CreateRestaurantCraftsItemOrderable = true end,
                onUnChecked = function() nTable.CreateRestaurantCraftsItemOrderable = false end,
            })
            RageUI.Button('Items require', nil, {}, true, {
                onSelected = function() 
                    local optionlist = {}
                    for k,v in pairs(nTable.RestaurantItemCanAdd) do
                        table.insert(optionlist, {value=v.name,label=v.name.." - "..v.label, label2 = v.label})
                    end
                    nTable.CreateRestaurantCraftsRequirmements = {}
                    local result2 = null.fct.input("Votre choix", true, {
                        {type = 'multi-select', label = 'Qu\'elles items sont require pour votre craft',options=optionlist, searchable = true},})
                    if result2 == nil then return end
                    for k,v in pairs(result2) do
                        local Label = v
                        for x,y in pairs(optionlist) do
                            if y.value == v then
                                Label = y.label2
                                break
                            end
                        end
                        table.insert(nTable.CreateRestaurantCraftsRequirmements, {
                            Label = Label,
                            ItemName = v,
                            Icon = "../../assets/img/foodjobs/"..v..".webp",
                            Amount = tonumber(null.fct.input("Nombre de "..Label.." require")),
                        })
                    end
                end
            })

            RenderRestaurantCraftMetabolism()

            RageUI.Button('Confirmer l\'ajout', nil, {}, true, {
                onSelected = function() 
                    EnsureCraftMetabolism()
                    nTable.CreateRestaurantCrafts[nTable.CreateRestaurantCraftsItemname] = {
                        Item = nTable.CreateRestaurantCraftsItemname,
                        Label = nTable.CreateRestaurantCraftsItemlabel,
                        Description = nTable.CreateRestaurantCraftsItemlabel,
                        Category = nTable.CreateRestaurantCraftsItemCategory or "Menu",
                        Icon = "../../assets/img/foodjobs/"..nTable.CreateRestaurantCraftsItemname..".webp",
                        Time = nTable.CreateRestaurantCraftsItemTime,
                        SellPrice = nTable.CreateRestaurantCraftsItemSellPrice or 20,
                        Orderable = nTable.CreateRestaurantCraftsItemOrderable ~= false,
                        Requirements = nTable.CreateRestaurantCraftsRequirmements,
                        Metabolism = nTable.CreateRestaurantCraftsMetabolism,
                    }
                    table.insert(nTable.RestaurantItemCanAdd, {name = nTable.CreateRestaurantCraftsItemname,label = nTable.CreateRestaurantCraftsItemlabel})
                    RageUI.GoBack()
                end
            })
        end)
