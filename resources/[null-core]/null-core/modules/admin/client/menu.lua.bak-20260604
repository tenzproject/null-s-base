function RetrievePlayersDataByID(source)
    local player = {};
    for i, v in pairs(nPlayer) do
        if (v.source == source) then
            player = v;
        end
    end
    return player;
end

function RetrievePlayersOnline(idunique)
    local joueuronline = false
    for i, v in pairs(nPlayer) do
        if v.idunique == idunique then
            joueuronline = true
        end
    end
    return joueuronline
end


local loopFrames = 2500
local PlayersShow = {}
local DeathLogTTL = 8 * 60 -- secondes avant disparition d'un marqueur

RegisterNetEvent("null:playerDied", function(payload)
    if not payload then return end
    payload._receivedAt = GetGameTimer()
    PlayersShow[payload.playerId] = payload
end)

-- Conservé pour compat éventuelle, non utilisé pour l'overlay screen-space ci-dessous.
local function StaffDrawDeathLine(coords, text, scaleFactor, r, g, b)
    local camCoords = GetGameplayCamCoords()
    local distance = #(coords - camCoords)
    if distance > 25.0 then return end
    local scale = (1.0 / distance) * 2.0
    local fov = (1.0 / GetGameplayCamFov()) * 100
    scale = scale * fov * (scaleFactor or 1.0)

    SetTextScale(0.0 * scale, 0.40 * scale)
    SetTextFont(4)
    SetTextProportional(1)
    SetTextColour(r or 255, g or 255, b or 255, 235)
    SetTextDropshadow(0, 0, 0, 0, 255)
    SetTextDropShadow()
    SetTextOutline()
    SetTextEntry("STRING")
    SetTextCentre(true)
    AddTextComponentString(text)
    SetDrawOrigin(coords.x, coords.y, coords.z, 0)
    DrawText(0.0, 0.0)
    ClearDrawOrigin()
end

local function FormatElapsed(secondsAgo)
    if secondsAgo < 60 then return ("il y a %ds"):format(secondsAgo) end
    local m = math.floor(secondsAgo / 60)
    local s = secondsAgo % 60
    return ("il y a %dm%02ds"):format(m, s)
end

Citizen.CreateThread(function()
    null.fct.waitPlayerLoaded()

    -- Palette locale au death log (taille fixe via screen-space, identique au gamertag)
    local mainScale  = 0.32  -- header
    local subScale   = 0.26  -- lignes principales
    local smallScale = 0.23  -- détails
    local lh         = 0.018 -- hauteur d'une ligne
    local blockGap   = 0.008 -- espace entre blocs

    while true do
        loopFrames = 2500
        if ESX.PlayerData.group ~= 'user' and nTable.staffMode then
            local now = GetGameTimer()
            local myCoords = PlayerState.coords or GetEntityCoords(PlayerPedId(), false)

            for k, v in pairs(PlayersShow) do
                if v._receivedAt and (now - v._receivedAt) > (DeathLogTTL * 1000) then
                    PlayersShow[k] = nil
                else
                    local distance = #(myCoords - v.coords)
                    if distance < 30.0 then
                        loopFrames = 0
                        -- Anchor: au-dessus du corps
                        local anchorZ = v.coords.z + 1.0
                        local onScreen, sx, sy = World3dToScreen2d(v.coords.x, v.coords.y, anchorZ)
                        if onScreen then
                            local lines = {}
                            local function pushLine(text, scale, r, g, b)
                                lines[#lines+1] = {text = text, scale = scale, r = r, g = g, b = b}
                            end
                            local function pushGap()
                                lines[#lines+1] = {gap = true}
                            end

                            -- BLOC 1: Header
                            pushLine("MORT D'UN JOUEUR", mainScale, 240, 90, 90)
                            pushGap()

                            -- BLOC 2: Victime
                            local victim = v.victim or {}
                            do
                                local idu = victim.idu or "?"
                                local src = victim.source or "?"
                                local name = victim.name or v.killedPlayer or "?"
                                pushLine(("Victime: U%s | T%s | %s"):format(idu, src, name), subScale, 235, 235, 235)
                                if victim.firstname or victim.lastname then
                                    pushLine(("(%s %s)"):format(victim.firstname or "", victim.lastname or ""), smallScale, 200, 200, 200)
                                end
                                local vIllegal = victim.job2
                                if vIllegal and vIllegal ~= "" then
                                    pushLine(("Illegal victime: %s"):format(vIllegal), smallScale, C.illegal[1], C.illegal[2], C.illegal[3])
                                end
                            end
                            pushGap()

                            -- BLOC 3: Tueur
                            local killer = v.killer or {}
                            if killer.idu then
                                pushLine(("Tueur: U%s | T%s | %s"):format(killer.idu, killer.source or "?", killer.name or "?"), subScale, 245, 170, 70)
                                if killer.firstname or killer.lastname then
                                    pushLine(("(%s %s)"):format(killer.firstname or "", killer.lastname or ""), smallScale, 220, 200, 170)
                                end
                                local kIllegal = killer.job2
                                if kIllegal and kIllegal ~= "" then
                                    pushLine(("Illegal tueur: %s"):format(kIllegal), smallScale, C.illegal[1], C.illegal[2], C.illegal[3])
                                end
                                if killer.distance then
                                    pushLine(("Distance: %sm"):format(killer.distance), smallScale, 180, 180, 200)
                                end
                            else
                                pushLine("Tueur: Inconnu (PNJ / Suicide / Accident)", subScale, 160, 160, 160)
                            end
                            pushGap()

                            -- BLOC 4: Cause / Arme
                            local hasCause = v.reason and v.reason ~= "" and v.reason ~= "Inconnu~s~"
                            local hasArme  = v.weapon and v.weapon ~= "" and v.weapon ~= "Aucune~s~"
                            if hasCause then
                                pushLine(("Cause: %s"):format(tostring(v.reason)), smallScale, 200, 200, 200)
                            end
                            if hasArme then
                                pushLine(("Arme: %s"):format(tostring(v.weapon)), smallScale, 200, 200, 200)
                            end
                            if hasCause or hasArme then
                                pushGap()
                            end

                            -- BLOC 5: Temps écoulé
                            if v._receivedAt then
                                local secondsAgo = math.floor((now - v._receivedAt) / 1000)
                                pushLine(FormatElapsed(secondsAgo), smallScale, 130, 200, 255)
                            end

                            -- Calcul taille panneau
                            local totalH = 0
                            for i = 1, #lines do
                                if lines[i].gap then totalH = totalH + blockGap
                                else totalH = totalH + lh end
                            end
                            local startY = sy - totalH
                            if startY < 0.02 then startY = 0.02 end

                            -- Rendu lignes
                            local cy = startY
                            for i = 1, #lines do
                                local L = lines[i]
                                if L.gap then
                                    cy = cy + blockGap
                                else
                                    StaffDrawScreenLine(sx, cy, L.text, L.scale, L.r, L.g, L.b, 235)
                                    cy = cy + lh
                                end
                            end
                        end
                    end
                end
            end
        end

        Wait(loopFrames)
    end
end)

RegisterNetEvent("null:staff:openreportnote", function(Informations)
    openReport(Informations)
end)

function openReport(Informations)
    RageUI.CloseAll()
    local menu = RageUI.CreateMenu("", "")
    RageUI.Visible(menu, true)
    menu.Closable = false
    Citizen.CreateThread(function()
        local ListIndex = 1
        while menu do
            RageUI.IsVisible(menu, function()
                RageUI.Separator("Noter la qualiter du staff "..Informations.name.." ("..Informations.idu..")")
                RageUI.Separator("Description : "..Informations.description)

                RageUI.List("Notez la qualité du traitement de votre report", {"⭐", "⭐⭐", "⭐⭐⭐", "⭐⭐⭐⭐", "⭐⭐⭐⭐⭐"}, ListIndex, nil, {}, true, {
                    onListChange = function(Index)
                        ListIndex = Index;
                    end
                })
                RageUI.Button("Envoyer votre note", nil, {}, true, {
                    onSelected = function()
                        RageUI.CloseAll()
                        Informations.Note = ListIndex
                        TriggerServerEvent("null:staff:newnotestaff", Informations)
                    end
                })
            end)

            if not RageUI.Visible(menu) then
                menu = RMenu:DeleteType("menu", true)
            end

            Citizen.Wait(0)
        end
    end)
end

RegisterNetEvent("AdminMenu:sendAdminMessage", function(id, name, message, idtemp)
    if ESX.PlayerData.group ~= "user" then
        TriggerEvent("chatMessage", "", {tonumber(ESX.Config("r")), tonumber(ESX.Config("g")), tonumber(ESX.Config("b"))}, "STAFF : "..name.." ["..id.."] ^0| "..message)
    end
end)