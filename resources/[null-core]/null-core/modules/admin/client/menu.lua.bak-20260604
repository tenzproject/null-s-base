        RageUI.IsVisible(sub_DevTools_Props_Spawn, function()
            RageUI.Button("Model du props", false , {RightLabel = model}, true , {
                onSelected = function()
                    local string1 = null.fct.input('Model du props', false, 200., "text") 
                    model = string1
                end
            })
            RageUI.Checkbox("Freeze", nil, freeze, {}, {
                onChecked = function()
                    freeze = true
                end,
                onUnChecked = function()
                    freeze = false
                end
            })
            RageUI.Button("Spawn le props", false , {RightLabel = ">"}, true , {
                onSelected = function()
                    if IsModelValid(model) then    
                        local devant = -0.75
                        local coords = GetEntityCoords(GetPlayerPed(-1)) + GetEntityForwardVector(GetPlayerPed(-1)) * - devant
                        local headingJoueur = GetEntityHeading(GetPlayerPed(-1))
                        local prop = CreateObject(GetHashKey(model), coords, true)  
                        local closeprop = GetClosestObjectOfType(GetEntityCoords(GetPlayerPed(-1)), 1.5, GetHashKey(model), 70)
                        SetEntityHeading(closeprop, headingJoueur)
                        PlaceObjectOnGroundProperly(closeprop)
                        if freeze == "1" then
                            FreezeEntityPosition(closeprop, true)
                        end
                    else 
                        ESX.ShowNotification("SYSTEME : Modèle renseigné invalide")
                        return
                    end
                end
            })
        end)
        RageUI.IsVisible(sub_DevTools_Props_List, function()
            if IsControlJustReleased(0,  96) then
                if CamFov > 0 then
                    CamFov = CamFov - 5.0
                    SetCamFov(camera, CamFov)
                end
            elseif IsControlJustReleased(0,  97) then
                if CamFov < 130.0 then
                    CamFov = CamFov + 5.0
                    SetCamFov(camera, CamFov)
                end
            end
            Visual.Subtitle("Appuyez sur [~b~+~s~] / [~b~-~s~] pour Zoom / Dézoom", 1000)
            if ListOfProps and type(ListOfProps) == "table" then
                for k,v in pairs(ListOfProps) do
                    if v and v.name then
                        RageUI.Button(v.name, nil, {}, true, {
                            onSelected = function()
                                SendNUIMessage({
                                    tool = tostring(v.name)
                                })
                            end
                        })
                    end
                end
                sub_DevTools_Props_List.onIndexChange = function(Index)
                    if ListOfProps[Index] and ListOfProps[Index].name then
                        RequestModel(ListOfProps[Index].name)
                        while not HasModelLoaded(ListOfProps[Index].name) do
                            Wait(500)               
                        end
                        Wait(150)
                        DeleteEntity(SpawnProps)
                        SpawnProps = CreateObjectNoOffset(ListOfProps[Index].name, -1266.972, -3013.221, -48.49021, 1, 0, 1)
                        PlaceObjectOnGroundProperly(SpawnProps)
                        FreezeEntityPosition(SpawnProps, true)
                        SetModelAsNoLongerNeeded(SpawnProps)
                    end
                end
            else
                RageUI.Separator("~r~ListOfProps n'est pas défini")
            end
        end)
