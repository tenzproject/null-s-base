        RageUI.IsVisible(sub_Settings_Other_AdvancedWipe, function()
            RageUI.Info("Information Wipe Avancé", {"Compétences require :", "Dangerosité :", "Comment ça fonctionne ?","", "Le script effectuera un wipe de toutes les données", "correspondant aux critères que vous avez définis.", "Cela signifie que les informations saisies (noms, id, ...)", "seront comparées à chaque profil utilisateur.", "Si elles correspondent, les données associées", "seront supprimées."}, {"Formation wipe~s~", "~r~7~s~/10", "","", "", "", "", "", "", ""})
            RageUI.Button("Appliquer", nil, {Color = {BackgroundColor = {0, 200, 0, 100}}}, true, {
                onSelected = function()
                    TriggerServerEvent("null:staff:wipetableUsers", ChangedValueUsersTable, nTable.onlyALLWeapon)
                end
            })
            RageUI.Button("Réinitialiser", nil, {Color = {BackgroundColor = {255, 0, 0, 50}}}, true, {
                onSelected = function()
                    ChangedValueUsersTable = {}
                end
            })
            for k,v in pairs(nTable.tableUsers) do
                if nTable.blTableUsers[v.Field] == true then
                    goto continue
                end
                if string.find(v.Type, "int") then
                    local number = string.match(v.Type, "%d+")
                    nTable.tableUsers[k].maxValue = tonumber(string.rep('9', number))
                    v.maxValue = tonumber(string.rep('9', number))
                    v.type = "int"
                elseif string.find(v.Type, "varchar") then
                    local number = string.match(v.Type, "%d+")
                    nTable.tableUsers[k].maxValue = number
                    v.maxValue = number
                    v.type = "varchar"
                else
                    nTable.tableUsers[k].maxValue = 0
                    v.maxValue = 9999999999999
                    v.type = v.Type
                end

                local valeurActuelle = ChangedValueUsersTable[k] or "Vide"
                if type(valeurActuelle) == "table" then valeurActuelle = json.encode(valeurActuelle) end
                local DescriptionActuelle = ""
                if ChangedValueUsersTable[k] == nil then
                    DescriptionActuelle = "\n\n[Entré] Modifier et Activer"
                else
                    DescriptionActuelle = "\n\n[Entré] Désactiver"
                end
                RageUI.Button(v.Field.." ("..v.Type..")", "Valeur Actuelle: ".. valeurActuelle .. DescriptionActuelle, {RightLabel = ChangedValueUsersTable[k] == nil and "❌" or "✅"}, true, {
                    onSelected = function()
                        if v.Field == "loadout" then
                            if ChangedValueUsersTable[k] == nil then
                                ChangedValueUsersTable[k] = {}
                                SelectedK = k
                                RageUI.Visible(sub_Settings_Other_AdvancedWipe, false)
                                RageUI.Visible(sub_Settings_Other_AdvancedWipe_sub_1, true)
                            else
                                ChangedValueUsersTable[k] = nil
                            end
                        elseif v.Field == "inventory" then
                            if ChangedValueUsersTable[k] == nil then
                                ChangedValueUsersTable[k] = {}
                                SelectedK = k
                                RageUI.Visible(sub_Settings_Other_AdvancedWipe, false)
                                RageUI.Visible(sub_Settings_Other_AdvancedWipe_sub_2, true)
                            else
                                ChangedValueUsersTable[k] = nil
                            end
                        else
                            if ChangedValueUsersTable[k] == nil then
                                local newValue = null.fct.input("Veuillez definir la nouvelle valeur")
                                if v.type == "int" then
                                    newValue = tonumber(newValue)
                                    if newValue > v.maxValue then return ESX.ShowNotification("❌ Veuillez noter un nombre correct (Max: "..v.maxValue..")") end
                                elseif v.type == "varchar" then
                                    if #newValue > tonumber(v.maxValue) then 
                                        ESX.ShowNotification("❌ Veuillez noter une valeur correct (Max: "..v.maxValue..")") 
                                        return 
                                    end
                                else
                                    
                                end 
                                ChangedValueUsersTable[k] = newValue
                            else
                                ChangedValueUsersTable[k] = nil
                            end
                        end
                    end,
                    onActive = function()
                        if IsControlJustPressed(0, 54) then
                            
                        end
                    end
                })
                ::continue::
            end
        end)

