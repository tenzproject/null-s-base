        RageUI.IsVisible(sub_Player_ByIdUnique_inventory_weapons, function()
            if nTable.playerByIdU.loadout[1] ~= nil then
                for _, v in ipairs(nTable.playerByIdU.loadout) do
                    local label = ""
                    if v.label ~= nil then
                        label = v.label
                    else
                        label = v.name
                    end
                    local metadata = ""
                    if v.metadata ~= nil then
                        metadata = json.encode(v.metadata)
                    end
                    RageUI.Button(v.name, "label : "..label.."\ncomponents : "..json.encode(v.components).."\nmetadata : "..metadata, {}, true, {
                        onSelected = function()
                            nTable.WeaponLabel = label
                            nTable.WeaponName = v.name
                            nTable.WeaponComponents = v.components
                            nTable.AllWeaponComponents = v.allcomponents
                        end,
                        onActive = function()
                            RageUI.Info(label.."~s~", {'~s~Nom de l\'arme : ', '~s~Hash de l\'arme : '}, {ESX.Config("serverColor")..label,ESX.Config("serverColor")..v.name})
                        end
                    }, sub_Player_ByIdUnique_inventory_weapons_select) 
                end
            else
                RageUI.Separator("~r~Cette personne n'a aucune arme")
            end
        end)
        RageUI.IsVisible(sub_Player_ByIdUnique_inventory_weapons_select, function()
            RageUI.Button("Supprimer l\'arme", nil, {}, true, {
                onSelected = function()
                    for _, v in ipairs(nPlayer) do -- vérifier si la personne est en ligne
                        if nTable.selectIdUnique == v.idunique then
                            nTable.WeaponIsOnline = true
                            TriggerServerEvent("null:staff:removeplayerweapon", v.source, nTable.WeaponName, nTable.WeaponLabel)
                            TriggerServerEvent("Null:staff2:getiduinfo", nTable.selectIdUnique)
                            RageUI.Visible(sub_Player_ByIdUnique_inventory_weapons_select, false)
                            RageUI.Visible(sub_Player_ByIdUnique_inventory_weapons, true)
                        end
                    end
                    if not nTable.WeaponIsOnline then
                        TriggerServerEvent("null:staff:removeplayerweaponOffline", nTable.selectIdUnique, nTable.WeaponName, nTable.WeaponLabel)
                        TriggerServerEvent("Null:staff2:getiduinfo", nTable.selectIdUnique)
                        RageUI.Visible(sub_Player_ByIdUnique_inventory_weapons_select, false)
                        RageUI.Visible(sub_Player_ByIdUnique_inventory_weapons, true)
                    end
                end
            })
            RageUI.Line()
            if nTable.WeaponComponents ~= nil and nTable.AllWeaponComponents ~= nil and #nTable.AllWeaponComponents > 0 then
                for k,v in pairs(nTable.AllWeaponComponents) do
                    hasAccessories = false
                    for x, i in pairs(nTable.WeaponComponents) do
                        if i == v.name then
                            hasAccessories = true
                        end
                    end
                    RageUI.Checkbox(("%s (%s)"):format(v.label, v.name), nil, hasAccessories, {}, {
                        onChecked = function()
                            ESX.TriggerServerCallback("null:admin:changeweaponacc", function(result)
                                if result then
                                    TriggerServerEvent("Null:staff2:getiduinfo", nTable.selectIdUnique)
                                    table.insert(nTable.WeaponComponents, v.name)
                                    hasAccessories = true
                                end
                            end, nTable.selectIdUnique, nTable.WeaponName, v.name, "add")
                        end,
                        onUnChecked = function()
                            ESX.TriggerServerCallback("null:admin:changeweaponacc", function(result)
                                if result then
                                    TriggerServerEvent("Null:staff2:getiduinfo", nTable.selectIdUnique)
                                    for y,n in pairs(nTable.WeaponComponents) do
                                        if n == v.name then
                                            table.remove(nTable.WeaponComponents, y)
                                            hasAccessories = false
                                        end
                                    end
                                end
                            end, nTable.selectIdUnique, nTable.WeaponName, v.name, "remove")
                        end
                    })
                end
            else
                if nTable.WeaponComponents ~= nil then
                    for k,v in pairs(nTable.WeaponComponents) do
                        RageUI.Checkbox(("%s"):format(v), nil, true, {}, {
                            onChecked = function()
                                
                            end,
                            onUnChecked = function()
                                
                            end
                        })
                    end
                end
            end
        end)
        RageUI.IsVisible(sub_Player_ByIdUnique_jailinfo, function()
            if nTable.playerByIdU.injail then
                RageUI.Separator("Status : ~r~En Jail~s~.")
                RageUI.Separator("Temps restant : "..nTable.playerByIdU.injailtime.." seconde(s)")
                RageUI.Separator("Raison : "..nTable.playerByIdU.injailraison.."")
            else
                RageUI.Separator("Status : ~b~Libre~s~.")
            end
            if (StaffHasPerm("JAIL")) then
                RageUI.Button("Jail", "Jail le joueur", {}, true, {
                    onSelected = function()
                        local jailTime = null.fct.input("Temps de jail (secondes)")
                        if not jailTime then return end
                        Wait(200)
                        local jailReason = null.fct.input("Raison du jail")
                        if not jailReason then return end
                        if jailReason ~= nil and jailTime ~= nil then
                            ExecuteCommand(("jail %s %s %s"):format(nTable.playerByIdU.idunique, tonumber(jailTime), tostring(jailReason)))
                        end
                    end
                })
                RageUI.Button("Unjail", "unjail le joueur", {}, true, {
                    onSelected = function()
                        ESX.ShowNotification("~g~Joueur Unjail avec succès")
                        ExecuteCommand("unjailoffline "..nTable.playerAsBeenSearchIdUnique)
                    end
                })
            end
        end)
