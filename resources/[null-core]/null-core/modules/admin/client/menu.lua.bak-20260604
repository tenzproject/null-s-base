        RageUI.IsVisible(sub_Player_Instance, function()
            while nTable.SelectedPlayers.instance == nil do 
                return RageUI.Separator("Chargement du joueur") 
            end
            local instanceLabel = "Inconnu"
            local instanceNumber = 0

            if nTable.SelectedPlayers.instance and type(nTable.SelectedPlayers.instance) ~= "number" then
                instanceLabel = nTable.SelectedPlayers.instance.label
                instanceNumber = nTable.SelectedPlayers.instance.number or 0
            else
                instanceNumber =  nTable.SelectedPlayers.instance or 0
            end

            if instanceLabel ~= nil then
                RageUI.Separator("Instance du joueur : "..instanceLabel.." ("..instanceNumber..")")
            else
                local name = Config.Instance.GetName(instanceNumber)
                if name then
                    RageUI.Separator("Instance du joueur : "..name.." ("..instanceNumber.." - Custom) ")
                else
                    RageUI.Separator("Instance du joueur : "..instanceNumber.." (Custom) ")
                end
            end
            for k,v in pairs(Config.Instance.list) do
                RageUI.Button(k.." - "..v, "", {RightLabel = instanceNumber == k and "Oui" or "Non"}, true, {
                    onSelected = function()
                        TriggerServerEvent("null:staff:setInstance", nTable.source, k)
                        instanceNumber = k
                        nTable.SelectedPlayers.instance.number = k
                    end
                })
            end
            RageUI.Button("Instance custom", nil, {}, true, {
                onSelected = function()
                    local result = null.fct.input("Veuillez entrer le numero de l'instance")
                    if result == nil then return end
                    TriggerServerEvent("null:staff:setInstance", nTable.source, result)
                    instanceNumber = result
                    nTable.SelectedPlayers.instance.number = k
                end
            })
        end)

        RageUI.IsVisible(sub_Player_Inventory, function()
            if nTable.source ~= nil then
                RageUI.Button("Argent liquide "..ESX.Config("serverColor")..nPlayer[nTable.selectIdUnique].cash.."$~s~", nil, {RightLabel = ESX.Config("serverColor").."Retirer"}, (StaffHasPerm("DELETE_MONEY") and nPlayer[nTable.selectIdUnique].cash > 0), {
                    onSelected = function()
                        local amount = null.fct.input("Combien d'argent liquide voulez-vous retirer ?")
                        if amount and tonumber(amount) then
                            TriggerServerEvent("null:staff:player:removemoney", nTable.source, "cash", tonumber(amount))
                        else
                            ESX.ShowNotification("Veuillez sélectionner un montant valide")
                        end
                    end
                })
                RageUI.Button("Argent en banque "..ESX.Config("serverColor")..nPlayer[nTable.selectIdUnique].bank.."$~s~", nil, {RightLabel = ESX.Config("serverColor").."Retirer"}, (StaffHasPerm("DELETE_MONEY") and nPlayer[nTable.selectIdUnique].bank > 0), {
                    onSelected = function()
                        local amount = null.fct.input("Combien d'argent en banque voulez-vous retirer ?")
                        if amount and tonumber(amount) then
                            TriggerServerEvent("null:staff:player:removemoney", nTable.source, "bank", tonumber(amount))
                        else
                            ESX.ShowNotification("Veuillez sélectionner un montant valide")
                        end
                    end
                })
                RageUI.Button("Argent sale "..ESX.Config("serverColor")..nPlayer[nTable.selectIdUnique].black.."$~s~", nil, {RightLabel = ESX.Config("serverColor").."Retirer"}, (StaffHasPerm("DELETE_MONEY") and nPlayer[nTable.selectIdUnique].black > 0), {
                    onSelected = function()
                        local amount = null.fct.input("Combien d'argent sale voulez-vous retirer ?")
                        if amount and tonumber(amount) then
                            TriggerServerEvent("null:staff:player:removemoney", nTable.source, "dirtycash", tonumber(amount))
                        else
                            ESX.ShowNotification("Veuillez sélectionner un montant valide")
                        end
                    end
                })                
                RageUI.Line()
                local invCache = cachedInvData[nTable.selectIdUnique]
                if invCache and invCache.inventory then
                    for k,v in pairs(invCache.inventory) do
                        if v.count > 0 then
                            if ESX.GetItemLabel(v.name) == nil then
                                v.label = v.name
                            else
                                v.label = ESX.GetItemLabel(v.name)
                            end
                            local metadata = ""
                            if v.metadata ~= nil then
                                metadata = json.encode(v.metadata)
                            end
                            RageUI.Button(v.count.."X"..v.label.." ("..v.name..")", "Metadata : "..metadata, {RightLabel = ESX.Config("serverColor").."Retirer"}, (StaffHasPerm("DELETE_ITEM")), {
                                onSelected = function()
                                    null.fct.inputCb("Combien voulez vous retirer de "..v.label.."",function(amount) 
                                        if amount ~= nil then
                                            
                                            TriggerServerEvent("null:staff:removeplayeritem", nTable.source, amount, v.name, v.label)
                                            
                                        else
                                            ESX.ShowNotification("Veuiller décrire un montant valide")
                                        end
                                    end);
                                end
                            })
                        end
                    end
                else
                    RageUI.Separator("Chargement...")
                end
                RageUI.Line()
                if invCache and invCache.loadout then
                    for i = 1, #invCache.loadout do
                        if not invCache.loadout[i].label ~= nil then
                            invCache.loadout[i].label = invCache.loadout[i].name
                        end
                        local metadata = ""
                        if invCache.loadout[i].metadata ~= nil then
                            metadata = json.encode(invCache.loadout[i].metadata)
                        end
                        local weaponLabel = ESX.GetWeaponLabel(invCache.loadout[i].name) or ""
                        RageUI.Button("1X"..weaponLabel, "Metadata : "..metadata, {RightLabel = ESX.Config("serverColor").."Retirer"}, (StaffHasPerm("DELETE_WEAPON")), {
                            onSelected = function()
                                local Options = null.fct.input2("Que voulez-vous faire ?", true, {
                                    {
                                        type = 'select', label = 'Que voulez-vous faire ?', default = 1, description="", options = {
                                            {value = 1, label = "Retirer l'arme"},
                                            {value = 2, label = "Réparer l'arme"}
                                        }
                                    }
                                })
                                if Options == nil or Options[1] == nil then return end
                                if Options[1] == "1" then
                                    local result = null.fct.confirm("Voulez-vous vraiment surpprimer retirer cette arme ?")
                                    if result ~= true then return end
                                    TriggerServerEvent("null:staff:removeplayerweapon", nTable.source, invCache.loadout[i].name, weaponLabel)
                                elseif Options[1] == "2" then
                                    TriggerServerEvent("null:staff:repairweapon", nTable.source, invCache.loadout[i].name, weaponLabel)
                                else
                                    local result = null.fct.confirm("Voulez-vous vraiment surpprimer retirer cette arme ?")
                                    if result ~= true then return end
                                    TriggerServerEvent("null:staff:removeplayerweapon", nTable.source, invCache.loadout[i].name, weaponLabel)
                                end
                            end
                        })
                    end
                end
            else
                RageUI.Separator(ESX.Config("serverColor").."Le joueur n'est plus connecter")
                RageUI.Button("Revinir en arrière", nil, {}, true, {}, sub_Players)
            end
        end)

