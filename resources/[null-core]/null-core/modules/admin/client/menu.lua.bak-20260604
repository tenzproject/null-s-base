RegisterNetEvent('null:admin:refreshOnePlayer')
AddEventHandler('null:admin:refreshOnePlayer', function(idunique, data, staff)
    if data ~= nil then
        nPlayer[idunique] = data
        PlayerCount = 0
        for k,v in pairs(nPlayer) do
            PlayerCount = PlayerCount + 1
        end
        
        if nTable.SelectedPlayers and nTable.SelectedPlayers.idunique == idunique then
            nTable.SelectedPlayers = data
        end
    end
    if staff ~= nil then
        nTable.staffList[idunique] = staff
        StaffCount = 0
        for k,v in pairs(nTable.staffList) do
            StaffCount = StaffCount + 1
        end
        null.DebugPrint("Update Staff Count:",StaffCount)
    end
end)

