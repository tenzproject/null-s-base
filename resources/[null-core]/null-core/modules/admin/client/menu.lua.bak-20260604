        RageUI.IsVisible(sub_Player, function()
            if nTable.source ~= nil and nTable.SelectedPlayers.source then

                RageUI.InfoPanel({
                    title = "Info. Joueur",
                    items = {
                        { label = "Identité", value = nTable.SelectedPlayers.name },
                        { label = "ID / Unique", value = tostring(nTable.SelectedPlayers.source) .. " ∕ " .. tostring(nTable.SelectedPlayers.idunique) },
                        { label = "Métier", value = (nTable.SelectedPlayers.jobs and nTable.SelectedPlayers.jobs.label or (type(nTable.SelectedPlayers.job) == "table" and nTable.SelectedPlayers.job.label or nTable.SelectedPlayers.job) or "N/A") .. " - " .. (nTable.SelectedPlayers.jobs and nTable.SelectedPlayers.jobs.grade_label or (type(nTable.SelectedPlayers.job) == "table" and nTable.SelectedPlayers.job.grade_label or "")) },
                        { label = "Gang/Orga", value = (nTable.SelectedPlayers.jobs2 and nTable.SelectedPlayers.jobs2.label or (type(nTable.SelectedPlayers.job2) == "table" and nTable.SelectedPlayers.job2.label or nTable.SelectedPlayers.job2) or "N/A") .. " - " .. (nTable.SelectedPlayers.jobs2 and nTable.SelectedPlayers.jobs2.grade_label or (type(nTable.SelectedPlayers.job2) == "table" and nTable.SelectedPlayers.job2.grade_label or "")) },
                        { label = "Liquide", value = "~g~" .. nTable.SelectedPlayers.cash .. "$" },
                        { label = "Banque", value = "~b~" .. nTable.SelectedPlayers.bank .. "$" },
                        { label = "Sale", value = "~r~" .. nTable.SelectedPlayers.black .. "$" }
                    }
                })

                RageUI.Button("Voir détails RP complets", nil, {RightLabel = ""}, true, {}, sub_Player_InfoRP)
                RageUI.Button("Voir détails HRP complets", nil, {RightLabel = ""}, true, {}, sub_Player_InfoHRP)

                RageUI.Collapsible("Actions Rapides", nil, true, function()
                    
                    RageUI.Checkbox("Mode Spectateur", "Surveiller le joueur en invisible", nTable.in_spectate, {}, {
                        onChecked = function()
                            nTable.in_spectate = true
                            local PlayerId = GetPlayerFromServerId(nTable.source)
                            SpectatePlayer(GetPlayerPed(PlayerId))
                        end,
                        onUnChecked = function()
                            nTable.in_spectate = false
                            local PlayerId = GetPlayerFromServerId(nTable.source)
                            SpectatePlayer(GetPlayerPed(PlayerId))
                        end
                    })

                    RageUI.Button('Se téléporter sur lui (Goto)', nil, {}, true, {
                        onSelected = function() ExecuteCommand('tpa ' .. nTable.idunique) end
                    })
                    RageUI.Button('Le téléporter sur moi (Bring)', nil, {}, true, {
                        onSelected = function() ExecuteCommand('bring ' .. nTable.idunique) end
                    })
                    RageUI.Button('Le retourner (Back)', "Le renvoyer à sa dernière position", {}, true, {
                        onSelected = function() ExecuteCommand('back ' .. nTable.idunique) end
                    })

                    RageUI.Button("Revive (Réanimer)", nil, {RightBadge = RageUI.BadgeStyle.Heart}, (StaffHasPerm("REVIVE")), {
                        onSelected = function() ExecuteCommand("revive "..nTable.idunique) end
                    })
                end)

                RageUI.Collapsible("Discipline & Contact", nil, true, function()
                    RageUI.Button("Envoyer un message (DM)", nil, {}, true, {
                        onSelected = function()
                            local reason = null.fct.input("Votre Message")
                            if reason ~= nil and reason ~= "" then
                                ExecuteCommand(("msgstaff %s %s"):format(nTable.idunique, reason))
                            end
                        end
                    })
                    if (StaffHasPerm("SCREEN")) then
                        RageUI.Button("Prendre un Screenshot", "Le screen sera envoyé sur Discord", {}, true, {
                            onSelected = function() TriggerServerEvent("null:staff:screenshotplayer", nTable.source) end
                        })
                    end
                    RageUI.Button("Avertissement (Warn)", nil, {}, (StaffHasPerm("WARN")), {
                        onSelected = function()
                            local warn = null.fct.input("Raison du warn")
                            if warn and warn ~= "" then
                                TriggerServerEvent("AdminMenu:warn", nTable.source, warn)
                                nTable.sanctionOk = true
                            else
                                ESX.ShowNotification("Veuillez entrer une raison valide")
                            end
                        end
                    })
                    if (StaffHasPerm("JAIL")) then
                        RageUI.Button("Mettre en Jail", nil, {}, true, {
                            onSelected = function()
                                local warn = null.fct.input("Raison du jail")
                                if warn ~= nil then
                                    local time = null.fct.input("Temps du jail")
                                    ExecuteCommand("jail "..nTable.idunique.." "..time.." "..warn.."")
                                end
                            end
                        })
                        
                        RageUI.Button("Sortir de Jail", nil, {}, true, {
                            onSelected = function() ExecuteCommand("unjail "..nTable.idunique) end
                        })

                        RageUI.Button("Bannir le joueur", nil, {RightBadge = RageUI.BadgeStyle.Alert}, true, {
                            onSelected = function()
                                local reason = null.fct.input("Raison du ban")
                                if reason ~= nil and reason ~= "" then
                                    local time = null.fct.input("Temps du ban (en minutes)")
                                    if time ~= nil and tonumber(time) then
                                        ExecuteCommand("ban "..nTable.idunique.." "..time.." "..reason)
                                    else
                                        ESX.ShowNotification("Temps invalide !")
                                    end
                                else
                                    ESX.ShowNotification("Raison invalide !")
                                end
                            end
                        })
                    end
                    RageUI.Button("Historique des Sanctions", "Voir Warns, Jails et Bans", {RightLabel = ""}, true, {
                        onSelected = function()
                            ESX.TriggerServerCallback("AdminMenu:getPlayerSanction", function(result)
                                nTable.sanction = result
                            end, nTable.source)
                        end
                    }, sub_Player_History_Sanctions)
                end)

                RageUI.Collapsible("Gestion Personnage", nil, true, function()
                    RageUI.Button("Heal (Soigner)", nil, {RightBadge = RageUI.BadgeStyle.Heart}, (StaffHasPerm("HEAL")), {
                        onSelected = function() ExecuteCommand(("%s %s"):format(Config.Admin.Commands.heal, nTable.source)) end
                    })
                    RageUI.Checkbox(AdminMenu:freezeByState(nTable.playerFreeze), nil, nTable.playerFreeze, {}, {
                        onChecked = function()
                            if not nTable.fonda then
                                nTable.playerFreeze = true
                                ExecuteCommand("freeze "..nTable.source)
                            end
                        end,
                        onUnChecked = function()
                            if not nTable.fonda then
                                nTable.playerFreeze = false
                                ExecuteCommand("unfreeze "..nTable.source)
                            end
                        end
                    })
                    if nTable.Ata ~= false then
                        RageUI.Button("Retirer la Limite Physique (ATA)", nil, {}, (StaffHasPerm("ATA")), {
                            onSelected = function()
                                TriggerServerEvent("ata:server:staff:updateNoCane", nTable.source, 0)
                                nTable.Ata = false
                            end,
                            onActive = function()
                                if nTable.Ata then
                                    RageUI.Info("Info ATA", {"Temps restant"}, {tostring(nTable.Ata) .." Minutes"})
                                end
                            end
                        })
                    else
                        RageUI.Button("Mettre une Limite Physique (ATA)", nil, {}, (StaffHasPerm("ATA")), {
                            onSelected = function()
                                local time = tonumber(null.fct.input("Temps (1-30 min)"))
                                if time and time >= 1 and time <= 30 then
                                    TriggerServerEvent("ata:server:staff:updateNoCane", nTable.source, time)
                                    nTable.Ata = time
                                else
                                    ESX.ShowNotification("Temps invalide (1-30)")
                                end
                            end
                        })
                    end
                    if (StaffHasPerm("INSTANCE")) then
                        RageUI.Button("Gérer l'instance", "Voir/Modifier le bucket du joueur", {}, (not nTable.fonda), {
                            onSelected = function()
                                ESX.TriggerServerCallback("null:staff:getPlayerInstance", function(result) 
                                    nTable.SelectedPlayers.instance = result
                                end, nTable.source)
                            end
                        }, sub_Player_Instance)
                    end
                    if nTable.inProperty then
                        RageUI.Button("Sortir de la propriété", "Force le joueur à sortir", {}, (not nTable.fonda), {
                            onSelected = function() TriggerServerEvent("null:properties:forceExitProperty", nTable.source) end
                        })
                    end                    
                    if nTable.SelectedPlayers.havegfpack then
                        RageUI.Button("⚠️ Vérifier Pack Graphique", "~r~Pack détecté comme non-RP", {RightBadge = RageUI.BadgeStyle.Alert}, true, {
                            onSelected = function() TriggerServerEvent("null:staff:verifpackrp", nTable.source) end
                        })
                    else
                        RageUI.Button("Vérifier Pack Graphique", nil, {}, true, {
                            onSelected = function() TriggerServerEvent("null:staff:verifpackrp", nTable.source) end
                        })
                    end
                end)

                RageUI.Collapsible("Inventaire & Économie", nil, true, function()
                    if (StaffHasPerm("OPEN_INV")) then
                        RageUI.Button("Ouvrir l'inventaire", nil, {}, (not nTable.fonda), {
                            onSelected = function()
                                ESX.TriggerServerCallback('null:admin:getPlayerInventory', function(inv, loadout)
                                    cachedInvData[nTable.selectIdUnique] = { inventory = inv or {}, loadout = loadout or {} }
                                end, nTable.selectIdUnique)
                            end
                        }, sub_Player_Inventory)
                        
                        RageUI.Button("Modifier le poids max", nil, {}, (not nTable.fonda), {
                            onSelected = function()
                                local newWeight = null.fct.input("Nouveau poids :")
                                if newWeight then TriggerServerEvent("null:staff:updateplayerWeight", nTable.source, newWeight) end
                            end
                        })
                    end
                    RageUI.List("Donner (Give)", {"Argent Liquide", "Argent Banque", "Argent Sale", "Permis Arme", "Permis Conduire"}, nTable.List, nil, {}, true, {
                        onListChange = function(Index) nTable.List = Index end,
                        onSelected = function(Index)
                            if Index == 1 and StaffHasPerm("GIVE_MONEY") then -- Liquide
                                local amount = tonumber(null.fct.input("Montant ?"))
                                if amount then TriggerServerEvent("AdminMenu:giveMoneyCash", nTable.source, amount) end

                            elseif Index == 2 and StaffHasPerm("GIVE_MONEY") then -- Banque
                                local amount = tonumber(null.fct.input("Montant ?"))
                                if amount then TriggerServerEvent("AdminMenu:giveMoneyBank", nTable.source, amount) end

                            elseif Index == 3 and StaffHasPerm("GIVE_MONEY") then -- Sale
                                local amount = tonumber(null.fct.input("Montant ?"))
                                if amount then TriggerServerEvent("AdminMenu:giveMoneyBlack", nTable.source, amount) end

                            elseif Index == 4 and StaffHasPerm("GIVE_WEAPON_LICENSE") then -- PPA
                                TriggerServerEvent("AdminMenu:giveLicence", nTable.source, "weapon")

                            elseif Index == 5 and StaffHasPerm("GIVE_DRIVE_LICENSE") then -- Permis
                                TriggerServerEvent("AdminMenu:giveLicence", nTable.source, "drive")
                            end
                        end
                    })
                    if (StaffHasPerm("GIVE_ITEM")) then
                        RageUI.Button("Donner un Item", nil, {RightLabel = ESX.Config("serverColor")..""}, true, {
                            onSelected = function()
                                ESX.TriggerServerCallback("AdminMenu:getItemOnDtb", function(items)
                                    RageUI.OpenItemGrid({
                                        items = items,
                                        title = "Donner un Item",
                                        mode = "item",
                                        callback = function(data)
                                            null.fct.inputCb("Nombre d'items à give", function(amount)
                                                if amount ~= nil and tonumber(amount) then
                                                    TriggerServerEvent("AdminMenu:giveItem", nTable.source, data.name, data.label, tonumber(amount))
                                                else
                                                    ESX.ShowNotification("Montant Invalide")
                                                end
                                            end)
                                        end
                                    })
                                end, false)
                            end
                        })
                    end
                    if (StaffHasPerm("GIVE_WEAPON")) then
                        RageUI.Button("Donner une Arme", nil, {RightLabel = ESX.Config("serverColor")..""}, true, {
                            onSelected = function()
                                ESX.TriggerServerCallback("AdminMenu:getWeapon", function(weapons)
                                    RageUI.OpenItemGrid({
                                        items = weapons,
                                        title = "Donner une Arme",
                                        mode = "weapon",
                                        callback = function(data)
                                            local Description = ""
                                            if ESX.ContribWeapon(data.name) then
                                                Description = "Ceci est une arme permanante"
                                            end
                                            local Options = {}
                                            if (StaffHasPerm("GIVE_WEAPON_BOUTIQUE")) then
                                                Options = null.fct.input2("Configuration de l'arme", true, {
                                                    {type = 'input', label = 'Nom de l\'arme', description = 'Le nom afficher de l\'arme', required = true, min = 1, max = 20, default=data.label},
                                                    {type = 'input', label = 'Description de l\'arme', description = 'La description de l\'arme', required = false, min = 1, max = 100, default=Description},
                                                    {type = 'checkbox', label = 'Numero de serie', default = true},
                                                    {type = 'checkbox', label = 'Arme Permanente'},
                                                }, false)
                                            else
                                                Options = null.fct.input2("Configuration de l'arme", true, {
                                                    {type = 'input', label = 'Nom de l\'arme', description = 'Le nom afficher de l\'arme', required = true, min = 1, max = 20, default=data.label},
                                                    {type = 'input', label = 'Description de l\'arme', description = 'La description de l\'arme', required = false, min = 1, max = 100, default=Description},
                                                    {type = 'checkbox', label = 'Numero de serie', default = true},
                                                }, false)
                                            end
                                            if Options == nil or Options[1] == nil then return end
                                            TriggerServerEvent("AdminMenu:giveWeapon", nTable.source, data.name, 250, Options)
                                        end
                                    })
                                end, false)
                            end
                        })
                    end
                    if (StaffHasPerm("WIPE")) then
                        RageUI.List("Wipe (Réinitialiser)", nTable.wipeList, nTable.List2, "~r~Action irréversible", {}, not nTable.fonda, {
                            onListChange = function(Index) nTable.List2 = Index end,
                            onSelected = function(Index)
                                if Index == 1 then -- Inv
                                    if null.fct.confirm("Wipe inventaire ?") then TriggerServerEvent("AdminMenu:clearPlayerInv", nTable.source) end
                                elseif Index == 2 then -- Armes
                                    if null.fct.confirm("Wipe armes ?") then TriggerServerEvent("AdminMenu:clearPlayerWeapon", nTable.source) end
                                elseif Index == 3 then -- Vehicules
                                    if null.fct.confirm("Wipe véhicules ?") then TriggerServerEvent("AdminMenu:clearPlayerVeh", nTable.source) end
                                elseif Index == 4 then -- Total
                                    if null.fct.confirm("WIPE TOTAL ?") then TriggerServerEvent("AdminMenu:wipe", nTable.source) end
                                end
                            end
                        })
                    end
                end)
                RageUI.Collapsible("Carrière & Véhicules", nil, true, function()
                    if (StaffHasPerm("SETJOB")) then
                        RageUI.Button("Définir le Métier (Setjob)", nil, {RightLabel = ""}, true, {
                            onSelected = function()
                                ESX.TriggerServerCallback('AdminMenu:getAllJobs', function(allJobs) nTable.allJobs = allJobs end)
                            end
                        }, sub_Player_SetJob)
                    end
                    if (StaffHasPerm("OPEN_GARAGE")) then
                        RageUI.Button("Voir le Garage", nil, {RightLabel = ""}, (not nTable.fonda), {
                            onSelected = function()
                                ESX.TriggerServerCallback("null:staff:getplayerVeh", function(result1, result2, result3)
                                    nTable.SelectedPlayers.Garage = {result1, result2, result3}
                                end, nTable.source)
                            end
                        }, sub_Player_Garage)
                    end
                    if (StaffHasPerm("GIVE_GARAGE_VEH")) then
                        RageUI.Button("Donner un Véhicule (Garage)", "Ajoute directement au garage", {RightLabel = ESX.Config("serverColor")..""}, true, {
                            onSelected = function()
                                if not nTable._vehicleList then
                                    nTable._vehicleList = {}
                                    local models = GetAllVehicleModels()
                                    for _, model in ipairs(models) do
                                        local displayName = GetDisplayNameFromVehicleModel(model)
                                        local label = GetLabelText(displayName)
                                        if label == "NULL" or label == "" then label = model end
                                        table.insert(nTable._vehicleList, { name = model, label = label })
                                    end
                                    table.sort(nTable._vehicleList, function(a, b) return a.label < b.label end)
                                end
                                RageUI.OpenItemGrid({
                                    items = nTable._vehicleList,
                                    title = "Donner un Véhicule",
                                    mode = "vehicle",
                                    callback = function(data)
                                        local vehModel = data.name
                                        local targetPos = GetEntityCoords(PlayerPedId(nTable.source))
                                        local hash = GetHashKey(vehModel)
                                        if IsModelValid(hash) then
                                            ESX.Game.SpawnVehicle(vehModel, targetPos, 90.0, function(vehicle)
                                                table.insert(nTable.vehicleSell, vehicle)
                                                TaskWarpPedIntoVehicle(PlayerPedId(nTable.source), vehicle, -1)
                                                SetModelAsNoLongerNeeded(vehModel)
                                                local plaque = AdminMenu:CreatePlate()
                                                local vehicleProps = ESX.Game.GetVehicleProperties(vehicle)
                                                vehicleProps.plate = plaque
                                                SetVehicleNumberPlateText(vehicle, plaque)
                                                TriggerServerEvent("AdminMenu:giveGarageVeh", vehicleProps, nTable.source, GetDisplayNameFromVehicleModel(vehModel))
                                            end)
                                        else
                                            ESX.ShowNotification("Modèle invalide !")
                                        end
                                    end
                                })
                            end
                        })
                    end
                end)
            end
        end)

