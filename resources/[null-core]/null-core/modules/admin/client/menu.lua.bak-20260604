                                safezone_create_zone:destroy()
                                safezone_create_zone = nil
                            end
                        end
                    end
                })

                RageUI.Button("Retirer tous les points de SafeZone", nil, {}, true, {
                    onSelected = function()
                        if safezone_create_zone ~= nil then
                            safezone_create_zone:destroy()
                            safezone_create_zone = nil
                        end

                        nTable.CreateZoneSafe.points = {}
                    end
                })
            end

            RageUI.Button("~g~Créer la SafeZone", nil, {}, isSafeZoneValid(nTable.CreateZoneSafe), {
                onSelected = function()
                    if safezone_create_zone ~= nil then
                        safezone_create_zone:destroy()
                        safezone_create_zone = nil
                    end

                    TriggerServerEvent("null:safezone:create", nTable.CreateZoneSafe)
                    createTerritoryData = {}
                    RageUI.CloseAll()
                end
            })
        end)
        RageUI.IsVisible(sub_Server_Boutique, function()
